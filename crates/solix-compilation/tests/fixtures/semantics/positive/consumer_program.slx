package solix.tests.consumer;

import solix.tests.library.User;
import solix.tests.library.Status;
import solix.tests.library.Repository;
import solix.tests.library.*;

public class ConsumerService {
    public Repository<User> user_repo;
    public User current_user;

    public ConsumerService(int64 user_id, string user_name) {
        this.current_user = new User(user_id, user_name);
        this.user_repo = new Repository<User>();
    }

    public int32 execute() {
        int32 counter = 0;
        int32[] list = new int32[5];

        while (counter < 5) {
            list[counter] = counter * 10;
            counter = counter + 1;
        }

        bool active = this.current_user.is_active();
        if (active) {
            return this.user_repo.get_count();
        }

        return 0;
    }
}
