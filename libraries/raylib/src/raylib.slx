    public static native void attach_audio_mixed_processor(uint64 processor);
    /// Detach audio stream processor from the entire audio pipeline
    public static native void DetachAudioMixedProcessor(uint64 processor);
    public static native void detach_audio_mixed_processor(uint64 processor);
}

