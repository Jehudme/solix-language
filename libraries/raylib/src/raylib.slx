    public static native void unload_random_sequence(int32[] sequence);
    /// Takes a screenshot of current screen (filename extension defines format)
    public static native void TakeScreenshot(string fileName);
    public static native void take_screenshot(string fileName);
    /// Set init configuration flags (view FLAGS)
    public static native void SetConfigFlags(uint32 flags);
    public static native void set_config_flags(uint32 flags);
    /// Open URL with default system browser (if available)
    public static native void OpenURL(string url);
    public static native void open_url(string url);
    /// Set the current threshold (minimum) log level
    public static native void SetTraceLogLevel(int32 logLevel);
    public static native void set_trace_log_level(int32 logLevel);
    /// Show trace log messages (LOG_DEBUG, LOG_INFO, LOG_WARNING, LOG_ERROR...)
    public static native void TraceLog(int32 logLevel, string text);
    public static native void trace_log(int32 logLevel, string text);
    /// Set custom trace log
    public static native void SetTraceLogCallback(uint64 callback);
    public static native void set_trace_log_callback(uint64 callback);
    /// Internal memory allocator
    public static native uint64 MemAlloc(uint32 size);
    public static native uint64 mem_alloc(uint32 size);
    /// Internal memory reallocator
    public static native uint64 MemRealloc(uint64 ptr, uint32 size);
    public static native uint64 mem_realloc(uint64 ptr, uint32 size);
    /// Internal memory free
    public static native void MemFree(uint64 ptr);
    public static native void mem_free(uint64 ptr);
    /// Load file data as byte array (read)
    public static native uint8[] LoadFileData(string fileName, int32[] dataSize);
    public static native uint8[] load_file_data(string fileName, int32[] dataSize);
    /// Unload file data allocated by LoadFileData()
    public static native void UnloadFileData(uint8[] data);
    public static native void unload_file_data(uint8[] data);
    /// Save data to file from byte array (write), returns true on success
    public static native bool SaveFileData(string fileName, uint64 data, int32 dataSize);
    public static native bool save_file_data(string fileName, uint64 data, int32 dataSize);
    /// Export data to code (.h), returns true on success
    public static native bool ExportDataAsCode(uint8[] data, int32 dataSize, string fileName);
    public static native bool export_data_as_code(uint8[] data, int32 dataSize, string fileName);
    /// Load text data from file (read), returns a '\0' terminated string
    public static native string LoadFileText(string fileName);
    public static native string load_file_text(string fileName);
    /// Unload file text data allocated by LoadFileText()
    public static native void UnloadFileText(string text);
    public static native void unload_file_text(string text);
    /// Save text data to file (write), string must be '\0' terminated, returns true on success
    public static native bool SaveFileText(string fileName, string text);
    public static native bool save_file_text(string fileName, string text);
    /// Set custom file binary data loader
    public static native void SetLoadFileDataCallback(uint64 callback);
    public static native void set_load_file_data_callback(uint64 callback);
    /// Set custom file binary data saver
    public static native void SetSaveFileDataCallback(uint64 callback);
    public static native void set_save_file_data_callback(uint64 callback);
    /// Set custom file text data loader
    public static native void SetLoadFileTextCallback(uint64 callback);
    public static native void set_load_file_text_callback(uint64 callback);
    /// Set custom file text data saver
    public static native void SetSaveFileTextCallback(uint64 callback);
    public static native void set_save_file_text_callback(uint64 callback);
    /// Rename file (if exists), returns 0 on success
    public static native int32 FileRename(string fileName, string fileRename);
    public static native int32 file_rename(string fileName, string fileRename);
    /// Remove file (if exists), returns 0 on success
    public static native int32 FileRemove(string fileName);
    public static native int32 file_remove(string fileName);
    /// Copy file from one path to another, dstPath created if it doesn't exist, returns 0 on success
    public static native int32 FileCopy(string srcPath, string dstPath);
    public static native int32 file_copy(string srcPath, string dstPath);
    /// Move file from one directory to another, dstPath created if it doesn't exist, returns 0 on success
