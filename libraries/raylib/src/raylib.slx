// ===========================================================================
// Internal Vector Math Helpers
// ===========================================================================
float32 _raylib_sqrt_f32(float32 value) {
    if (value <= (float32)0.0) {
        return (float32)0.0;
    }
    float64 scaled_val = (float64)value;
    float64 scale_factor = 1.0;
    while (scaled_val >= 4.0) {
        scaled_val = scaled_val * 0.25;
        scale_factor = scale_factor * 2.0;
    }
    while (scaled_val < 0.25) {
        scaled_val = scaled_val * 4.0;
        scale_factor = scale_factor * 0.5;
    }
    float64 approx = scaled_val > 1.0 ? scaled_val * 0.5 : 1.0;
    for (int32 step_index = 0; step_index < 8; step_index = step_index + 1) {
        approx = 0.5 * (approx + (scaled_val / approx));
    }
    return (float32)(approx * scale_factor);
}

// ===========================================================================
// Managed RAII GPU / Audio Resource Wrappers
// ===========================================================================
public class ManagedTexture {
    public Texture2D resource;
    private bool owns_resource;

    public ManagedTexture(Texture2D handle) {
        this.resource = handle;
        this.owns_resource = handle != null;
    }

    public static ManagedTexture load(string file_name) {
        return new ManagedTexture(LoadTexture(file_name));
    }

    public bool is_valid() {
        return this.resource != null && (this.resource.id != (uint32)0);
    }

    public Texture2D get() {
        return this.resource;
    }

    public Texture2D release() {
        this.owns_resource = false;
        return this.resource;
    }

    public void dispose() {
        if (this.owns_resource && this.resource != null && (this.resource.id != (uint32)0)) {
            UnloadTexture(this.resource);
        }
        this.owns_resource = false;
    }

    ~ManagedTexture() {
        this.dispose();
    }
}

public class ManagedRenderTexture {
    public RenderTexture2D resource;
    private bool owns_resource;

    public ManagedRenderTexture(RenderTexture2D handle) {
        this.resource = handle;
        this.owns_resource = handle != null;
    }

    public static ManagedRenderTexture load(int32 width, int32 height) {
        return new ManagedRenderTexture(LoadRenderTexture(width, height));
    }

    public bool is_valid() {
        return this.resource != null && (this.resource.id != (uint32)0);
    }

    public RenderTexture2D get() {
        return this.resource;
    }

    public RenderTexture2D release() {
        this.owns_resource = false;
        return this.resource;
    }

    public void dispose() {
        if (this.owns_resource && this.resource != null && (this.resource.id != (uint32)0)) {
            UnloadRenderTexture(this.resource);
        }
        this.owns_resource = false;
    }

    ~ManagedRenderTexture() {
        this.dispose();
    }
}

