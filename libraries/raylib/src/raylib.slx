    public static native void wait_time(float64 seconds);
    /// Set the seed for the random number generator
    public static native void SetRandomSeed(uint32 seed);
    public static native void set_random_seed(uint32 seed);
    /// Get a random value between min and max (both included)
    public static native int32 GetRandomValue(int32 min, int32 max);
    public static native int32 get_random_value(int32 min, int32 max);
    /// Load random values sequence, no values repeated
