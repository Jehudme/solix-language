        result.m5 = (this.m1 * other.m4) + (this.m5 * other.m5) + (this.m9 * other.m6) + (this.m13 * other.m7);
        result.m9 = (this.m1 * other.m8) + (this.m5 * other.m9) + (this.m9 * other.m10) + (this.m13 * other.m11);
        result.m13 = (this.m1 * other.m12) + (this.m5 * other.m13) + (this.m9 * other.m14) + (this.m13 * other.m15);
        result.m2 = (this.m2 * other.m0) + (this.m6 * other.m1) + (this.m10 * other.m2) + (this.m14 * other.m3);
        result.m6 = (this.m2 * other.m4) + (this.m6 * other.m5) + (this.m10 * other.m6) + (this.m14 * other.m7);
        result.m10 = (this.m2 * other.m8) + (this.m6 * other.m9) + (this.m10 * other.m10) + (this.m14 * other.m11);
        result.m14 = (this.m2 * other.m12) + (this.m6 * other.m13) + (this.m10 * other.m14) + (this.m14 * other.m15);
        result.m3 = (this.m3 * other.m0) + (this.m7 * other.m1) + (this.m11 * other.m2) + (this.m15 * other.m3);
        result.m7 = (this.m3 * other.m4) + (this.m7 * other.m5) + (this.m11 * other.m6) + (this.m15 * other.m7);
        result.m11 = (this.m3 * other.m8) + (this.m7 * other.m9) + (this.m11 * other.m10) + (this.m15 * other.m11);
        result.m15 = (this.m3 * other.m12) + (this.m7 * other.m13) + (this.m11 * other.m14) + (this.m15 * other.m15);
        return result;
    }

    public bool equals(Matrix other) {
        if (other == null) { return false; }
        return this.m0 == other.m0 && this.m4 == other.m4 && this.m8 == other.m8 && this.m12 == other.m12 && this.m1 == other.m1 && this.m5 == other.m5 && this.m9 == other.m9 && this.m13 == other.m13 && this.m2 == other.m2 && this.m6 == other.m6 && this.m10 == other.m10 && this.m14 == other.m14 && this.m3 == other.m3 && this.m7 == other.m7 && this.m11 == other.m11 && this.m15 == other.m15;
    }

    public bool operator==(Matrix other) {
        return this.equals(other);
    }

    public bool operator!=(Matrix other) {
        return !this.equals(other);
    }
}

/// Color, 4 components, R8G8B8A8 (32bit)
public class Color {
    /// Color red value
    public uint8 r;
    /// Color green value
    public uint8 g;
    /// Color blue value
    public uint8 b;
    /// Color alpha value
    public uint8 a;

    public Color() {
        this.r = (uint8)0;
        this.g = (uint8)0;
        this.b = (uint8)0;
        this.a = (uint8)0;
    }

    public Color(uint8 init_r, uint8 init_g, uint8 init_b, uint8 init_a) {
        this.r = init_r;
        this.g = init_g;
        this.b = init_b;
        this.a = init_a;
    }

    // --- Preset Constants ---
    /// Light Gray
    public static Color LIGHTGRAY = new Color((uint8)200, (uint8)200, (uint8)200, (uint8)255);
    /// Gray
    public static Color GRAY = new Color((uint8)130, (uint8)130, (uint8)130, (uint8)255);
    /// Dark Gray
    public static Color DARKGRAY = new Color((uint8)80, (uint8)80, (uint8)80, (uint8)255);
    /// Yellow
    public static Color YELLOW = new Color((uint8)253, (uint8)249, (uint8)0, (uint8)255);
    /// Gold
    public static Color GOLD = new Color((uint8)255, (uint8)203, (uint8)0, (uint8)255);
    /// Orange
    public static Color ORANGE = new Color((uint8)255, (uint8)161, (uint8)0, (uint8)255);
    /// Pink
    public static Color PINK = new Color((uint8)255, (uint8)109, (uint8)194, (uint8)255);
    /// Red
    public static Color RED = new Color((uint8)230, (uint8)41, (uint8)55, (uint8)255);
    /// Maroon
    public static Color MAROON = new Color((uint8)190, (uint8)33, (uint8)55, (uint8)255);
    /// Green
    public static Color GREEN = new Color((uint8)0, (uint8)228, (uint8)48, (uint8)255);
    /// Lime
    public static Color LIME = new Color((uint8)0, (uint8)158, (uint8)47, (uint8)255);
    /// Dark Green
    public static Color DARKGREEN = new Color((uint8)0, (uint8)117, (uint8)44, (uint8)255);
    /// Sky Blue
    public static Color SKYBLUE = new Color((uint8)102, (uint8)191, (uint8)255, (uint8)255);
    /// Blue
    public static Color BLUE = new Color((uint8)0, (uint8)121, (uint8)241, (uint8)255);
    /// Dark Blue
    public static Color DARKBLUE = new Color((uint8)0, (uint8)82, (uint8)172, (uint8)255);
    /// Purple
    public static Color PURPLE = new Color((uint8)200, (uint8)122, (uint8)255, (uint8)255);
    /// Violet
    public static Color VIOLET = new Color((uint8)135, (uint8)60, (uint8)190, (uint8)255);
    /// Dark Purple
    public static Color DARKPURPLE = new Color((uint8)112, (uint8)31, (uint8)126, (uint8)255);
    /// Beige
    public static Color BEIGE = new Color((uint8)211, (uint8)176, (uint8)131, (uint8)255);
    /// Brown
    public static Color BROWN = new Color((uint8)127, (uint8)106, (uint8)79, (uint8)255);
    /// Dark Brown
    public static Color DARKBROWN = new Color((uint8)76, (uint8)63, (uint8)47, (uint8)255);
    /// White
    public static Color WHITE = new Color((uint8)255, (uint8)255, (uint8)255, (uint8)255);
    /// Black
    public static Color BLACK = new Color((uint8)0, (uint8)0, (uint8)0, (uint8)255);
    /// Blank (Transparent)
    public static Color BLANK = new Color((uint8)0, (uint8)0, (uint8)0, (uint8)0);
    /// Magenta
    public static Color MAGENTA = new Color((uint8)255, (uint8)0, (uint8)255, (uint8)255);
    /// My own White (raylib logo)
    public static Color RAYWHITE = new Color((uint8)245, (uint8)245, (uint8)245, (uint8)255);

    public Color(int32 init_r, int32 init_g, int32 init_b) {
        this.r = (uint8)(init_r < 0 ? 0 : (init_r > 255 ? 255 : init_r));
        this.g = (uint8)(init_g < 0 ? 0 : (init_g > 255 ? 255 : init_g));
        this.b = (uint8)(init_b < 0 ? 0 : (init_b > 255 ? 255 : init_b));
        this.a = (uint8)255;
    }

    public Color(int32 init_r, int32 init_g, int32 init_b, int32 init_a) {
        this.r = (uint8)(init_r < 0 ? 0 : (init_r > 255 ? 255 : init_r));
        this.g = (uint8)(init_g < 0 ? 0 : (init_g > 255 ? 255 : init_g));
        this.b = (uint8)(init_b < 0 ? 0 : (init_b > 255 ? 255 : init_b));
        this.a = (uint8)(init_a < 0 ? 0 : (init_a > 255 ? 255 : init_a));
    }

    public static Color from_hex(int32 rgba_hex) {
        uint8 red_byte = (uint8)((rgba_hex >> 24) & 255);
        uint8 green_byte = (uint8)((rgba_hex >> 16) & 255);
        uint8 blue_byte = (uint8)((rgba_hex >> 8) & 255);
        uint8 alpha_byte = (uint8)(rgba_hex & 255);
        return new Color(red_byte, green_byte, blue_byte, alpha_byte);
    }

    public static Color from_rgb(int32 rgb_hex) {
        uint8 red_byte = (uint8)((rgb_hex >> 16) & 255);
        uint8 green_byte = (uint8)((rgb_hex >> 8) & 255);
        uint8 blue_byte = (uint8)(rgb_hex & 255);
        return new Color(red_byte, green_byte, blue_byte, (uint8)255);
    }

    public Color with_alpha(int32 alpha_byte) {
        return new Color(this.r, this.g, this.b, (uint8)(alpha_byte < 0 ? 0 : (alpha_byte > 255 ? 255 : alpha_byte)));
    }

    public Color with_alpha(float32 alpha_norm) {
        int32 scaled_alpha = (int32)(alpha_norm * (float32)255.0);
        return new Color(this.r, this.g, this.b, (uint8)(scaled_alpha < 0 ? 0 : (scaled_alpha > 255 ? 255 : scaled_alpha)));
    }

    public Color with_alpha(float64 alpha_norm) {
        int32 scaled_alpha = (int32)(alpha_norm * 255.0);
        return new Color(this.r, this.g, this.b, (uint8)(scaled_alpha < 0 ? 0 : (scaled_alpha > 255 ? 255 : scaled_alpha)));
    }

    public bool equals(Color other) {
        if (other == null) { return false; }
        return this.r == other.r && this.g == other.g && this.b == other.b && this.a == other.a;
    }

    public bool operator==(Color other) {
        return this.equals(other);
    }

    public bool operator!=(Color other) {
        return !this.equals(other);
    }
}

/// Rectangle, 4 components
public class Rectangle {
    /// Rectangle top-left corner position x
    public float32 x;
    /// Rectangle top-left corner position y
    public float32 y;
    /// Rectangle width
    public float32 width;
    /// Rectangle height
    public float32 height;

    public Rectangle() {
        this.x = (float32)0.0;
        this.y = (float32)0.0;
        this.width = (float32)0.0;
        this.height = (float32)0.0;
    }

    public Rectangle(float32 init_x, float32 init_y, float32 init_width, float32 init_height) {
        this.x = init_x;
        this.y = init_y;
        this.width = init_width;
        this.height = init_height;
    }

    public Rectangle(float64 init_x, float64 init_y, float64 init_width, float64 init_height) {
        this.x = (float32)init_x;
        this.y = (float32)init_y;
        this.width = (float32)init_width;
        this.height = (float32)init_height;
    }

    public Rectangle(int32 init_x, int32 init_y, int32 init_width, int32 init_height) {
        this.x = (float32)init_x;
        this.y = (float32)init_y;
        this.width = (float32)init_width;
        this.height = (float32)init_height;
    }

    public Rectangle(Vector2 pos_vec, Vector2 size_vec) {
        this.x = (pos_vec != null) ? pos_vec.x : (float32)0.0;
        this.y = (pos_vec != null) ? pos_vec.y : (float32)0.0;
        this.width = (size_vec != null) ? size_vec.x : (float32)0.0;
        this.height = (size_vec != null) ? size_vec.y : (float32)0.0;
    }

    public Vector2 position() {
        return new Vector2(this.x, this.y);
    }

    public Vector2 size() {
        return new Vector2(this.width, this.height);
    }

    public Vector2 center() {
        return new Vector2(this.x + (this.width * (float32)0.5), this.y + (this.height * (float32)0.5));
    }

    public bool contains(Vector2 point) {
        if (point == null) { return false; }
        return this.contains(point.x, point.y);
    }

    public float32 right() {
        return this.x + this.width;
    }

    public float32 bottom() {
        return this.y + this.height;
    }

    public bool contains(float32 point_x, float32 point_y) {
        return point_x >= this.x && point_x <= (this.x + this.width) && point_y >= this.y && point_y <= (this.y + this.height);
    }

    public bool overlaps(Rectangle other) {
        if (other == null) { return false; }
        return (this.x < other.x + other.width)
            && (this.x + this.width > other.x)
            && (this.y < other.y + other.height)
            && (this.y + this.height > other.y);
    }

    public bool equals(Rectangle other) {
        if (other == null) { return false; }
        return this.x == other.x && this.y == other.y && this.width == other.width && this.height == other.height;
    }

    public bool operator==(Rectangle other) {
        return this.equals(other);
    }

    public bool operator!=(Rectangle other) {
        return !this.equals(other);
    }
}

/// Image, pixel data stored in CPU memory (RAM)
public class Image {
    /// Image raw data
    public uint64 data;
    /// Image base width
    public int32 width;
    /// Image base height
    public int32 height;
    /// Mipmap levels, 1 by default
    public int32 mipmaps;
    /// Data format (PixelFormat type)
    public int32 format;

    public Image() {
        this.data = (uint64)0;
        this.width = 0;
        this.height = 0;
        this.mipmaps = 0;
        this.format = 0;
    }

    public Image(uint64 init_data, int32 init_width, int32 init_height, int32 init_mipmaps, int32 init_format) {
        this.data = init_data;
        this.width = init_width;
        this.height = init_height;
        this.mipmaps = init_mipmaps;
        this.format = init_format;
    }
}

/// Texture, tex data stored in GPU memory (VRAM)
public class Texture {
    /// OpenGL texture id
    public uint32 id;
    /// Texture base width
    public int32 width;
    /// Texture base height
    public int32 height;
    /// Mipmap levels, 1 by default
    public int32 mipmaps;
    /// Data format (PixelFormat type)
    public int32 format;

    public Texture() {
        this.id = (uint32)0;
        this.width = 0;
        this.height = 0;
        this.mipmaps = 0;
        this.format = 0;
    }

    public Texture(uint32 init_id, int32 init_width, int32 init_height, int32 init_mipmaps, int32 init_format) {
        this.id = init_id;
        this.width = init_width;
        this.height = init_height;
        this.mipmaps = init_mipmaps;
        this.format = init_format;
    }
}

/// RenderTexture, fbo for texture rendering
public class RenderTexture {
    /// OpenGL framebuffer object id
    public uint32 id;
    /// Color buffer attachment texture
    public Texture texture;
    /// Depth buffer attachment texture
    public Texture depth;

    public RenderTexture() {
        this.id = (uint32)0;
        this.texture = new Texture();
        this.depth = new Texture();
    }

    public RenderTexture(uint32 init_id, Texture init_texture, Texture init_depth) {
        this.id = init_id;
        this.texture = init_texture;
        this.depth = init_depth;
    }
}

/// NPatchInfo, n-patch layout info
public class NPatchInfo {
    /// Texture source rectangle
    public Rectangle source;
    /// Left border offset
    public int32 left;
    /// Top border offset
    public int32 top;
    /// Right border offset
    public int32 right;
    /// Bottom border offset
    public int32 bottom;
    /// Layout of the n-patch: 3x3, 1x3 or 3x1
    public int32 layout;

    public NPatchInfo() {
        this.source = new Rectangle();
        this.left = 0;
        this.top = 0;
        this.right = 0;
        this.bottom = 0;
        this.layout = 0;
    }

    public NPatchInfo(Rectangle init_source, int32 init_left, int32 init_top, int32 init_right, int32 init_bottom, int32 init_layout) {
        this.source = init_source;
        this.left = init_left;
        this.top = init_top;
        this.right = init_right;
        this.bottom = init_bottom;
        this.layout = init_layout;
    }
}

/// GlyphInfo, font characters glyphs info
public class GlyphInfo {
    /// Character value (Unicode)
    public int32 value;
    /// Character offset X when drawing
    public int32 offsetX;
    /// Character offset Y when drawing
    public int32 offsetY;
    /// Character advance position X
    public int32 advanceX;
    /// Character image data
    public Image image;

    public GlyphInfo() {
        this.value = 0;
        this.offsetX = 0;
        this.offsetY = 0;
        this.advanceX = 0;
        this.image = new Image();
    }

    public GlyphInfo(int32 init_value, int32 init_offsetX, int32 init_offsetY, int32 init_advanceX, Image init_image) {
        this.value = init_value;
        this.offsetX = init_offsetX;
        this.offsetY = init_offsetY;
        this.advanceX = init_advanceX;
        this.image = init_image;
    }
}

/// Font, font texture and GlyphInfo array data
public class Font {
    /// Base size (default chars height)
    public int32 baseSize;
    /// Number of glyph characters
    public int32 glyphCount;
    /// Padding around the glyph characters
    public int32 glyphPadding;
    /// Texture atlas containing the glyphs
    public Texture2D texture;
    /// Rectangles in texture for the glyphs
    public uint64 recs;
    /// Glyphs info data
    public uint64 glyphs;

    public Font() {
        this.baseSize = 0;
        this.glyphCount = 0;
        this.glyphPadding = 0;
        this.texture = new Texture2D();
        this.recs = (uint64)0;
        this.glyphs = (uint64)0;
    }

    public Font(int32 init_baseSize, int32 init_glyphCount, int32 init_glyphPadding, Texture2D init_texture, uint64 init_recs, uint64 init_glyphs) {
        this.baseSize = init_baseSize;
        this.glyphCount = init_glyphCount;
        this.glyphPadding = init_glyphPadding;
        this.texture = init_texture;
        this.recs = init_recs;
        this.glyphs = init_glyphs;
    }
}

/// Camera, defines position/orientation in 3d space
public class Camera3D {
    /// Camera position
    public Vector3 position;
    /// Camera target it looks-at
    public Vector3 target;
    /// Camera up vector (rotation over its axis)
    public Vector3 up;
    /// Camera field-of-view aperture in Y (degrees) in perspective, used as near plane height in world units in orthographic
    public float32 fovy;
    /// Camera projection: CAMERA_PERSPECTIVE or CAMERA_ORTHOGRAPHIC
    public int32 projection;

    public Camera3D() {
        this.position = new Vector3();
        this.target = new Vector3();
        this.up = new Vector3();
        this.fovy = (float32)0.0;
        this.projection = 0;
    }

    public Camera3D(Vector3 init_position, Vector3 init_target, Vector3 init_up, float32 init_fovy, int32 init_projection) {
        this.position = init_position;
        this.target = init_target;
        this.up = init_up;
        this.fovy = init_fovy;
        this.projection = init_projection;
    }
}

/// Camera2D, defines position/orientation in 2d space
public class Camera2D {
    /// Camera offset (screen space offset from window origin, unscaled by DPI, real pixel size)
    public Vector2 offset;
    /// Camera target (world space target point that is mapped to screen space offset)
    public Vector2 target;
    /// Camera rotation in degrees (pivots around target)
    public float32 rotation;
    /// Camera zoom (scaling around target), must not be set to 0, set to 1.0f for no scale
    public float32 zoom;

    public Camera2D() {
        this.offset = new Vector2();
        this.target = new Vector2();
        this.rotation = (float32)0.0;
        this.zoom = (float32)0.0;
    }

    public Camera2D(Vector2 init_offset, Vector2 init_target, float32 init_rotation, float32 init_zoom) {
        this.offset = init_offset;
        this.target = init_target;
        this.rotation = init_rotation;
        this.zoom = init_zoom;
    }
}

/// Mesh, vertex data and vao/vbo
public class Mesh {
    /// Number of vertices stored in arrays
    public int32 vertexCount;
    /// Number of triangles stored (indexed or not)
    public int32 triangleCount;
    /// Vertex position (XYZ - 3 components per vertex) (shader-location = 0)
    public uint64 vertices;
    /// Vertex texture coordinates (UV - 2 components per vertex) (shader-location = 1)
    public uint64 texcoords;
    /// Vertex texture second coordinates (UV - 2 components per vertex) (shader-location = 5)
    public uint64 texcoords2;
    /// Vertex normals (XYZ - 3 components per vertex) (shader-location = 2)
    public uint64 normals;
    /// Vertex tangents (XYZW - 4 components per vertex) (shader-location = 4)
    public uint64 tangents;
    /// Vertex colors (RGBA - 4 components per vertex) (shader-location = 3)
    public uint64 colors;
    /// Vertex indices (in case vertex data comes indexed)
    public uint64 indices;
    /// Number of bones (MAX: 256 bones)
    public int32 boneCount;
    /// Vertex bone indices, up to 4 bones influence by vertex (skinning) (shader-location = 6)
    public uint64 boneIndices;
    /// Vertex bone weight, up to 4 bones influence by vertex (skinning) (shader-location = 7)
    public uint64 boneWeights;
    /// Animated vertex positions (after bones transformations)
    public uint64 animVertices;
    /// Animated normals (after bones transformations)
    public uint64 animNormals;
    /// OpenGL Vertex Array Object id
    public uint32 vaoId;
    /// OpenGL Vertex Buffer Objects id (default vertex data)
    public uint64 vboId;

    public Mesh() {
        this.vertexCount = 0;
        this.triangleCount = 0;
        this.vertices = (uint64)0;
        this.texcoords = (uint64)0;
        this.texcoords2 = (uint64)0;
        this.normals = (uint64)0;
        this.tangents = (uint64)0;
        this.colors = (uint64)0;
        this.indices = (uint64)0;
        this.boneCount = 0;
        this.boneIndices = (uint64)0;
        this.boneWeights = (uint64)0;
        this.animVertices = (uint64)0;
        this.animNormals = (uint64)0;
        this.vaoId = (uint32)0;
        this.vboId = (uint64)0;
    }
}

/// Shader
public class Shader {
    /// Shader program id
    public uint32 id;
    /// Shader locations array (RL_MAX_SHADER_LOCATIONS)
    public uint64 locs;

    public Shader() {
        this.id = (uint32)0;
        this.locs = (uint64)0;
    }

    public Shader(uint32 init_id, uint64 init_locs) {
        this.id = init_id;
        this.locs = init_locs;
    }
}

/// MaterialMap
public class MaterialMap {
    /// Material map texture
    public Texture2D texture;
    /// Material map color
    public Color color;
    /// Material map value
    public float32 value;

    public MaterialMap() {
        this.texture = new Texture2D();
        this.color = new Color();
        this.value = (float32)0.0;
    }

    public MaterialMap(Texture2D init_texture, Color init_color, float32 init_value) {
        this.texture = init_texture;
        this.color = init_color;
        this.value = init_value;
    }
}

/// Material, includes shader and maps
public class Material {
    /// Material shader
    public Shader shader;
    /// Material maps array (MAX_MATERIAL_MAPS)
    public uint64 maps;
    /// Material generic parameters (if required)
    public float32[] params;

    public Material() {
        this.shader = new Shader();
        this.maps = (uint64)0;
        this.params = new float32[4];
    }
}

/// Transform, vertex transformation data
public class Transform {
    /// Translation
    public Vector3 translation;
    /// Rotation
    public Quaternion rotation;
    /// Scale
    public Vector3 scale;

    public Transform() {
        this.translation = new Vector3();
        this.rotation = new Quaternion();
        this.scale = new Vector3();
    }

    public Transform(Vector3 init_translation, Quaternion init_rotation, Vector3 init_scale) {
        this.translation = init_translation;
        this.rotation = init_rotation;
        this.scale = init_scale;
    }
}

/// Bone, skeletal animation bone
public class BoneInfo {
    /// Bone name
    public string name;
    /// Bone parent
    public int32 parent;

    public BoneInfo() {
        this.name = "";
        this.parent = 0;
    }
}

/// Skeleton, animation bones hierarchy
public class ModelSkeleton {
    /// Number of bones
    public uint32 boneCount;
    /// Bones information (skeleton)
    public uint64 bones;
    /// Bones base transformation (Transform[])
    public uint64 bindPose;

    public ModelSkeleton() {
        this.boneCount = (uint32)0;
        this.bones = (uint64)0;
        this.bindPose = (uint64)0;
    }

    public ModelSkeleton(uint32 init_boneCount, uint64 init_bones, uint64 init_bindPose) {
        this.boneCount = init_boneCount;
        this.bones = init_bones;
        this.bindPose = init_bindPose;
    }
}

/// Model, meshes, materials and animation data
public class Model {
    /// Local transform matrix
    public Matrix transform;
    /// Number of meshes
    public int32 meshCount;
    /// Number of materials
    public int32 materialCount;
    /// Meshes array
    public uint64 meshes;
    /// Materials array
    public uint64 materials;
    /// Mesh material number
    public uint64 meshMaterial;
    /// Skeleton for animation
    public ModelSkeleton skeleton;
    /// Current animation pose (Transform[])
    public uint64 currentPose;
    /// Bones animated transformation matrices
    public uint64 boneMatrices;

    public Model() {
        this.transform = new Matrix();
        this.meshCount = 0;
        this.materialCount = 0;
        this.meshes = (uint64)0;
        this.materials = (uint64)0;
        this.meshMaterial = (uint64)0;
        this.skeleton = new ModelSkeleton();
        this.currentPose = (uint64)0;
        this.boneMatrices = (uint64)0;
    }
}

/// ModelAnimation, contains a full animation sequence
public class ModelAnimation {
    /// Animation name
    public string name;
    /// Number of bones (per pose)
    public uint32 boneCount;
    /// Number of animation key frames
    public int32 keyframeCount;
    /// Animation sequence keyframe poses [keyframe][pose]
    public uint64 keyframePoses;

    public ModelAnimation() {
        this.name = "";
        this.boneCount = (uint32)0;
        this.keyframeCount = 0;
        this.keyframePoses = (uint64)0;
    }
}

/// Ray, ray for raycasting
public class Ray {
    /// Ray position (origin)
    public Vector3 position;
    /// Ray direction (normalized)
    public Vector3 direction;

    public Ray() {
        this.position = new Vector3();
        this.direction = new Vector3();
    }

    public Ray(Vector3 init_position, Vector3 init_direction) {
        this.position = init_position;
        this.direction = init_direction;
    }
}

/// RayCollision, ray hit information
public class RayCollision {
    /// Did the ray hit something?
    public bool hit;
    /// Distance to the nearest hit
    public float32 distance;
    /// Point of the nearest hit
    public Vector3 point;
    /// Surface normal of hit
    public Vector3 normal;

    public RayCollision() {
        this.hit = false;
        this.distance = (float32)0.0;
        this.point = new Vector3();
        this.normal = new Vector3();
    }

    public RayCollision(bool init_hit, float32 init_distance, Vector3 init_point, Vector3 init_normal) {
        this.hit = init_hit;
        this.distance = init_distance;
        this.point = init_point;
        this.normal = init_normal;
    }
}

/// BoundingBox
public class BoundingBox {
    /// Minimum vertex box-corner
    public Vector3 min;
    /// Maximum vertex box-corner
    public Vector3 max;

    public BoundingBox() {
        this.min = new Vector3();
        this.max = new Vector3();
    }

    public BoundingBox(Vector3 init_min, Vector3 init_max) {
        this.min = init_min;
        this.max = init_max;
    }
}

/// Wave, audio wave data
public class Wave {
    /// Total number of frames (considering channels)
    public uint32 frameCount;
    /// Frequency (samples per second)
    public uint32 sampleRate;
    /// Bit depth (bits per sample): 8, 16, 32 (24 not supported)
    public uint32 sampleSize;
    /// Number of channels (1-mono, 2-stereo, ...)
    public uint32 channels;
    /// Buffer data pointer
    public uint64 data;

    public Wave() {
        this.frameCount = (uint32)0;
        this.sampleRate = (uint32)0;
        this.sampleSize = (uint32)0;
        this.channels = (uint32)0;
        this.data = (uint64)0;
    }

    public Wave(uint32 init_frameCount, uint32 init_sampleRate, uint32 init_sampleSize, uint32 init_channels, uint64 init_data) {
        this.frameCount = init_frameCount;
        this.sampleRate = init_sampleRate;
        this.sampleSize = init_sampleSize;
        this.channels = init_channels;
        this.data = init_data;
    }
}

/// AudioStream, custom audio stream
public class AudioStream {
    /// Pointer to internal data used by the audio system
    public uint64 buffer;
    /// Pointer to internal data processor, useful for audio effects
    public uint64 processor;
    /// Frequency (samples per second)
    public uint32 sampleRate;
    /// Bit depth (bits per sample): 8, 16, 32 (24 not supported)
    public uint32 sampleSize;
    /// Number of channels (1-mono, 2-stereo, ...)
    public uint32 channels;

    public AudioStream() {
        this.buffer = (uint64)0;
        this.processor = (uint64)0;
        this.sampleRate = (uint32)0;
        this.sampleSize = (uint32)0;
        this.channels = (uint32)0;
    }

    public AudioStream(uint64 init_buffer, uint64 init_processor, uint32 init_sampleRate, uint32 init_sampleSize, uint32 init_channels) {
        this.buffer = init_buffer;
        this.processor = init_processor;
        this.sampleRate = init_sampleRate;
        this.sampleSize = init_sampleSize;
        this.channels = init_channels;
    }
}

/// Sound
public class Sound {
    /// Audio stream
    public AudioStream stream;
    /// Total number of frames (considering channels)
    public uint32 frameCount;

    public Sound() {
        this.stream = new AudioStream();
        this.frameCount = (uint32)0;
    }

    public Sound(AudioStream init_stream, uint32 init_frameCount) {
        this.stream = init_stream;
        this.frameCount = init_frameCount;
    }
}

/// Music, audio stream, anything longer than ~10 seconds should be streamed
public class Music {
    /// Audio stream
    public AudioStream stream;
    /// Total number of frames (considering channels)
    public uint32 frameCount;
    /// Music looping enable
    public bool looping;
    /// Type of music context (audio filetype)
    public int32 ctxType;
    /// Audio context data, depends on type
    public uint64 ctxData;

    public Music() {
        this.stream = new AudioStream();
        this.frameCount = (uint32)0;
        this.looping = false;
        this.ctxType = 0;
        this.ctxData = (uint64)0;
    }

    public Music(AudioStream init_stream, uint32 init_frameCount, bool init_looping, int32 init_ctxType, uint64 init_ctxData) {
        this.stream = init_stream;
        this.frameCount = init_frameCount;
        this.looping = init_looping;
        this.ctxType = init_ctxType;
        this.ctxData = init_ctxData;
    }
}

/// VrDeviceInfo, Head-Mounted-Display device parameters
public class VrDeviceInfo {
    /// Horizontal resolution in pixels
    public int32 hResolution;
    /// Vertical resolution in pixels
    public int32 vResolution;
    /// Horizontal size in meters
    public float32 hScreenSize;
    /// Vertical size in meters
    public float32 vScreenSize;
    /// Distance between eye and display in meters
    public float32 eyeToScreenDistance;
    /// Lens separation distance in meters
    public float32 lensSeparationDistance;
    /// IPD (distance between pupils) in meters
    public float32 interpupillaryDistance;
    /// Lens distortion constant parameters
    public float32[] lensDistortionValues;
    /// Chromatic aberration correction parameters
    public float32[] chromaAbCorrection;

    public VrDeviceInfo() {
        this.hResolution = 0;
        this.vResolution = 0;
        this.hScreenSize = (float32)0.0;
        this.vScreenSize = (float32)0.0;
        this.eyeToScreenDistance = (float32)0.0;
        this.lensSeparationDistance = (float32)0.0;
        this.interpupillaryDistance = (float32)0.0;
        this.lensDistortionValues = new float32[4];
        this.chromaAbCorrection = new float32[4];
    }
}

/// VrStereoConfig, VR stereo rendering configuration for simulator
public class VrStereoConfig {
    /// VR projection matrices (per eye)
    public Matrix[] projection;
    /// VR view offset matrices (per eye)
    public Matrix[] viewOffset;
    /// VR left lens center
    public float32[] leftLensCenter;
    /// VR right lens center
    public float32[] rightLensCenter;
    /// VR left screen center
    public float32[] leftScreenCenter;
    /// VR right screen center
    public float32[] rightScreenCenter;
    /// VR distortion scale
    public float32[] scale;
    /// VR distortion scale in
    public float32[] scaleIn;

    public VrStereoConfig() {
        this.projection = new Matrix[2];
        this.viewOffset = new Matrix[2];
        this.leftLensCenter = new float32[2];
        this.rightLensCenter = new float32[2];
        this.leftScreenCenter = new float32[2];
        this.rightScreenCenter = new float32[2];
        this.scale = new float32[2];
        this.scaleIn = new float32[2];
    }
}

/// File path list
public class FilePathList {
    /// Filepaths entries count
    public uint32 count;
    /// Filepaths entries
    public uint64 paths;

    public FilePathList() {
        this.count = (uint32)0;
        this.paths = (uint64)0;
    }

    public FilePathList(uint32 init_count, uint64 init_paths) {
        this.count = init_count;
        this.paths = init_paths;
    }
}

/// Automation event
public class AutomationEvent {
    /// Event frame
    public uint32 frame;
    /// Event type (AutomationEventType)
    public uint32 type;
    /// Event parameters (if required)
    public int32[] params;

    public AutomationEvent() {
        this.frame = (uint32)0;
        this.type = (uint32)0;
        this.params = new int32[4];
    }
}

/// Automation event list
public class AutomationEventList {
    /// Events max entries (MAX_AUTOMATION_EVENTS)
    public uint32 capacity;
    /// Events entries count
    public uint32 count;
    /// Events entries
    public uint64 events;

    public AutomationEventList() {
        this.capacity = (uint32)0;
        this.count = (uint32)0;
        this.events = (uint64)0;
    }

    public AutomationEventList(uint32 init_capacity, uint32 init_count, uint64 init_events) {
        this.capacity = init_capacity;
        this.count = init_count;
        this.events = init_events;
    }
}

/// Dynamic vertex buffers (position + texcoords + colors + indices arrays)
public class rlVertexBuffer {
    /// Number of elements in the buffer (QUADS)
    public int32 elementCount;
    /// Vertex position (XYZ - 3 components per vertex) (shader-location = 0)
    public uint64 vertices;
    /// Vertex texture coordinates (UV - 2 components per vertex) (shader-location = 1)
    public uint64 texcoords;
    /// Vertex normal (XYZ - 3 components per vertex) (shader-location = 2)
    public uint64 normals;
    /// Vertex colors (RGBA - 4 components per vertex) (shader-location = 3)
    public uint64 colors;
    /// Vertex indices (in case vertex data comes indexed) (6 indices per quad)
    public uint64 indices;
    /// OpenGL Vertex Array Object id
    public uint32 vaoId;
    /// OpenGL Vertex Buffer Objects id (5 types of vertex data)
    public uint32[] vboId;

    public rlVertexBuffer() {
        this.elementCount = 0;
        this.vertices = (uint64)0;
        this.texcoords = (uint64)0;
        this.normals = (uint64)0;
        this.colors = (uint64)0;
        this.indices = (uint64)0;
        this.vaoId = (uint32)0;
        this.vboId = new uint32[5];
    }
}

/// of those state-change happens (this is done in core module)
public class rlDrawCall {
    /// Drawing mode: LINES, TRIANGLES, QUADS
    public int32 mode;
    /// Number of vertex of the draw
    public int32 vertexCount;
    /// Number of vertex required for index alignment (LINES, TRIANGLES)
    public int32 vertexAlignment;
    /// Texture id to be used on the draw -> Use to create new draw call if changes
    public uint32 textureId;

    public rlDrawCall() {
        this.mode = 0;
        this.vertexCount = 0;
        this.vertexAlignment = 0;
        this.textureId = (uint32)0;
    }

    public rlDrawCall(int32 init_mode, int32 init_vertexCount, int32 init_vertexAlignment, uint32 init_textureId) {
        this.mode = init_mode;
        this.vertexCount = init_vertexCount;
        this.vertexAlignment = init_vertexAlignment;
        this.textureId = init_textureId;
    }
}

/// rlRenderBatch type
public class rlRenderBatch {
    /// Number of vertex buffers (multi-buffering support)
    public int32 bufferCount;
    /// Current buffer tracking in case of multi-buffering
    public int32 currentBuffer;
    /// Dynamic buffer(s) for vertex data
    public uint64 vertexBuffer;
    /// Draw calls array, depends on textureId
    public uint64 draws;
    /// Draw calls counter
    public int32 drawCounter;
    /// Current depth value for next draw
    public float32 currentDepth;

    public rlRenderBatch() {
        this.bufferCount = 0;
        this.currentBuffer = 0;
        this.vertexBuffer = (uint64)0;
        this.draws = (uint64)0;
        this.drawCounter = 0;
        this.currentDepth = (float32)0.0;
    }

    public rlRenderBatch(int32 init_bufferCount, int32 init_currentBuffer, uint64 init_vertexBuffer, uint64 init_draws, int32 init_drawCounter, float32 init_currentDepth) {
        this.bufferCount = init_bufferCount;
        this.currentBuffer = init_currentBuffer;
        this.vertexBuffer = init_vertexBuffer;
        this.draws = init_draws;
        this.drawCounter = init_drawCounter;
        this.currentDepth = init_currentDepth;
    }
}

public class float3 {
    public float32[] v;

    public float3() {
        this.v = new float32[3];
    }
}

public class float16 {
    public float32[] v;

    public float16() {
        this.v = new float32[16];
    }
}

// ===========================================================================
// Type Aliases
// ===========================================================================
/// Quaternion, 4 components (Vector4 alias)
alias Quaternion = Vector4;

/// Texture2D, same as Texture
alias Texture2D = Texture;

/// TextureCubemap, same as Texture
alias TextureCubemap = Texture;

/// RenderTexture2D, same as RenderTexture
alias RenderTexture2D = RenderTexture;

/// Camera type fallback, defaults to Camera3D
alias Camera = Camera3D;

// ===========================================================================
// Primary Engine API (Top-Level Package Functions)
// ===========================================================================
/// Initialize window and OpenGL context
public native void InitWindow(int32 width, int32 height, string title);
/// Close window and unload OpenGL context
public native void CloseWindow();
/// Check if application should close (KEY_ESCAPE pressed or windows close icon clicked)
public native bool WindowShouldClose();
/// Check if window has been initialized successfully
public native bool IsWindowReady();
/// Check if window is currently fullscreen
public native bool IsWindowFullscreen();
/// Check if window is currently hidden
public native bool IsWindowHidden();
/// Check if window is currently minimized
public native bool IsWindowMinimized();
/// Check if window is currently maximized
public native bool IsWindowMaximized();
/// Check if window is currently focused
public native bool IsWindowFocused();
/// Check if window has been resized last frame
public native bool IsWindowResized();
/// Check if one specific window flag is enabled
public native bool IsWindowState(uint32 flag);
/// Set window configuration state using flags
public native void SetWindowState(uint32 flags);
/// Clear window configuration state flags
public native void ClearWindowState(uint32 flags);
/// Toggle window state: fullscreen/windowed, resizes monitor to match window resolution
public native void ToggleFullscreen();
/// Toggle window state: borderless windowed, resizes window to match monitor resolution
public native void ToggleBorderlessWindowed();
/// Set window state: maximized, if resizable
public native void MaximizeWindow();
/// Set window state: minimized, if resizable
public native void MinimizeWindow();
/// Restore window from being minimized/maximized
public native void RestoreWindow();
/// Set icon for window (single image, RGBA 32bit)
public native void SetWindowIcon(Image image);
/// Set icon for window (multiple images, RGBA 32bit)
public native void SetWindowIcons(Image images, int32 count);
/// Set title for window
public native void SetWindowTitle(string title);
/// Set window position on screen
public native void SetWindowPosition(int32 x, int32 y);
/// Set monitor for the current window
public native void SetWindowMonitor(int32 monitor);
/// Set window minimum dimensions (for FLAG_WINDOW_RESIZABLE)
public native void SetWindowMinSize(int32 width, int32 height);
/// Set window maximum dimensions (for FLAG_WINDOW_RESIZABLE)
public native void SetWindowMaxSize(int32 width, int32 height);
/// Set window dimensions
public native void SetWindowSize(int32 width, int32 height);
/// Set window opacity [0.0f..1.0f]
public native void SetWindowOpacity(float32 opacity);
/// Set window focused
public native void SetWindowFocused();
/// Get native window handle
public native uint64 GetWindowHandle();
/// Get current screen width
public native int32 GetScreenWidth();
/// Get current screen height
public native int32 GetScreenHeight();
/// Get current render width (it considers HiDPI)
public native int32 GetRenderWidth();
/// Get current render height (it considers HiDPI)
public native int32 GetRenderHeight();
/// Get number of connected monitors
public native int32 GetMonitorCount();
/// Get current monitor where window is placed
public native int32 GetCurrentMonitor();
/// Get specified monitor position
public native Vector2 GetMonitorPosition(int32 monitor);
/// Get specified monitor width (current video mode used by monitor)
public native int32 GetMonitorWidth(int32 monitor);
/// Get specified monitor height (current video mode used by monitor)
public native int32 GetMonitorHeight(int32 monitor);
/// Get specified monitor physical width in millimetres
public native int32 GetMonitorPhysicalWidth(int32 monitor);
/// Get specified monitor physical height in millimetres
public native int32 GetMonitorPhysicalHeight(int32 monitor);
/// Get specified monitor refresh rate
public native int32 GetMonitorRefreshRate(int32 monitor);
/// Get window position XY on monitor
public native Vector2 GetWindowPosition();
/// Get window scale DPI factor
public native Vector2 GetWindowScaleDPI();
/// Get the human-readable, UTF-8 encoded name of the specified monitor
public native string GetMonitorName(int32 monitor);
/// Set clipboard text content
public native void SetClipboardText(string text);
/// Get clipboard text content
public native string GetClipboardText();
/// Get clipboard image content
public native Image GetClipboardImage();
/// Enable waiting for events on EndDrawing(), no automatic event polling
public native void EnableEventWaiting();
/// Disable waiting for events on EndDrawing(), automatic events polling
public native void DisableEventWaiting();
/// Show cursor
public native void ShowCursor();
/// Hide cursor
public native void HideCursor();
/// Check if cursor is not visible
public native bool IsCursorHidden();
/// Enable cursor (unlock cursor)
public native void EnableCursor();
/// Disable cursor (lock cursor)
public native void DisableCursor();
/// Check if cursor is on the screen
public native bool IsCursorOnScreen();
/// Clear background (framebuffer) to color
public native void ClearBackground(Color color);
/// Begin canvas (framebuffer) drawing
public native void BeginDrawing();
/// End canvas (framebuffer) drawing and swap buffers (double buffering)
public native void EndDrawing();
/// Begin 2D mode with custom camera (2D)
public native void BeginMode2D(Camera2D camera);
/// End 2D mode with custom camera
public native void EndMode2D();
/// Begin 3D mode with custom camera (3D)
public native void BeginMode3D(Camera3D camera);
/// End 3D mode and returns to default 2D orthographic mode
public native void EndMode3D();
/// Begin drawing to render texture
public native void BeginTextureMode(RenderTexture2D target);
/// End drawing to render texture
public native void EndTextureMode();
/// Begin custom shader drawing
public native void BeginShaderMode(Shader shader);
/// End custom shader drawing (use default shader)
public native void EndShaderMode();
/// Begin blending mode (alpha, additive, multiplied, subtract, custom)
public native void BeginBlendMode(int32 mode);
/// End blending mode (reset to default: alpha blending)
public native void EndBlendMode();
/// Begin scissor mode (define screen area for following drawing)
public native void BeginScissorMode(int32 x, int32 y, int32 width, int32 height);
/// End scissor mode
public native void EndScissorMode();
/// Begin stereo rendering (requires VR simulator)
public native void BeginVrStereoMode(VrStereoConfig config);
/// End stereo rendering (requires VR simulator)
public native void EndVrStereoMode();
/// Load VR stereo config for VR simulator device parameters
public native VrStereoConfig LoadVrStereoConfig(VrDeviceInfo device);
/// Unload VR stereo config
public native void UnloadVrStereoConfig(VrStereoConfig config);
/// Load shader from files and bind default locations
public native Shader LoadShader(string vsFileName, string fsFileName);
/// Load shader from code strings and bind default locations
public native Shader LoadShaderFromMemory(string vsCode, string fsCode);
/// Check if shader is valid (loaded on GPU)
public native bool IsShaderValid(Shader shader);
/// Get shader uniform location
public native int32 GetShaderLocation(Shader shader, string uniformName);
/// Get shader attribute location
public native int32 GetShaderLocationAttrib(Shader shader, string attribName);
/// Set shader uniform value
public native void SetShaderValue(Shader shader, int32 locIndex, uint64 value, int32 uniformType);
/// Set shader uniform value vector
public native void SetShaderValueV(Shader shader, int32 locIndex, uint64 value, int32 uniformType, int32 count);
/// Set shader uniform value (matrix 4x4)
public native void SetShaderValueMatrix(Shader shader, int32 locIndex, Matrix mat);
/// Set shader uniform value and bind the texture (sampler2d)
public native void SetShaderValueTexture(Shader shader, int32 locIndex, Texture2D texture);
/// Unload shader from GPU memory (VRAM)
public native void UnloadShader(Shader shader);
/// Get a ray trace from screen position (i.e mouse)
public native Ray GetScreenToWorldRay(Vector2 position, Camera camera);
/// Get a ray trace from screen position (i.e mouse) in a viewport
public native Ray GetScreenToWorldRayEx(Vector2 position, Camera camera, int32 width, int32 height);
/// Get screen space position for a 3d world space position
public native Vector2 GetWorldToScreen(Vector3 position, Camera camera);
/// Get sized screen space position for a 3d world space position
public native Vector2 GetWorldToScreenEx(Vector3 position, Camera camera, int32 width, int32 height);
/// Get screen space position for a 2d camera world space position
public native Vector2 GetWorldToScreen2D(Vector2 position, Camera2D camera);
/// Get world space position for a 2d camera screen space position
public native Vector2 GetScreenToWorld2D(Vector2 position, Camera2D camera);
/// Get camera transform matrix (view matrix)
public native Matrix GetCameraMatrix(Camera camera);
/// Get camera 2d transform matrix
public native Matrix GetCameraMatrix2D(Camera2D camera);
/// Set target FPS (maximum)
public native void SetTargetFPS(int32 fps);
/// Get time in seconds for last frame drawn (delta time)
public native float32 GetFrameTime();
/// Get elapsed time in seconds since InitWindow()
public native float64 GetTime();
/// Get current FPS
public native int32 GetFPS();
/// Swap back buffer with front buffer (screen drawing)
public native void SwapScreenBuffer();
/// Register all input events
public native void PollInputEvents();
/// Wait for some time (halt program execution)
public native void WaitTime(float64 seconds);
/// Set the seed for the random number generator
public native void SetRandomSeed(uint32 seed);
/// Get a random value between min and max (both included)
public native int32 GetRandomValue(int32 min, int32 max);
/// Load random values sequence, no values repeated
public native uint64 LoadRandomSequence(uint32 count, int32 min, int32 max);
/// Unload random values sequence
public native void UnloadRandomSequence(uint64 sequence);
/// Takes a screenshot of current screen (filename extension defines format)
public native void TakeScreenshot(string fileName);
/// Set init configuration flags (view FLAGS)
public native void SetConfigFlags(uint32 flags);
/// Open URL with default system browser (if available)
public native void OpenURL(string url);
/// Set the current threshold (minimum) log level
public native void SetTraceLogLevel(int32 logLevel);
/// Show trace log messages (LOG_DEBUG, LOG_INFO, LOG_WARNING, LOG_ERROR...)
public native void TraceLog(int32 logLevel, string text);
/// Set custom trace log
public native void SetTraceLogCallback(uint64 callback);
/// Internal memory allocator
public native uint64 MemAlloc(uint32 size);
/// Internal memory reallocator
public native uint64 MemRealloc(uint64 ptr, uint32 size);
/// Internal memory free
public native void MemFree(uint64 ptr);
/// Load file data as byte array (read)
public native uint64 LoadFileData(string fileName, int32[] dataSize);
/// Unload file data allocated by LoadFileData()
public native void UnloadFileData(uint64 data);
/// Save data to file from byte array (write), returns true on success
public native bool SaveFileData(string fileName, uint64 data, int32 dataSize);
/// Export data to code (.h), returns true on success
public native bool ExportDataAsCode(uint8[] data, int32 dataSize, string fileName);
/// Load text data from file (read), returns a '\0' terminated string
public native string LoadFileText(string fileName);
/// Unload file text data allocated by LoadFileText()
public native void UnloadFileText(string text);
/// Save text data to file (write), string must be '\0' terminated, returns true on success
public native bool SaveFileText(string fileName, string text);
/// Set custom file binary data loader
public native void SetLoadFileDataCallback(uint64 callback);
/// Set custom file binary data saver
public native void SetSaveFileDataCallback(uint64 callback);
/// Set custom file text data loader
public native void SetLoadFileTextCallback(uint64 callback);
/// Set custom file text data saver
public native void SetSaveFileTextCallback(uint64 callback);
/// Rename file (if exists), returns 0 on success
public native int32 FileRename(string fileName, string fileRename);
/// Remove file (if exists), returns 0 on success
public native int32 FileRemove(string fileName);
/// Copy file from one path to another, dstPath created if it doesn't exist, returns 0 on success
public native int32 FileCopy(string srcPath, string dstPath);
/// Move file from one directory to another, dstPath created if it doesn't exist, returns 0 on success
public native int32 FileMove(string srcPath, string dstPath);
/// Replace text in an existing file, returns 0 on success
public native int32 FileTextReplace(string fileName, string search, string replacement);
/// Find text in existing file, returns -1 if index not found or index otherwise
public native int32 FileTextFindIndex(string fileName, string search);
/// Check if file exists
public native bool FileExists(string fileName);
/// Check if directory path exists
public native bool DirectoryExists(string dirPath);
/// Check file extension (recommended include point: .png, .wav)
public native bool IsFileExtension(string fileName, string ext);
/// Check if file path (file or directory) is hidden by OS
public native bool IsFileHidden(string filePath);
/// Get file length in bytes (NOTE: GetFileSize() conflicts with windows.h)
public native int32 GetFileLength(string fileName);
/// Get file modification time (last write time)
public native int64 GetFileModTime(string fileName);
/// Get pointer to extension for a filename string (includes dot: '.png')
public native string GetFileExtension(string fileName);
/// Get pointer to filename for a path string
public native string GetFileName(string filePath);
/// Get filename string without extension (uses static string)
public native string GetFileNameWithoutExt(string filePath);
/// Get full path for a provided fileName with path (uses static string)
public native string GetDirectoryPath(string filePath);
/// Get previous directory path for a provided path (uses static string)
public native string GetPrevDirectoryPath(string dirPath);
/// Get current working directory (uses static string)
public native string GetWorkingDirectory();
/// Get the directory of the running application (uses static string)
public native string GetApplicationDirectory();
/// Create directories (including full path requested), returns 0 on success
public native int32 MakeDirectory(string dirPath);
/// Change working directory, returns 0 on success
public native int32 ChangeDirectory(string dirPath);
/// Check if provided path points to a file
public native bool IsPathFile(string path);
/// Check if provided path points to a directory
public native bool IsPathDirectory(string path);
/// Check if provided path is an absolute path
public native bool IsPathAbsolute(string path);
/// Check if fileName is valid for the platform/OS
public native bool IsFileNameValid(string fileName);
/// Load directory filepaths, files and directories, no subdirs scan
public native FilePathList LoadDirectoryFiles(string dirPath);
/// Load directory filepaths with extension filtering and subdir scan; some filters available: '*.*','FILES*','DIRS*'
