        result.m0 = (this.m0 * other.m0) + (this.m4 * other.m1) + (this.m8 * other.m2) + (this.m12 * other.m3);
        result.m4 = (this.m0 * other.m4) + (this.m4 * other.m5) + (this.m8 * other.m6) + (this.m12 * other.m7);
