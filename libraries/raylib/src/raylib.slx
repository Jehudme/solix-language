    CAMERA_ORBITAL = 2,
    /// Camera first person
    CAMERA_FIRST_PERSON = 3,
    /// Camera third person
    CAMERA_THIRD_PERSON = 4
}

/// Camera projection
public enum CameraProjection {
    /// Perspective projection
    CAMERA_PERSPECTIVE = 0,
    /// Orthographic projection
    CAMERA_ORTHOGRAPHIC = 1
}

/// N-patch layout
public enum NPatchLayout {
    /// Npatch layout: 3x3 tiles
    NPATCH_NINE_PATCH = 0,
    /// Npatch layout: 1x3 tiles
    NPATCH_THREE_PATCH_VERTICAL = 1,
    /// Npatch layout: 3x1 tiles
    NPATCH_THREE_PATCH_HORIZONTAL = 2
}

// ===========================================================================
// Struct Classes
// ===========================================================================
/// Vector2, 2 components
public class Vector2 {
    /// Vector x component
    public float32 x;
    /// Vector y component
    public float32 y;

    public Vector2() {
        this.x = (float32)0.0;
        this.y = (float32)0.0;
    }

    public Vector2(float32 init_x, float32 init_y) {
        this.x = init_x;
        this.y = init_y;
    }
}

/// Vector3, 3 components
public class Vector3 {
    /// Vector x component
    public float32 x;
    /// Vector y component
    public float32 y;
    /// Vector z component
    public float32 z;

    public Vector3() {
        this.x = (float32)0.0;
        this.y = (float32)0.0;
        this.z = (float32)0.0;
    }

    public Vector3(float32 init_x, float32 init_y, float32 init_z) {
        this.x = init_x;
        this.y = init_y;
        this.z = init_z;
    }
}

/// Vector4, 4 components
public class Vector4 {
    /// Vector x component
    public float32 x;
    /// Vector y component
    public float32 y;
    /// Vector z component
    public float32 z;
    /// Vector w component
    public float32 w;

    public Vector4() {
        this.x = (float32)0.0;
        this.y = (float32)0.0;
        this.z = (float32)0.0;
        this.w = (float32)0.0;
    }

    public Vector4(float32 init_x, float32 init_y, float32 init_z, float32 init_w) {
        this.x = init_x;
        this.y = init_y;
        this.z = init_z;
        this.w = init_w;
    }
}

/// Matrix, 4x4 components, column major, OpenGL style, right-handed
public class Matrix {
    /// Matrix first row (4 components)
    public float32 m0;
    /// Matrix first row (4 components)
    public float32 m4;
    /// Matrix first row (4 components)
    public float32 m8;
    /// Matrix first row (4 components)
    public float32 m12;
    /// Matrix second row (4 components)
    public float32 m1;
    /// Matrix second row (4 components)
    public float32 m5;
    /// Matrix second row (4 components)
    public float32 m9;
    /// Matrix second row (4 components)
    public float32 m13;
    /// Matrix third row (4 components)
    public float32 m2;
    /// Matrix third row (4 components)
    public float32 m6;
    /// Matrix third row (4 components)
    public float32 m10;
    /// Matrix third row (4 components)
    public float32 m14;
    /// Matrix fourth row (4 components)
    public float32 m3;
    /// Matrix fourth row (4 components)
    public float32 m7;
    /// Matrix fourth row (4 components)
    public float32 m11;
    /// Matrix fourth row (4 components)
    public float32 m15;

    public Matrix() {
        this.m0 = (float32)0.0;
        this.m4 = (float32)0.0;
        this.m8 = (float32)0.0;
        this.m12 = (float32)0.0;
        this.m1 = (float32)0.0;
        this.m5 = (float32)0.0;
        this.m9 = (float32)0.0;
        this.m13 = (float32)0.0;
        this.m2 = (float32)0.0;
        this.m6 = (float32)0.0;
        this.m10 = (float32)0.0;
        this.m14 = (float32)0.0;
        this.m3 = (float32)0.0;
        this.m7 = (float32)0.0;
        this.m11 = (float32)0.0;
        this.m15 = (float32)0.0;
    }
}

/// Color, 4 components, R8G8B8A8 (32bit)
public class Color {
    /// Color red value
    public uint8 r;
    /// Color green value
    public uint8 g;
    /// Color blue value
    public uint8 b;
    /// Color alpha value
    public uint8 a;

    public Color() {
        this.r = (uint8)0;
        this.g = (uint8)0;
        this.b = (uint8)0;
        this.a = (uint8)0;
