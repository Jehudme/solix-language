// ===========================================================================
// Scoped Frame & Mode Guards
// ===========================================================================
public void with_drawing(void(*)() draw_callback) {
    BeginDrawing();
    try {
        if (draw_callback != null) {
            draw_callback();
        }
    } finally {
        EndDrawing();
    }
}

public void with_mode_2d(Camera2D camera, void(*)() draw_callback) {
    BeginMode2D(camera);
    try {
        if (draw_callback != null) {
            draw_callback();
        }
    } finally {
        EndMode2D();
    }
}

public void with_mode_3d(Camera3D camera, void(*)() draw_callback) {
    BeginMode3D(camera);
    try {
        if (draw_callback != null) {
            draw_callback();
        }
    } finally {
        EndMode3D();
    }
}

public void with_texture_mode(RenderTexture2D target, void(*)() draw_callback) {
    BeginTextureMode(target);
    try {
        if (draw_callback != null) {
            draw_callback();
        }
    } finally {
        EndTextureMode();
    }
}

