        if (target == null) { return new Vector3(this.x, this.y, this.z); }
        return new Vector3(this.x + ((target.x - this.x) * amount), this.y + ((target.y - this.y) * amount), this.z + ((target.z - this.z) * amount));
    }

    public Vector3 cross(Vector3 other) {
        if (other == null) { return new Vector3(); }
        return new Vector3(
            (this.y * other.z) - (this.z * other.y),
            (this.z * other.x) - (this.x * other.z),
            (this.x * other.y) - (this.y * other.x)
        );
    }
