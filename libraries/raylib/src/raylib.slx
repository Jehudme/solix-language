    }

    public Vector3 normalized() {
        float32 magnitude = this.length();
        if (magnitude <= (float32)0.0) {
            return new Vector3((float32)0.0, (float32)0.0, (float32)0.0);
        }
        float32 inv_length = (float32)1.0 / magnitude;
        return new Vector3(this.x * inv_length, this.y * inv_length, this.z * inv_length);
    }

    public float32 distance_to(Vector3 other) {
        if (other == null) { return this.length(); }
        return _raylib_sqrt_f32(((this.x - other.x) * (this.x - other.x)) + ((this.y - other.y) * (this.y - other.y)) + ((this.z - other.z) * (this.z - other.z)));
    }

