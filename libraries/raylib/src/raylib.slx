// ===========================================================================
// Struct Classes
// ===========================================================================
/// Vector2, 2 components
public class Vector2 {
    /// Vector x component
    public float32 x;
    /// Vector y component
    public float32 y;

    public Vector2() {
        this.x = (float32)0.0;
        this.y = (float32)0.0;
    }

    public Vector2(float32 init_x, float32 init_y) {
        this.x = init_x;
        this.y = init_y;
    }

    public Vector2(float64 init_x, float64 init_y) {
        this.x = (float32)init_x;
        this.y = (float32)init_y;
    }

    public Vector2(int32 init_x, int32 init_y) {
        this.x = (float32)init_x;
        this.y = (float32)init_y;
    }

    public static Vector2 ZERO = new Vector2((float32)0.0, (float32)0.0);
    public static Vector2 ONE = new Vector2((float32)1.0, (float32)1.0);
    public static Vector2 UNIT_X = new Vector2((float32)1.0, (float32)0.0);
    public static Vector2 UNIT_Y = new Vector2((float32)0.0, (float32)1.0);

    public Vector2 operator+(Vector2 other) {
        if (other == null) { return new Vector2(this.x, this.y); }
        return new Vector2(this.x + other.x, this.y + other.y);
    }

