import raylib.*;

public class TestRunner {
    public static int32 test() {
        // Test 1: Vector2 struct creation and field values
        Vector2 position_2d = new Vector2((float32)100.0, (float32)200.0);
        if (position_2d.x != (float32)100.0) {
            return 1;
        }
        if (position_2d.y != (float32)200.0) {
            return 2;
        }

        // Test 2: Vector3 struct creation
        Vector3 position_3d = new Vector3((float32)1.0, (float32)2.0, (float32)3.0);
        if (position_3d.z != (float32)3.0) {
            return 3;
        }

        // Test 3: Rectangle struct creation
        Rectangle test_rect = new Rectangle((float32)10.0, (float32)20.0, (float32)300.0, (float32)200.0);
        if (test_rect.width != (float32)300.0 || test_rect.height != (float32)200.0) {
            return 4;
        }

        // Test 4: Color presets and fields
        Color color_red = Color::RED;
        if (color_red.r != (uint8)230 || color_red.g != (uint8)41 || color_red.b != (uint8)55) {
            return 5;
        }

        // Test 5: KeyboardKey enum constant
        int32 key_space = KeyboardKey::KEY_SPACE;
        if (key_space != 32) {
            return 6;
        }

        // Test 6: CheckCollisionPointRec with Vector2 and Rectangle (verifies float32 IEEE-754 bit-encoding)
        Vector2 test_point = new Vector2((float32)50.0, (float32)50.0);
        Rectangle collision_rect = new Rectangle((float32)0.0, (float32)0.0, (float32)100.0, (float32)100.0);
        bool collision_result = CheckCollisionPointRec(test_point, collision_rect);
        if (!collision_result) {
            return 7;
        }
        Vector2 outside_point = new Vector2((float32)150.0, (float32)50.0);
        bool outside_result = CheckCollisionPointRec(outside_point, collision_rect);
        if (outside_result) {
            return 12;
        }

        // Test 7: Raylib version constants exported at package root
        int32 version_major = RAYLIB_VERSION_MAJOR;
        if (version_major != 6) {
            return 8;
        }

        // Test 8: Native Raylib API calls (Trace log level & window querying)
        SetTraceLogLevel(TraceLogLevel::LOG_NONE);
        bool window_ready_before = IsWindowReady();
        if (window_ready_before) {
            return 9;
        }

        // Test 9: Package-qualified root PascalCase Raylib calls
        raylib::SetTraceLogLevel(TraceLogLevel::LOG_NONE);
        bool window_ready_qualified = raylib::IsWindowReady();
        if (window_ready_qualified) {
            return 10;
        }

        // Test 10: Window lifecycle initialization and closure
        InitWindow(320, 240, "Solix Raylib Conformance Test");
        bool window_ready_after = IsWindowReady();
        if (!window_ready_after) {
            CloseWindow();
            return 11;
        }

        CloseWindow();

        // Test 11: float32 array allocation and indexing
        float32[] float_elements = new float32[4];
        float_elements[0] = (float32)1.5;
        float_elements[1] = (float32)2.5;
        float_elements[2] = (float32)3.5;
        float_elements[3] = (float32)4.5;
        if (float_elements[0] != (float32)1.5 || float_elements[1] != (float32)2.5) {
            return 13;
        }

        // Test 12: Nested struct marshalling (Ray -> GetRayCollisionSphere -> RayCollision)
        Ray test_ray = new Ray();
        test_ray.position.x = (float32)0.0;
        test_ray.position.y = (float32)0.0;
        test_ray.position.z = (float32)0.0;
        test_ray.direction.x = (float32)0.0;
        test_ray.direction.y = (float32)1.0;
        test_ray.direction.z = (float32)0.0;
        Vector3 sphere_center = new Vector3((float32)0.0, (float32)10.0, (float32)0.0);
        float32 sphere_radius = (float32)2.0;

        RayCollision ray_collision = GetRayCollisionSphere(test_ray, sphere_center, sphere_radius);
        if (!ray_collision.hit) {
            return 14;
        }
        if (ray_collision.distance != (float32)8.0) {
            return 15;
        }
        if (ray_collision.point.y != (float32)8.0) {
            return 16;
        }

        // Test 13: Vector2 / Vector3 OOP math operators & helpers
        Vector2 pos_a = new Vector2(3, 4);
        Vector2 vel_a = new Vector2(1.0, 2.0);
        Vector2 moved = pos_a + (vel_a * 2.0);
        if (moved.x != (float32)5.0 || moved.y != (float32)8.0) {
            return 17;
        }
        Vector2 diff = moved - pos_a;
        if (diff != new Vector2(2, 4)) {
            return 18;
        }
        float32 len_a = pos_a.length();
        if (len_a < (float32)4.99 || len_a > (float32)5.01) {
            return 19;
        }
        Vector2 unit_a = pos_a.normalized();
        if (unit_a.length() < (float32)0.99 || unit_a.length() > (float32)1.01) {
            return 20;
        }
        if (pos_a.dot(Vector2::UNIT_X) != (float32)3.0) {
            return 21;
        }

        Vector3 basis_x = new Vector3(1, 0, 0);
        Vector3 basis_y = new Vector3(0, 1, 0);
        Vector3 cross_z = basis_x.cross(basis_y);
        if (cross_z != Vector3::UNIT_Z) {
            return 22;
        }
        Matrix identity_mat = Matrix::identity();
        Matrix doubled_mat = identity_mat * 2;
        if (doubled_mat.m0 != (float32)2.0 || (identity_mat * identity_mat) != identity_mat) {
            return 23;
        }

        // Test 14: Color hex/int constructors + Rectangle geometry helpers
        Color hex_color = Color::from_hex(0x11223344);
        if (hex_color.r != (uint8)0x11 || hex_color.g != (uint8)0x22
            || hex_color.b != (uint8)0x33 || hex_color.a != (uint8)0x44) {
            return 24;
        }
        Color semi = new Color(100, 150, 200).with_alpha(128);
        if (semi.a != (uint8)128 || semi != new Color(100, 150, 200, 128)) {
            return 25;
        }

        Rectangle bounds = new Rectangle(10, 20, 100, 50);
        if (!bounds.contains(new Vector2(50, 40)) || bounds.contains(new Vector2(200, 40))) {
            return 26;
        }
        if (!bounds.overlaps(new Rectangle(90, 30, 40, 40))
            || bounds.center() != new Vector2(60, 45)) {
            return 27;
        }

        // Test 15: ManagedImage RAII wrapper lifecycle (CPU-safe headless test)
        ManagedImage managed_img = new ManagedImage(GenImageColor(4, 4, Color::RED));
        if (!managed_img.is_valid()) {
            return 28;
        }
        managed_img.dispose();

        return 0;
    }
}

public class Main {
    public static int32 main() {
        return TestRunner::test();
    }
}
