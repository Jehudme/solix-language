package solix.tests;

import solix.math.Math;
import solix.math.Random;

public class TestMath {
    public static int32 run_all_tests() {
        if (!TestMath::test_math_basics()) {
            return 1;
        }
        if (!TestMath::test_math_transcendentals()) {
            return 2;
        }
        if (!TestMath::test_math_integers()) {
            return 3;
        }
        if (!TestMath::test_random()) {
            return 4;
        }
        return 0;
    }

    public static bool test_math_basics() {
        if (Math::abs(-42) != 42 || Math::abs(42) != 42) {
            return false;
        }
        if (Math::abs(-100L) != 100L) {
            return false;
        }
        if (Math::min(10, 20) != 10 || Math::max(10, 20) != 20) {
            return false;
        }
        if (Math::clamp(5, 10, 20) != 10 || Math::clamp(25, 10, 20) != 20 || Math::clamp(15, 10, 20) != 15) {
            return false;
        }
        if (Math::sign(-50) != -1 || Math::sign(50) != 1 || Math::sign(0) != 0) {
            return false;
        }
        return true;
    }

    public static bool test_math_transcendentals() {
        float64 sqrt_val = Math::sqrt(16.0);
        if (sqrt_val < 3.999 || sqrt_val > 4.001) {
            return false;
        }

        float64 pow_val = Math::pow(2.0, 8.0);
        if (pow_val < 255.999 || pow_val > 256.001) {
            return false;
        }

        float64 floor_val = Math::floor(3.8);
        if (floor_val < 2.999 || floor_val > 3.001) {
            return false;
        }

        float64 ceil_val = Math::ceil(3.2);
        if (ceil_val < 3.999 || ceil_val > 4.001) {
            return false;
        }

        return true;
    }

    public static bool test_math_integers() {
        if (Math::gcd(48L, 18L) != 6L) {
            return false;
        }
        if (Math::lcm(12L, 15L) != 60L) {
            return false;
        }
        if (Math::factorial(5) != 120L) {
            return false;
        }
        if (!Math::is_prime(29L)) {
            return false;
        }
        if (Math::is_prime(30L)) {
            return false;
        }
        return true;
    }

    public static bool test_random() {
        Random prng = new Random(123456789L);

        int32 trial_index = 0;
        while (trial_index < 100) {
            int32 random_int = prng.next_int32();
            if (random_int < 0) {
                return false;
            }

            int32 bounded_int = prng.next_int32(50);
            if (bounded_int < 0 || bounded_int >= 50) {
                return false;
            }

            int32 range_int = prng.next_int32(100, 200);
            if (range_int < 100 || range_int >= 200) {
                return false;
            }

            float64 random_float = prng.next_float64();
            if (random_float < 0.0 || random_float >= 1.0) {
                return false;
            }

            trial_index = trial_index + 1;
        }

        return true;
    }
}
