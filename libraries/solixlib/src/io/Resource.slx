package solix.io;

import solix.core.String;
import solix.collections.List;
import solix.core.FileNotFoundException;
import solix.core.IOException;

public class Resource {
    public static String get_resource_directory() {
        return new String(Resource::native_get_resource_root());
    }

    private static String strip_mount_prefix(String path) {
        if (path != null && path.starts_with("mount://")) {
            return path.substring(8, path.length() - 8);
        }
        return path;
    }

    public static String get_path(string relative_path) {
        String wrapped_path = (relative_path != null) ? new String(relative_path) : new String("");
        return Resource::get_path(wrapped_path);
    }

    public static String get_path(String relative_path) {
        String clean_path = Resource::strip_mount_prefix(relative_path);
        if (clean_path == null || clean_path.data == null) {
            return Resource::get_resource_directory();
        }
        return new String(Resource::native_get_path(clean_path.to_chars()));
    }

    public static bool exists(string relative_path) {
        String wrapped_path = (relative_path != null) ? new String(relative_path) : new String("");
        return Resource::exists(wrapped_path);
    }

    public static bool exists(String relative_path) {
        String clean_path = Resource::strip_mount_prefix(relative_path);
        if (clean_path == null || clean_path.data == null) {
            return false;
        }
        return Resource::native_exists(clean_path.to_chars());
    }

    public static String read_all_text(string relative_path) {
        String wrapped_path = (relative_path != null) ? new String(relative_path) : new String("");
        return Resource::read_all_text(wrapped_path);
    }

    public static String read_all_text(String relative_path) {
        String clean_path = Resource::strip_mount_prefix(relative_path);
        if (clean_path == null || clean_path.data == null) {
            throw new FileNotFoundException("", "Resource path is null");
        }
        if (!Resource::exists(clean_path)) {
            throw new FileNotFoundException(clean_path.data, "Resource not found");
        }
        char[] content_chars = Resource::native_read_all_text(clean_path.to_chars());
        return new String(content_chars);
    }

    public static List<String> read_all_lines(string relative_path) {
        String wrapped_path = (relative_path != null) ? new String(relative_path) : new String("");
        return Resource::read_all_lines(wrapped_path);
    }

    public static List<String> read_all_lines(String relative_path) {
        String full_content = Resource::read_all_text(relative_path);
        String[] split_parts = full_content.lines();
        List<String> output_lines = new List<String>(split_parts.length);
        for (int32 line_index = 0; line_index < split_parts.length; line_index = line_index + 1) {
            output_lines.add(split_parts[line_index]);
        }
        return output_lines;
    }

    private static native char[] native_get_resource_root();
    private static native char[] native_get_path(char[] relative_path);
    private static native bool native_exists(char[] relative_path);
    private static native char[] native_read_all_text(char[] relative_path);
}
