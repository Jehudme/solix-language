package solix.core;

public class Exception {
    public string message;
    public Exception cause;

    public Exception() {
        this.message = "";
        this.cause = null;
    }

    public Exception(string message) {
        this.message = message;
        this.cause = null;
    }

    public Exception(string message, Exception cause) {
        this.message = message;
        this.cause = cause;
    }

    public Exception(String message) {
        if (message != null) {
            this.message = message.data;
        } else {
            this.message = "";
        }
        this.cause = null;
    }

    public Exception(String message, Exception cause) {
        if (message != null) {
            this.message = message.data;
        } else {
            this.message = "";
        }
        this.cause = cause;
    }

    public string get_message() {
        return this.message;
    }

    public Exception get_cause() {
        return this.cause;
    }

    public String to_string() {
        return new String(this.message);
    }
}

public class RuntimeException extends Exception {
    public RuntimeException() : super("") {}
    public RuntimeException(string message) : super(message) {}
    public RuntimeException(String message) : super(message) {}
    public RuntimeException(string message, Exception cause) : super(message, cause) {}
    public RuntimeException(String message, Exception cause) : super(message, cause) {}
}

public class IllegalArgumentException extends RuntimeException {
    public string parameter_name;

    public IllegalArgumentException() : super("Illegal argument provided.") {
        this.parameter_name = "";
    }
    public IllegalArgumentException(string message) : super(message) {
        this.parameter_name = "";
    }
    public IllegalArgumentException(String message) : super(message) {
        this.parameter_name = "";
    }
    public IllegalArgumentException(string parameter_name, string message) : super(message) {
        this.parameter_name = parameter_name;
    }
    public IllegalArgumentException(String parameter_name, String message) : super(message) {
        if (parameter_name != null) {
            this.parameter_name = parameter_name.data;
        } else {
            this.parameter_name = "";
        }
    }
    public IllegalArgumentException(string message, Exception cause) : super(message, cause) {
        this.parameter_name = "";
    }
    public IllegalArgumentException(String message, Exception cause) : super(message, cause) {
        this.parameter_name = "";
    }
}

public class ArgumentNullException extends IllegalArgumentException {
    public ArgumentNullException() : super("Argument cannot be null.") {
        this.parameter_name = "";
    }

    public ArgumentNullException(string parameter_name) : super(parameter_name) {
        this.parameter_name = parameter_name;
    }

    public ArgumentNullException(string parameter_name, string message) : super(message) {
        this.parameter_name = parameter_name;
    }

    public ArgumentNullException(String parameter_name, String message) : super(message) {
        if (parameter_name != null) {
            this.parameter_name = parameter_name.data;
        } else {
            this.parameter_name = "";
        }
    }
}

public class ArgumentOutOfRangeException extends IllegalArgumentException {
    public ArgumentOutOfRangeException() : super("Argument was out of the range of valid values.") {
        this.parameter_name = "";
    }

    public ArgumentOutOfRangeException(string parameter_name) : super(parameter_name) {
        this.parameter_name = parameter_name;
    }

    public ArgumentOutOfRangeException(string parameter_name, string message) : super(message) {
        this.parameter_name = parameter_name;
    }

    public ArgumentOutOfRangeException(String parameter_name, String message) : super(message) {
        if (parameter_name != null) {
            this.parameter_name = parameter_name.data;
        } else {
            this.parameter_name = "";
        }
    }
}

public class IndexOutOfBoundsException extends RuntimeException {
    public int32 requested_index;
    public int32 lower_bound;
    public int32 upper_bound;

    public IndexOutOfBoundsException() : super("Index was outside the bounds of the array or collection.") {
        this.requested_index = 0;
        this.lower_bound = 0;
        this.upper_bound = 0;
    }

    public IndexOutOfBoundsException(string message) : super(message) {
        this.requested_index = 0;
        this.lower_bound = 0;
        this.upper_bound = 0;
    }

    public IndexOutOfBoundsException(String message) : super(message) {
        this.requested_index = 0;
        this.lower_bound = 0;
        this.upper_bound = 0;
    }

    public IndexOutOfBoundsException(string message, int32 requested_index, int32 lower_bound, int32 upper_bound) : super(message) {
        this.requested_index = requested_index;
        this.lower_bound = lower_bound;
        this.upper_bound = upper_bound;
    }

    public IndexOutOfBoundsException(String message, int32 requested_index, int32 lower_bound, int32 upper_bound) : super(message) {
        this.requested_index = requested_index;
        this.lower_bound = lower_bound;
        this.upper_bound = upper_bound;
    }
}

