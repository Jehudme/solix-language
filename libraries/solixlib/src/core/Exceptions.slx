    public NullPointerException() : super("Null reference encountered.") {}
    public NullPointerException(string message) : super(message) {}
    public NullPointerException(String message) : super(message) {}
    public NullPointerException(string message, Exception cause) : super(message, cause) {}
    public NullPointerException(String message, Exception cause) : super(message, cause) {}
}

