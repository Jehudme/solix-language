    public ArithmeticException() : super("Arithmetic error occurred.") {}
    public ArithmeticException(string message) : super(message) {}
    public ArithmeticException(String message) : super(message) {}
    public ArithmeticException(string message, Exception cause) : super(message, cause) {}
    public ArithmeticException(String message, Exception cause) : super(message, cause) {}
}

public class FormatException extends RuntimeException {
    public FormatException() : super("Invalid format.") {}
    public FormatException(string message) : super(message) {}
    public FormatException(String message) : super(message) {}
    public FormatException(string message, Exception cause) : super(message, cause) {}
    public FormatException(String message, Exception cause) : super(message, cause) {}
