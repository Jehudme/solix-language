    public DirectoryNotFoundException(string message) : super(message) {
        this.target_path = new String("");
    }

    public DirectoryNotFoundException(String message) : super(message) {
        this.target_path = new String("");
    }

    public DirectoryNotFoundException(string target_path, string message) : super(message) {
