    }

    public DirectoryNotFoundException(String target_path, String message) : super(message) {
        this.target_path = (target_path != null) ? target_path : new String("");
    }

    public DirectoryNotFoundException(char[] target_path, string message) : super(message) {
        this.target_path = new String(target_path);
    }

    public DirectoryNotFoundException(string message, Exception cause) : super(message, cause) {
        this.target_path = new String("");
    }

    public DirectoryNotFoundException(String message, Exception cause) : super(message, cause) {
        this.target_path = new String("");
    }
}

