public class NumberFormatException extends IllegalArgumentException {
    public NumberFormatException() : super("Input string was not in a valid numeric format.") {}
    public NumberFormatException(string message) : super(message) {}
    public NumberFormatException(String message) : super(message) {}
    public NumberFormatException(string message, Exception cause) : super(message, cause) {}
    public NumberFormatException(String message, Exception cause) : super(message, cause) {}
}

public class IOException extends Exception {
    public IOException() : super("I/O error occurred.") {}
    public IOException(string message) : super(message) {}
    public IOException(String message) : super(message) {}
    public IOException(string message, Exception cause) : super(message, cause) {}
    public IOException(String message, Exception cause) : super(message, cause) {}
}

public class FileNotFoundException extends IOException {
    public String target_path;

    public FileNotFoundException() : super("File not found.") {
        this.target_path = new String("");
    }

    public FileNotFoundException(string message) : super(message) {
        this.target_path = new String("");
    }

    public FileNotFoundException(String message) : super(message) {
        this.target_path = new String("");
    }

    public FileNotFoundException(string target_path, string message) : super(message) {
        this.target_path = new String(target_path);
    }

    public FileNotFoundException(String target_path, String message) : super(message) {
        this.target_path = (target_path != null) ? target_path : new String("");
    }

    public FileNotFoundException(char[] target_path, string message) : super(message) {
        this.target_path = new String(target_path);
    }
}

public class EndOfStreamException extends IOException {
    public EndOfStreamException() : super("Attempted to read past the end of the stream.") {}
    public EndOfStreamException(string message) : super(message) {}
    public EndOfStreamException(String message) : super(message) {}
    public EndOfStreamException(string message, Exception cause) : super(message, cause) {}
    public EndOfStreamException(String message, Exception cause) : super(message, cause) {}
}

public class DirectoryNotFoundException extends IOException {
    public String target_path;

    public DirectoryNotFoundException() : super("Directory not found.") {
        this.target_path = new String("");
