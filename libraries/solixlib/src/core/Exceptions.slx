public class ProcessException extends Exception {
    public int32 process_exit_code;

    public ProcessException() : super("Process operation failed.") {
        this.process_exit_code = -1;
    }

    public ProcessException(string message) : super(message) {
        this.process_exit_code = -1;
    }

    public ProcessException(String message) : super(message) {
        this.process_exit_code = -1;
    }

    public ProcessException(string message, int32 process_exit_code) : super(message) {
        this.process_exit_code = process_exit_code;
    }

    public ProcessException(String message, int32 process_exit_code) : super(message) {
        this.process_exit_code = process_exit_code;
    }
}

