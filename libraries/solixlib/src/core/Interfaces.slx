package solix.core;

/// Interface for objects that can be converted to a String representation.
public interface IStringable {
    String to_string();
}

/// Interface for objects that can compute a 32-bit hash code.
public interface IHashable {
    int32 hash_code();
}

/// Interface for generic equivalence comparisons.
public interface IEquatable<T> {
    bool equals(T other);
}

/// Interface for generic order comparisons.
public interface IComparable<T> {
    int32 compare_to(T other);
}

/// Interface for generic deep or shallow cloning.
public interface ICloneable<T> {
    T clone();
}
