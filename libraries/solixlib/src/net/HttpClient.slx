package solix.net;

import solix.core.String;

public class HttpClient {
    public static String get(string url) {
        String wrapped = (url != null) ? new String(url) : new String("");
        return HttpClient::get(wrapped);
    }

    public static String get(String url) {
        if (url == null || url.data == null) {
            throw new NetworkException("[E0333] Network operation failed on socket: null url");
        }
        String clean_url = url;
        if (clean_url.starts_with("http://")) {
            clean_url = clean_url.substring(7, clean_url.length() - 7);
        }
        int32 slash_pos = clean_url.index_of('/');
        String host_port = (slash_pos > 0) ? clean_url.substring(0, slash_pos) : clean_url;
        String path = (slash_pos > 0) ? clean_url.substring(slash_pos, clean_url.length() - slash_pos) : new String("/");

        if (!host_port.contains(":")) {
            host_port = new String(host_port.data + ":80");
        }

        TcpStream stream = TcpStream::connect(host_port);
        String request = new String("GET " + path.data + " HTTP/1.1\r\nHost: " + host_port.data + "\r\nConnection: close\r\n\r\n");
        stream.write_string(request);
        String response = stream.read_string(65536);
        stream.close();
        return response;
    }
}
