package solix.collections;

import solix.core.IEquatable;
import solix.core.IStringable;
import solix.core.String;
import solix.core.StringBuilder;

public class Collections {
    public static bool are_equal<T>(T first_item, T second_item) {
        if (first_item == second_item) {
            return true;
        }
        if (first_item == null || second_item == null) {
            return false;
        }
        if (first_item instanceof String && second_item instanceof String) {
            return ((String)first_item).equals((String)second_item);
        }
        if (first_item instanceof IEquatable) {
            return ((IEquatable<T>)first_item).equals(second_item);
        }
        return false;
    }

    public static String to_string<T>(IIterable<T> collection) {
        if (collection == null) {
            return new String("null");
        }
        StringBuilder builder = new StringBuilder();
        builder.append_char('[');
        IIterator<T> iterator = collection.iterator();
        bool is_first = true;
        while (iterator != null && iterator.has_next()) {
            if (!is_first) {
                builder.append_char(',');
                builder.append_char(' ');
            }
            T item = iterator.next();
            if (item == null) {
                builder.append("null");
            } else {
                builder.append(String::from_any<T>(item));
            }
            is_first = false;
        }
        builder.append_char(']');
        return builder.to_string();
    }
}
