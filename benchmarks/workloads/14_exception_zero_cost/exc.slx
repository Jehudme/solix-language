native void println(string msg);

class MyException {
    public int32 code;

    public MyException(int32 code) {
        this.code = code;
    }
}

class ExceptionApp {
    public static void main() {
        int32 caught_count = 0;
        int32 normal_sum = 0;

        for (int32 i = 0; i < 250000; i = i + 1) {
            try {
                normal_sum = (normal_sum + (i % 10)) & 0x7FFFFFFF;
            } catch (MyException ex) {
                caught_count = caught_count + 1;
            }
        }

        for (int32 i = 0; i < 2500; i = i + 1) {
            try {
                throw new MyException(i);
            } catch (MyException ex) {
                caught_count = caught_count + ex.code;
            }
        }

        int32 checksum = (normal_sum + caught_count) & 0x7FFFFFFF;
        if (checksum == 4248750) {
            println("RESULT: 4248750");
        } else {
            println("FAIL");
        }
    }
}
