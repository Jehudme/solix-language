native void println(string msg);

interface IWorker {
    int32 work(int32 x);
}

class WorkerA implements IWorker {
    public int32 work(int32 x) {
        return x + 5;
    }
}

class WorkerB implements IWorker {
    public int32 work(int32 x) {
        return x * 3;
    }
}

class IDispatchApp {
    public static void main() {
        IWorker wa = new WorkerA();
        IWorker wb = new WorkerB();

        int32 total = 0;
        IWorker w = wa;
        for (int32 i = 0; i < 400000; i = i + 1) {
            if (i % 2 == 0) {
                w = wa;
            } else {
                w = wb;
            }
            total = (total + w.work(i % 10)) & 0x7FFFFFFF;
        }

        if (total == 4800000) {
            println("RESULT: 4800000");
        } else {
            println("FAIL");
        }
    }
}
