native void println(string msg);

class FibApp {
    public static int32 fib(int32 n) {
        if (n <= 1) {
            return n;
        }
        return FibApp::fib(n - 1) + FibApp::fib(n - 2);
    }

    public static void main() {
        int32 result = FibApp::fib(32);
        if (result == 2178309) {
            println("RESULT: 2178309");
        } else {
            println("FAIL");
        }
    }
}
