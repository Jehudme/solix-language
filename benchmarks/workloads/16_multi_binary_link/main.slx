import blt.io.println;
import math.calc.Calculator;

class MultiApp {
    public static void main() {
        int32 total = 0;
        for (int32 i = 0; i < 50000; i = i + 1) {
            total = (total + Calculator::compute(i % 100, i % 50)) & 0x7FFFFFFF;
        }

        if (total == 16000000) {
            println("RESULT: 16000000");
        } else {
            println("FAIL");
        }
    }
}
