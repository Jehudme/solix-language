import math.calc.Calculator;

native void println(string msg);

class MultiApp {
    public static void main() {
        int32 total = 0;
        for (int32 i = 0; i < 300000; i = i + 1) {
            total = (total + Calculator::compute(i % 100, i % 50)) & 0x7FFFFFFF;
        }

        if (total == 96000000) {
            println("RESULT: 96000000");
        } else {
            println("FAIL");
        }
    }
}
