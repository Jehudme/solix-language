native void println(string msg);

class Point {
    public int32 x;
    public int32 y;

    public Point(int32 x, int32 y) {
        this.x = x;
        this.y = y;
    }
}

class ChurnApp {
    public static void main() {
        int32 total = 0;
        for (int32 i = 0; i < 300000; i = i + 1) {
            Point p = new Point(i, i * 2);
            total = (total + p.x + p.y) & 0x7FFFFFFF;
        }

        if (total == 1855563824) {
            println("RESULT: 1855563824");
        } else {
            println("FAIL");
        }
    }
}
