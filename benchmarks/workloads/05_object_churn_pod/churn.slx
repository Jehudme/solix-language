import blt.io.println;

class Point {
    public int32 x;
    public int32 y;

    public Point(int32 x, int32 y) {
        this.x = x;
        this.y = y;
    }
}

class ChurnApp {
    public static void main() {
        int32 total = 0;
        for (int32 i = 0; i < 50000; i = i + 1) {
            Point p = new Point(i, i * 2);
            total = (total + p.x + p.y) & 0x7FFFFFFF;
        }

        if (total == 1602441352) {
            println("RESULT: 1602441352");
        } else {
            println("FAIL");
        }
    }
}
