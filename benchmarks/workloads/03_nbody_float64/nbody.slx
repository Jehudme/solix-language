native void println(string msg);

class NBodyApp {
    public static void main() {
        float64 x = 0.5;
        float64 y = 1.2;
        float64 vx = 0.01;
        float64 vy = 0.02;

        for (int32 i = 0; i < 250000; i = i + 1) {
            float64 dist_sq = x * x + y * y + 0.1;
            float64 force = 1.0 / dist_sq;
            vx = vx + force * 0.001;
            vy = vy + force * 0.001;
            x = x + vx;
            y = y + vy;
        }

        int32 energy = (int32)(x * 100.0) + (int32)(y * 100.0);
        if (energy == 1792020) {
            println("RESULT: 1792020");
        } else {
            println("FAIL");
        }
    }
}
