native void println(string msg);

class AckermannApp {
    public static int32 ack(int32 m, int32 n) {
        if (m == 0) {
            return n + 1;
        }
        if (n == 0) {
            return AckermannApp::ack(m - 1, 1);
        }
        return AckermannApp::ack(m - 1, AckermannApp::ack(m, n - 1));
    }

    public static void main() {
        int32 total = 0;
        for (int32 rep = 0; rep < 15; rep = rep + 1) {
            total = (total + AckermannApp::ack(3, 6)) & 0x7FFFFFFF;
        }
        if (total == 7635) {
            println("RESULT: 7635");
        } else {
            println("FAIL");
        }
    }
}
