import raylib.*;

public class Star {
    public float32 pos_x;
    public float32 pos_y;
    public float32 speed;
    public float32 size;
    public Color color;

    public Star(float32 initial_x, float32 initial_y, float32 initial_speed, float32 initial_size, Color initial_color) {
        this.pos_x = initial_x;
        this.pos_y = initial_y;
        this.speed = initial_speed;
        this.size = initial_size;
        this.color = initial_color;
    }

    public void update(float32 max_height) {
        this.pos_y = this.pos_y + this.speed;
        if (this.pos_y > max_height) {
            this.pos_y = 0.0;
        }
    }

    public void draw() {
        Raylib::DrawRectangle(
            (int32)this.pos_x,
            (int32)this.pos_y,
            (int32)this.size,
            (int32)this.size,
            this.color
        );
    }
}

public class Starfield {
    public Star[] stars;
    public int32 star_count;

    public Starfield() {
        this.star_count = 75;
        this.stars = new Star[75];

        Color distant_tint = new Color(60, 80, 120, 140);
        Color mid_tint = new Color(130, 170, 240, 180);
        Color bright_tint = new Color(220, 240, 255, 230);
        Color cyan_accent = new Color(0, 229, 255, 200);

        // Pseudo-random deterministic placement across screen
        float32 seed_accumulator = 12345.0;
        for (int32 star_index = 0; star_index < this.star_count; star_index = star_index + 1) {
            seed_accumulator = ((seed_accumulator * 1103515245.0) + 12345.0) % 2147483647.0;
            float32 initial_x = (seed_accumulator % 780.0) + 10.0;

            seed_accumulator = ((seed_accumulator * 1103515245.0) + 12345.0) % 2147483647.0;
            float32 initial_y = seed_accumulator % 640.0;

            int32 layer_tier = star_index % 3;
            if (layer_tier == 0) {
                // Background slow layer
                this.stars[star_index] = new Star(initial_x, initial_y, 0.35, 1.0, distant_tint);
            } else if (layer_tier == 1) {
                // Midground speed layer
                this.stars[star_index] = new Star(initial_x, initial_y, 0.75, 1.5, mid_tint);
            } else {
                // Foreground fast sparkling layer
                Color chosen_color = bright_tint;
                if (star_index % 7 == 0) {
                    chosen_color = cyan_accent;
                }
                this.stars[star_index] = new Star(initial_x, initial_y, 1.40, 2.0, chosen_color);
            }
        }
    }

    public void update() {
        for (int32 star_index = 0; star_index < this.star_count; star_index = star_index + 1) {
            this.stars[star_index].update(650.0);
        }
    }

    public void draw() {
        for (int32 star_index = 0; star_index < this.star_count; star_index = star_index + 1) {
            this.stars[star_index].draw();
        }
    }
}
