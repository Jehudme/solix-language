import raylib.*;

public class UserInterface {
    public bool crt_scanlines_enabled;

    public UserInterface() {
        this.crt_scanlines_enabled = true;
    }

    public void draw_hud(int32 current_score, int32 high_score, int32 lives, int32 wave_number, bool is_muted) {
        // Arcade header row
        Color label_gray = new Color(140, 160, 200, 255);
        Color cyan_score = new Color(0, 229, 255, 255);
        Color gold_high = new Color(255, 214, 0, 255);

        DrawText("SCORE< 1 >", 45, 14, 18, label_gray);
        DrawText("" + current_score, 50, 34, 22, cyan_score);

        DrawText("HI-SCORE", 345, 14, 18, label_gray);
        DrawText("" + high_score, 360, 34, 22, gold_high);

        DrawText("WAVE", 690, 14, 18, label_gray);
        DrawText("" + wave_number, 705, 34, 22, Color::WHITE);

        // Arcade boundary green line
        Color laser_boundary = new Color(0, 230, 118, 120);
        DrawLine(20, 615, 780, 615, laser_boundary);

        // Bottom status row: Lives icons and Mute status
        DrawText("" + lives, 35, 624, 18, Color::WHITE);
        for (int32 life_icon_idx = 0; life_icon_idx < lives && life_icon_idx < 5; life_icon_idx = life_icon_idx + 1) {
            int32 icon_origin_x = 60 + (life_icon_idx * 30);
            Color icon_green = new Color(0, 230, 118, 255);
            DrawRectangle(icon_origin_x, 626, 18, 8, icon_green);
            DrawRectangle(icon_origin_x + 7, 622, 4, 5, icon_green);
        }

        if (is_muted) {
            Color muted_tint = new Color(255, 82, 82, 220);
            DrawText("[ AUDIO: MUTED (M) ]", 600, 624, 16, muted_tint);
        } else {
            Color sound_tint = new Color(140, 160, 200, 180);
            DrawText("[ AUDIO: ON (M) ]", 615, 624, 16, sound_tint);
        }
    }

    public void draw_crt_overlay() {
        if (!this.crt_scanlines_enabled) {
            return;
        }
        Color scanline_tint = new Color(0, 0, 0, 24);
        for (int32 line_y = 0; line_y < 650; line_y = line_y + 4) {
            DrawLine(0, line_y, 800, line_y, scanline_tint);
        }
    }

    public void render_title_screen(int32 high_score) {
        // Semi-transparent backdrop
        DrawRectangle(0, 0, 800, 650, new Color(10, 12, 20, 230));

        // Arcade Title
        Color neon_cyan = new Color(0, 229, 255, 255);
        Color neon_purple = new Color(224, 64, 251, 255);
        DrawText("SOLIX INVADERS", 220, 95, 46, neon_cyan);
        DrawText("CYBER ARCADE 1978 REBORN", 270, 150, 18, neon_purple);

        // Point values table
        Color card_bg = new Color(18, 22, 36, 255);
        Rectangle table_rect = new Rectangle(200.0, 195.0, 400.0, 240.0);
        DrawRectangleRounded(table_rect, 0.08, 6, card_bg);
        DrawRectangleRoundedLines(table_rect, 0.08, 6, neon_purple);

        DrawText("* SCORE ADVANCE TABLE *", 275, 215, 18, Color::WHITE);

        // Mothership row
        DrawRectangle(250, 258, 26, 8, new Color(255, 23, 68, 255));
        DrawText("= ?  MYSTERY", 310, 252, 20, new Color(255, 64, 129, 255));

        // Squid row
        DrawRectangle(252, 298, 20, 14, new Color(224, 64, 251, 255));
        DrawText("= 30 POINTS", 310, 294, 20, new Color(224, 64, 251, 255));

        // Crab row
        DrawRectangle(250, 340, 24, 12, new Color(0, 229, 255, 255));
        DrawText("= 20 POINTS", 310, 336, 20, new Color(0, 229, 255, 255));

        // Octopus row
        DrawRectangle(250, 382, 24, 12, new Color(255, 214, 0, 255));
        DrawText("= 10 POINTS", 310, 378, 20, new Color(255, 214, 0, 255));

        // Controls guidance
        Color green_prompt = new Color(0, 230, 118, 255);
        DrawText("[ SPACE ] or [ ENTER ] - Insert Coin & Play", 205, 465, 20, green_prompt);
        DrawText("Controls: [ LEFT / RIGHT / A / D ] Move   [ SPACE ] Fire", 160, 505, 18, Color::WHITE);
        DrawText("[ P ] Pause   [ M ] Mute Sound   [ C ] CRT Scanlines", 175, 535, 18, new Color(140, 160, 200, 255));

        if (high_score > 0) {
            DrawText("ALL-TIME HIGH SCORE: " + high_score, 275, 580, 18, new Color(255, 214, 0, 255));
        }
    }

    public void render_pause_screen() {
        DrawRectangle(0, 0, 800, 650, new Color(10, 12, 20, 200));

        Rectangle pause_card = new Rectangle(230.0, 200.0, 340.0, 220.0);
        Color card_bg = new Color(18, 22, 36, 255);
        DrawRectangleRounded(pause_card, 0.1, 6, card_bg);

        Color cyan_border = new Color(0, 229, 255, 255);
        DrawRectangleRoundedLines(pause_card, 0.1, 6, cyan_border);

        DrawText("GAME PAUSED", 285, 235, 34, cyan_border);
        DrawText("[ P / ESC ]  - Resume Mission", 270, 295, 18, Color::WHITE);
        DrawText("[ R ]        - Restart Wave", 270, 330, 18, Color::WHITE);
        DrawText("[ Q ]        - Return to Menu", 270, 365, 18, Color::WHITE);
    }

    public void render_game_over_screen(bool is_victory, int32 final_score, int32 high_score, int32 wave_num) {
        DrawRectangle(0, 0, 800, 650, new Color(10, 12, 20, 220));

        Rectangle modal_rect = new Rectangle(200.0, 150.0, 400.0, 340.0);
        Color card_bg = new Color(18, 22, 36, 255);
        DrawRectangleRounded(modal_rect, 0.1, 6, card_bg);

        Color theme_color = new Color(255, 23, 68, 255); // Crimson for Game Over
        if (is_victory) {
            theme_color = new Color(0, 230, 118, 255); // Green for Victory
        }
        DrawRectangleRoundedLines(modal_rect, 0.1, 6, theme_color);

        if (is_victory) {
            DrawText("WAVE DEFENDED!", 255, 185, 36, theme_color);
            DrawText("EARTH IS SAFE... FOR NOW", 270, 230, 18, Color::WHITE);
        } else {
            DrawText("GAME OVER", 285, 185, 42, theme_color);
            DrawText("EARTH HAS BEEN INVADED!", 265, 230, 18, Color::WHITE);
        }

        DrawText("FINAL SCORE: " + final_score, 290, 280, 22, Color::WHITE);

        if (final_score >= high_score && final_score > 0) {
            Color gold_glow = new Color(255, 214, 0, 255);
            DrawText("★ NEW HIGH SCORE RECORD! ★", 235, 315, 20, gold_glow);
        } else {
            Color gray_text = new Color(140, 160, 200, 255);
            DrawText("HIGH SCORE: " + high_score, 310, 315, 18, gray_text);
        }

        DrawText("WAVES SURVIVED: " + wave_num, 295, 350, 18, Color::WHITE);

        Color green_prompt = new Color(0, 230, 118, 255);
        DrawText("[ SPACE ] or [ R ] - Play Again", 260, 400, 18, green_prompt);
        DrawText("[ Q ]              - Return to Menu", 260, 435, 18, Color::WHITE);
    }
}
