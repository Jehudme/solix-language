import raylib.*;

public enum GameState {
    TITLE = 0,
    PLAYING = 1,
    PAUSED = 2,
    VICTORY = 3,
    GAME_OVER = 4
}

public class Brick {
    public float32 pos_x;
    public float32 pos_y;
    public float32 width;
    public float32 height;
    public int32 health;
    public int32 max_health;
    public Color color;
    public Color cracked_color;

    public Brick(
        float32 start_x,
        float32 start_y,
        float32 brick_w,
        float32 brick_h,
        int32 initial_health,
        Color base_color,
        Color damaged_color
    ) {
        this.pos_x = start_x;
        this.pos_y = start_y;
        this.width = brick_w;
        this.height = brick_h;
        this.health = initial_health;
        this.max_health = initial_health;
        this.color = base_color;
        this.cracked_color = damaged_color;
    }

    public Rectangle get_rect() {
        return new Rectangle(this.pos_x, this.pos_y, this.width, this.height);
    }

    public void draw(float32 offset_x, float32 offset_y) {
        if (this.health <= 0) {
            return;
        }
        Rectangle brick_rect = new Rectangle(
            this.pos_x + offset_x,
            this.pos_y + offset_y,
            this.width,
            this.height
        );
        Color active_color = this.color;
        if (this.health == 1 && this.max_health == 2) {
            active_color = this.cracked_color;
        }
        Raylib::DrawRectangleRounded(brick_rect, (float32)0.22, 4, active_color);
        Color highlight_line = new Color((uint8)255, (uint8)255, (uint8)255, (uint8)55);
        Raylib::DrawRectangleRoundedLines(brick_rect, (float32)0.22, 4, highlight_line);
    }
}

public class BreakoutGame {
    public int32 game_state;
    public int32 score;
    public int32 high_score;
    public int32 lives;
    public int32 combo;

    public float32 paddle_pos_x;
    public float32 paddle_pos_y;
    public float32 paddle_width;
    public float32 paddle_height;

    public float32 ball_pos_x;
    public float32 ball_pos_y;
    public float32 ball_speed_x;
    public float32 ball_speed_y;
    public float32 ball_radius;
    public bool ball_attached;

    public float32 screen_shake;
    public int32 frame_counter;

    public Brick[] bricks;
    public int32 active_brick_count;

    public BreakoutGame() {
        this.game_state = GameState::TITLE;
        this.score = 0;
        this.high_score = 0;
        this.lives = 3;
        this.combo = 0;

        this.paddle_pos_x = (float32)345.0;
        this.paddle_pos_y = (float32)545.0;
        this.paddle_width = (float32)110.0;
        this.paddle_height = (float32)16.0;

        this.ball_pos_x = (float32)400.0;
        this.ball_pos_y = (float32)530.0;
        this.ball_speed_x = (float32)0.0;
        this.ball_speed_y = (float32)0.0;
        this.ball_radius = (float32)7.0;
        this.ball_attached = true;

        this.screen_shake = (float32)0.0;
        this.frame_counter = 0;

        this.bricks = new Brick[50];
        this.active_brick_count = 50;

        this.init_bricks();
    }

    public void init_bricks() {
        float32 origin_x = (float32)47.0;
        float32 origin_y = (float32)90.0;
        float32 brick_w = (float32)68.0;
        float32 brick_h = (float32)22.0;
        float32 step_x = (float32)71.0;
        float32 step_y = (float32)26.0;

        Color coral_base = new Color((uint8)255, (uint8)82, (uint8)82, (uint8)255);
        Color coral_dim = new Color((uint8)160, (uint8)50, (uint8)50, (uint8)255);
        Color orange_base = new Color((uint8)255, (uint8)145, (uint8)0, (uint8)255);
        Color gold_base = new Color((uint8)255, (uint8)215, (uint8)0, (uint8)255);
        Color emerald_base = new Color((uint8)0, (uint8)230, (uint8)118, (uint8)255);
        Color violet_base = new Color((uint8)187, (uint8)134, (uint8)252, (uint8)255);

        int32 brick_cursor = 0;
        for (int32 row_index = 0; row_index < 5; row_index = row_index + 1) {
            int32 brick_hp = 1;
            Color primary_color = orange_base;
            Color cracked_color = orange_base;

            if (row_index == 0) {
                brick_hp = 2;
                primary_color = coral_base;
                cracked_color = coral_dim;
            } else if (row_index == 1) {
                brick_hp = 1;
                primary_color = orange_base;
                cracked_color = orange_base;
            } else if (row_index == 2) {
                brick_hp = 1;
                primary_color = gold_base;
                cracked_color = gold_base;
            } else if (row_index == 3) {
                brick_hp = 1;
                primary_color = emerald_base;
                cracked_color = emerald_base;
            } else if (row_index == 4) {
                brick_hp = 1;
                primary_color = violet_base;
                cracked_color = violet_base;
            }

            for (int32 col_index = 0; col_index < 10; col_index = col_index + 1) {
                float32 calculated_x = origin_x + (float32)col_index * step_x;
                float32 calculated_y = origin_y + (float32)row_index * step_y;
                this.bricks[brick_cursor] = new Brick(
                    calculated_x,
                    calculated_y,
                    brick_w,
                    brick_h,
                    brick_hp,
                    primary_color,
                    cracked_color
                );
                brick_cursor = brick_cursor + 1;
            }
        }
        this.active_brick_count = 50;
    }

    public void reset_match() {
        this.score = 0;
        this.lives = 3;
        this.combo = 0;
        this.paddle_pos_x = (float32)345.0;
        this.ball_attached = true;
        this.ball_speed_x = (float32)0.0;
        this.ball_speed_y = (float32)0.0;
        this.screen_shake = (float32)0.0;
        this.init_bricks();
    }

    public void update_playing() {
        float32 delta_seconds = Raylib::GetFrameTime();
        if (delta_seconds > (float32)0.05) {
            delta_seconds = (float32)0.05;
        }

        // Toggle pause
        if (Raylib::IsKeyPressed(KeyboardKey::KEY_P) || Raylib::IsKeyPressed(KeyboardKey::KEY_ESCAPE)) {
            this.game_state = GameState::PAUSED;
            return;
        }

        // Paddle controls
        float32 paddle_speed = (float32)520.0;
        float32 movement_step = paddle_speed * delta_seconds;

        if (Raylib::IsKeyDown(KeyboardKey::KEY_LEFT) || Raylib::IsKeyDown(KeyboardKey::KEY_A)) {
            this.paddle_pos_x = this.paddle_pos_x - movement_step;
        }
        if (Raylib::IsKeyDown(KeyboardKey::KEY_RIGHT) || Raylib::IsKeyDown(KeyboardKey::KEY_D)) {
            this.paddle_pos_x = this.paddle_pos_x + movement_step;
        }

        // Clamp paddle inside arena
        float32 clamp_min_x = (float32)24.0;
        float32 clamp_max_x = (float32)776.0 - this.paddle_width;
        if (this.paddle_pos_x < clamp_min_x) {
            this.paddle_pos_x = clamp_min_x;
        }
        if (this.paddle_pos_x > clamp_max_x) {
            this.paddle_pos_x = clamp_max_x;
        }

        // Ball launch / movement
        if (this.ball_attached) {
            this.ball_pos_x = this.paddle_pos_x + this.paddle_width * (float32)0.5;
            this.ball_pos_y = this.paddle_pos_y - this.ball_radius - (float32)2.0;

            if (Raylib::IsKeyPressed(KeyboardKey::KEY_SPACE) || Raylib::IsKeyPressed(KeyboardKey::KEY_ENTER)) {
                this.ball_attached = false;
                this.ball_speed_x = (float32)180.0;
                this.ball_speed_y = (float32)-360.0;
            }
        } else {
            this.ball_pos_x = this.ball_pos_x + this.ball_speed_x * delta_seconds;
            this.ball_pos_y = this.ball_pos_y + this.ball_speed_y * delta_seconds;
        }

        // Left wall bounce
        if (this.ball_pos_x - this.ball_radius <= (float32)24.0) {
            this.ball_pos_x = (float32)24.0 + this.ball_radius;
            this.ball_speed_x = (float32)0.0 - this.ball_speed_x;
            this.screen_shake = (float32)3.0;
        }
        // Right wall bounce
        if (this.ball_pos_x + this.ball_radius >= (float32)776.0) {
            this.ball_pos_x = (float32)776.0 - this.ball_radius;
            this.ball_speed_x = (float32)0.0 - this.ball_speed_x;
            this.screen_shake = (float32)3.0;
        }
        // Ceiling bounce
        if (this.ball_pos_y - this.ball_radius <= (float32)64.0) {
            this.ball_pos_y = (float32)64.0 + this.ball_radius;
            this.ball_speed_y = (float32)0.0 - this.ball_speed_y;
            this.screen_shake = (float32)3.0;
        }
        // Bottom pit loss
        if (this.ball_pos_y - this.ball_radius >= (float32)600.0) {
            this.lives = this.lives - 1;
            this.combo = 0;
            this.screen_shake = (float32)10.0;
            if (this.lives <= 0) {
                this.game_state = GameState::GAME_OVER;
                if (this.score > this.high_score) {
                    this.high_score = this.score;
                }
            } else {
                this.ball_attached = true;
            }
        }

        // Paddle bounce with deflection
        if (!this.ball_attached && this.ball_speed_y > (float32)0.0) {
            Rectangle paddle_rect = new Rectangle(
                this.paddle_pos_x,
                this.paddle_pos_y,
                this.paddle_width,
                this.paddle_height
            );
            Vector2 ball_origin = new Vector2(this.ball_pos_x, this.ball_pos_y);
            if (Raylib::CheckCollisionCircleRec(ball_origin, this.ball_radius, paddle_rect)) {
                this.ball_pos_y = this.paddle_pos_y - this.ball_radius;
                this.combo = 0;

                float32 paddle_center_x = this.paddle_pos_x + this.paddle_width * (float32)0.5;
                float32 hit_factor = (this.ball_pos_x - paddle_center_x) / (this.paddle_width * (float32)0.5);
                if (hit_factor < (float32)-0.9) {
                    hit_factor = (float32)-0.9;
                }
                if (hit_factor > (float32)0.9) {
                    hit_factor = (float32)0.9;
                }

                this.ball_speed_x = hit_factor * (float32)450.0;
                this.ball_speed_y = (float32)-380.0;
                this.screen_shake = (float32)4.0;
            }
        }

        // Brick collision checks
        if (!this.ball_attached) {
            Vector2 ball_center_point = new Vector2(this.ball_pos_x, this.ball_pos_y);
            bool collision_handled = false;

            for (int32 brick_index = 0; brick_index < 50; brick_index = brick_index + 1) {
                if (!collision_handled) {
                    Brick target_brick = this.bricks[brick_index];
                    if (target_brick.health > 0) {
                        Rectangle target_box = target_brick.get_rect();
                        if (Raylib::CheckCollisionCircleRec(ball_center_point, this.ball_radius, target_box)) {
                            collision_handled = true;
                            target_brick.health = target_brick.health - 1;

                            if (target_brick.health <= 0) {
                                this.active_brick_count = this.active_brick_count - 1;
                                this.combo = this.combo + 1;
                                this.score = this.score + 100 * this.combo;
                                this.screen_shake = (float32)7.0;
                            } else {
                                this.score = this.score + 50;
                                this.screen_shake = (float32)4.0;
                            }

                            if (this.score > this.high_score) {
                                this.high_score = this.score;
                            }

                            // Deflect ball
                            float32 brick_edge_top = target_brick.pos_y;
                            float32 brick_edge_bottom = target_brick.pos_y + target_brick.height;
                            if (this.ball_pos_y < brick_edge_top || this.ball_pos_y > brick_edge_bottom) {
                                this.ball_speed_y = (float32)0.0 - this.ball_speed_y;
                            } else {
                                this.ball_speed_x = (float32)0.0 - this.ball_speed_x;
                            }

                            if (this.active_brick_count <= 0) {
                                this.game_state = GameState::VICTORY;
                                if (this.score > this.high_score) {
                                    this.high_score = this.score;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    public void draw_game_board(float32 offset_x, float32 offset_y) {
        // Subtle arena boundary frame
        Color arena_border_color = new Color((uint8)28, (uint8)32, (uint8)48, (uint8)255);
        Raylib::DrawRectangleLines(
            (int32)((float32)20.0 + offset_x),
            (int32)((float32)60.0 + offset_y),
            760,
            520,
            arena_border_color
        );

        // Draw active bricks
        for (int32 draw_index = 0; draw_index < 50; draw_index = draw_index + 1) {
            this.bricks[draw_index].draw(offset_x, offset_y);
        }

        // Draw player paddle
        Rectangle paddle_visual = new Rectangle(
            this.paddle_pos_x + offset_x,
            this.paddle_pos_y + offset_y,
            this.paddle_width,
            this.paddle_height
        );
        Color paddle_cyan = new Color((uint8)0, (uint8)229, (uint8)255, (uint8)255);
        Raylib::DrawRectangleRounded(paddle_visual, (float32)0.5, 6, paddle_cyan);
        Color paddle_glow = new Color((uint8)0, (uint8)229, (uint8)255, (uint8)80);
        Raylib::DrawRectangleRoundedLines(paddle_visual, (float32)0.5, 6, paddle_glow);

        // Draw glowing ball
        Vector2 ball_center = new Vector2(
            this.ball_pos_x + offset_x,
            this.ball_pos_y + offset_y
        );
        Color ball_aura = new Color((uint8)0, (uint8)229, (uint8)255, (uint8)60);
        Raylib::DrawCircleV(ball_center, this.ball_radius + (float32)6.0, ball_aura);
        Color ball_mid = new Color((uint8)0, (uint8)229, (uint8)255, (uint8)160);
        Raylib::DrawCircleV(ball_center, this.ball_radius + (float32)2.0, ball_mid);
        Color ball_core = new Color((uint8)255, (uint8)255, (uint8)255, (uint8)255);
        Raylib::DrawCircleV(ball_center, this.ball_radius, ball_core);

        // Top HUD bar
        Color hud_background = new Color((uint8)28, (uint8)32, (uint8)48, (uint8)255);
        Raylib::DrawRectangle(0, 0, 800, 60, hud_background);
        Color hud_line = new Color((uint8)45, (uint8)52, (uint8)75, (uint8)255);
        Raylib::DrawRectangle(0, 58, 800, 2, hud_line);

        Color text_label_color = new Color((uint8)140, (uint8)150, (uint8)175, (uint8)255);
        Raylib::DrawText("SCORE", 35, 12, 12, text_label_color);
        Raylib::DrawText("" + this.score, 35, 28, 20, Color::RAYWHITE);

        Raylib::DrawText("HIGH SCORE", 200, 12, 12, text_label_color);
        Raylib::DrawText("" + this.high_score, 200, 28, 20, Color::RAYWHITE);

        if (this.combo > 1) {
            Color combo_gold = new Color((uint8)255, (uint8)215, (uint8)0, (uint8)255);
            Raylib::DrawText("COMBO x" + this.combo, 380, 22, 22, combo_gold);
        }

        Raylib::DrawText("LIVES", 570, 12, 12, text_label_color);
        for (int32 pill_index = 0; pill_index < 3; pill_index = pill_index + 1) {
            float32 pill_x = (float32)(570 + pill_index * 26);
            Rectangle life_pill = new Rectangle(pill_x, (float32)32.0, (float32)20.0, (float32)12.0);
            Color pill_fill = paddle_cyan;
            if (pill_index >= this.lives) {
                pill_fill = new Color((uint8)50, (uint8)55, (uint8)75, (uint8)255);
            }
            Raylib::DrawRectangleRounded(life_pill, (float32)0.5, 4, pill_fill);
        }

        Raylib::DrawFPS(720, 20);
    }

    public void render_title_modal() {
        Color modal_overlay = new Color((uint8)10, (uint8)12, (uint8)18, (uint8)210);
        Raylib::DrawRectangle(0, 0, 800, 600, modal_overlay);

        Rectangle card_frame = new Rectangle((float32)140.0, (float32)90.0, (float32)520.0, (float32)420.0);
        Color card_bg = new Color((uint8)18, (uint8)22, (uint8)34, (uint8)245);
        Raylib::DrawRectangleRounded(card_frame, (float32)0.08, 6, card_bg);
        Color card_border = new Color((uint8)0, (uint8)229, (uint8)255, (uint8)180);
        Raylib::DrawRectangleRoundedLines(card_frame, (float32)0.08, 6, card_border);

        Color title_cyan = new Color((uint8)0, (uint8)229, (uint8)255, (uint8)255);
        Raylib::DrawText("SOLIX BREAKOUT", 220, 130, 40, title_cyan);
        Color subtitle_gray = new Color((uint8)140, (uint8)150, (uint8)180, (uint8)255);
        Raylib::DrawText("Built with Solix & Raylib", 295, 185, 16, subtitle_gray);

        // Controls box
        Rectangle controls_box = new Rectangle((float32)180.0, (float32)225.0, (float32)440.0, (float32)135.0);
        Color box_bg = new Color((uint8)26, (uint8)32, (uint8)48, (uint8)255);
        Raylib::DrawRectangleRounded(controls_box, (float32)0.06, 4, box_bg);

        Raylib::DrawText("CONTROLS", 200, 235, 14, title_cyan);
        Raylib::DrawText("[ A / D ] or [ LEFT / RIGHT ]  Move Paddle", 200, 260, 16, Color::RAYWHITE);
        Raylib::DrawText("[ SPACE ] or [ ENTER ]         Launch / Start", 200, 288, 16, Color::RAYWHITE);
        Raylib::DrawText("[ P ] or [ ESC ]               Pause", 200, 316, 16, Color::RAYWHITE);

        if (this.high_score > 0) {
            Color gold_text = new Color((uint8)255, (uint8)215, (uint8)0, (uint8)255);
            Raylib::DrawText("SESSION HIGH SCORE: " + this.high_score, 265, 380, 18, gold_text);
        }

        Raylib::DrawText("PRESS [ SPACE ] OR [ ENTER ] TO PLAY", 205, 435, 20, title_cyan);
    }

    public void render_paused_modal() {
        Color modal_overlay = new Color((uint8)10, (uint8)12, (uint8)18, (uint8)190);
        Raylib::DrawRectangle(0, 0, 800, 600, modal_overlay);

        Rectangle pause_card = new Rectangle((float32)200.0, (float32)160.0, (float32)400.0, (float32)270.0);
        Color card_bg = new Color((uint8)18, (uint8)22, (uint8)34, (uint8)245);
        Raylib::DrawRectangleRounded(pause_card, (float32)0.1, 6, card_bg);
        Color card_border = new Color((uint8)0, (uint8)229, (uint8)255, (uint8)180);
        Raylib::DrawRectangleRoundedLines(pause_card, (float32)0.1, 6, card_border);

        Color title_cyan = new Color((uint8)0, (uint8)229, (uint8)255, (uint8)255);
        Raylib::DrawText("GAME PAUSED", 285, 200, 34, title_cyan);

        Raylib::DrawText("[ P ] or [ ENTER ] - Resume Game", 255, 265, 18, Color::RAYWHITE);
        Raylib::DrawText("[ R ]              - Restart Match", 255, 305, 18, Color::RAYWHITE);
        Raylib::DrawText("[ Q ]              - Quit to Main Menu", 255, 345, 18, Color::RAYWHITE);
    }

    public void render_end_modal() {
        Color modal_overlay = new Color((uint8)10, (uint8)12, (uint8)18, (uint8)210);
        Raylib::DrawRectangle(0, 0, 800, 600, modal_overlay);

        Rectangle end_card = new Rectangle((float32)180.0, (float32)120.0, (float32)440.0, (float32)360.0);
        Color card_bg = new Color((uint8)18, (uint8)22, (uint8)34, (uint8)245);
        Raylib::DrawRectangleRounded(end_card, (float32)0.1, 6, card_bg);

        bool is_victory = (this.game_state == GameState::VICTORY);
        Color header_color = new Color((uint8)255, (uint8)82, (uint8)82, (uint8)255);
        if (is_victory) {
            header_color = new Color((uint8)0, (uint8)230, (uint8)118, (uint8)255);
        }
        Raylib::DrawRectangleRoundedLines(end_card, (float32)0.1, 6, header_color);

        if (is_victory) {
            Raylib::DrawText("VICTORY!", 310, 155, 42, header_color);
            Raylib::DrawText("ALL BRICKS CLEARED!", 305, 205, 18, Color::RAYWHITE);
        } else {
            Raylib::DrawText("GAME OVER", 280, 155, 42, header_color);
            Raylib::DrawText("OUT OF LIVES!", 340, 205, 18, Color::RAYWHITE);
        }

        Raylib::DrawText("FINAL SCORE: " + this.score, 300, 250, 22, Color::RAYWHITE);

        if (this.score >= this.high_score && this.score > 0) {
            Color gold_text = new Color((uint8)255, (uint8)215, (uint8)0, (uint8)255);
            Raylib::DrawText("★ NEW HIGH SCORE! ★", 285, 285, 20, gold_text);
        } else {
            Color gray_text = new Color((uint8)140, (uint8)150, (uint8)180, (uint8)255);
            Raylib::DrawText("HIGH SCORE: " + this.high_score, 320, 285, 18, gray_text);
        }

        int32 cleared_count = 50 - this.active_brick_count;
        Raylib::DrawText("BRICKS CLEARED: " + cleared_count + " / 50", 295, 320, 18, Color::RAYWHITE);

        Color cyan_prompt = new Color((uint8)0, (uint8)229, (uint8)255, (uint8)255);
        Raylib::DrawText("[ SPACE ] or [ R ] - Play Again", 265, 375, 18, cyan_prompt);
        Raylib::DrawText("[ Q ]              - Return to Menu", 265, 410, 18, Color::RAYWHITE);
    }

    public static int32 main() {
        Raylib::InitWindow(800, 600, "Solix Breakout - Modern Neon Arcade");
        Raylib::SetTargetFPS(60);
        Raylib::SetExitKey(0);

        BreakoutGame game = new BreakoutGame();

        while (!Raylib::WindowShouldClose()) {
            // Update state
            if (game.game_state == GameState::TITLE) {
                if (Raylib::IsKeyPressed(KeyboardKey::KEY_SPACE) || Raylib::IsKeyPressed(KeyboardKey::KEY_ENTER)) {
                    game.reset_match();
                    game.game_state = GameState::PLAYING;
                }
            } else if (game.game_state == GameState::PLAYING) {
                game.update_playing();
            } else if (game.game_state == GameState::PAUSED) {
                if (Raylib::IsKeyPressed(KeyboardKey::KEY_P) || Raylib::IsKeyPressed(KeyboardKey::KEY_ENTER) || Raylib::IsKeyPressed(KeyboardKey::KEY_ESCAPE)) {
                    game.game_state = GameState::PLAYING;
                } else if (Raylib::IsKeyPressed(KeyboardKey::KEY_R)) {
                    game.reset_match();
                    game.game_state = GameState::PLAYING;
                } else if (Raylib::IsKeyPressed(KeyboardKey::KEY_Q)) {
                    game.game_state = GameState::TITLE;
                }
            } else if (game.game_state == GameState::VICTORY || game.game_state == GameState::GAME_OVER) {
                if (Raylib::IsKeyPressed(KeyboardKey::KEY_SPACE) || Raylib::IsKeyPressed(KeyboardKey::KEY_R)) {
                    game.reset_match();
                    game.game_state = GameState::PLAYING;
                } else if (Raylib::IsKeyPressed(KeyboardKey::KEY_Q)) {
                    game.game_state = GameState::TITLE;
                }
            }

            // Decay screen shake
            if (game.screen_shake > (float32)0.1) {
                game.screen_shake = game.screen_shake * (float32)0.88;
            } else {
                game.screen_shake = (float32)0.0;
            }
            game.frame_counter = game.frame_counter + 1;

            float32 shake_x = (float32)0.0;
            float32 shake_y = (float32)0.0;
            if (game.screen_shake > (float32)0.0) {
                if (game.frame_counter % 2 == 0) {
                    shake_x = game.screen_shake;
                } else {
                    shake_x = (float32)0.0 - game.screen_shake;
                }
                if (game.frame_counter % 4 < 2) {
                    shake_y = game.screen_shake * (float32)0.5;
                } else {
                    shake_y = (float32)0.0 - (game.screen_shake * (float32)0.5);
                }
            }

            // Render
            Raylib::BeginDrawing();
            Color bg_slate = new Color((uint8)18, (uint8)20, (uint8)30, (uint8)255);
            Raylib::ClearBackground(bg_slate);

            game.draw_game_board(shake_x, shake_y);

            if (game.game_state == GameState::TITLE) {
                game.render_title_modal();
            } else if (game.game_state == GameState::PAUSED) {
                game.render_paused_modal();
            } else if (game.game_state == GameState::VICTORY || game.game_state == GameState::GAME_OVER) {
                game.render_end_modal();
            }

            Raylib::EndDrawing();
        }

        Raylib::CloseWindow();
        return 0;
    }
}
