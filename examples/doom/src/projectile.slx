package doom;

import raylib.*;

public class DoomParticle {
    public float32 pos_x;
    public float32 pos_y;
    public float32 pos_z;
    public float32 velocity_x;
    public float32 velocity_y;
    public float32 velocity_z;
    public float32 life_remaining;
    public float32 max_life;
    public float32 particle_size;
    public Color particle_color;
    public bool is_active;

    public DoomParticle() {
        this.pos_x = 0.0;
        this.pos_y = 0.0;
        this.pos_z = 0.0;
        this.velocity_x = 0.0;
        this.velocity_y = 0.0;
        this.velocity_z = 0.0;
        this.life_remaining = 0.0;
        this.max_life = 1.0;
        this.particle_size = 0.1;
        this.particle_color = Color::WHITE;
        this.is_active = false;
    }

    public void spawn(
        float32 origin_x,
        float32 origin_y,
        float32 origin_z,
        float32 vel_x,
        float32 vel_y,
        float32 vel_z,
        float32 duration,
        float32 size_val,
        Color tint
    ) {
        this.pos_x = origin_x;
        this.pos_y = origin_y;
        this.pos_z = origin_z;
        this.velocity_x = vel_x;
        this.velocity_y = vel_y;
        this.velocity_z = vel_z;
        this.life_remaining = duration;
        this.max_life = duration;
        this.particle_size = size_val;
        this.particle_color = tint;
        this.is_active = true;
    }

    public void update() {
        if (!this.is_active) {
            return;
        }
        this.pos_x = this.pos_x + this.velocity_x;
        this.pos_y = this.pos_y + this.velocity_y;
        this.pos_z = this.pos_z + this.velocity_z;

        this.velocity_x = this.velocity_x * 0.94;
        this.velocity_y = this.velocity_y * 0.94;
        this.velocity_z = this.velocity_z * 0.94;

        this.life_remaining = this.life_remaining - 0.03;
        if (this.life_remaining <= 0.0) {
            this.is_active = false;
        }
    }

    public void draw() {
        if (!this.is_active) {
            return;
        }
        Vector3 render_pos = new Vector3(this.pos_x, this.pos_y, this.pos_z);
        Raylib::DrawCube(render_pos, this.particle_size, this.particle_size, this.particle_size, this.particle_color);
    }
}

public class DoomParticlePool {
    public DoomParticle[] particles;
    public int32 max_particles;
    public float32 pseudo_seed;

    public DoomParticlePool() {
        this.max_particles = 100;
        this.particles = new DoomParticle[100];
        this.pseudo_seed = 4321.0;

        for (int32 pool_index = 0; pool_index < this.max_particles; pool_index = pool_index + 1) {
            this.particles[pool_index] = new DoomParticle();
        }
    }

    public void spawn_burst(
        float32 center_x,
        float32 center_y,
        float32 center_z,
        Color tint,
        int32 count
    ) {
        int32 spawned_count = 0;
        for (int32 pool_index = 0; pool_index < this.max_particles; pool_index = pool_index + 1) {
            if (!this.particles[pool_index].is_active) {
                this.pseudo_seed = this.pseudo_seed + 17.0;
                float32 angle_pitch = (float32)(((int32)this.pseudo_seed % 100) - 50) * 0.012;
                float32 angle_yaw = (float32)(((int32)(this.pseudo_seed * 1.7) % 100) - 50) * 0.012;
                float32 speed_burst = 0.06 + (float32)(((int32)(this.pseudo_seed * 2.3) % 40)) * 0.003;

                this.particles[pool_index].spawn(
                    center_x,
                    center_y,
                    center_z,
                    angle_yaw * speed_burst,
                    (speed_burst * 0.5) + (angle_pitch * 0.04),
                    angle_pitch * speed_burst,
                    0.6,
                    0.12,
                    tint
                );
                spawned_count = spawned_count + 1;
                if (spawned_count >= count) {
                    return;
                }
            }
        }
    }

    public void update() {
        for (int32 pool_index = 0; pool_index < this.max_particles; pool_index = pool_index + 1) {
            this.particles[pool_index].update();
        }
    }

    public void draw() {
        for (int32 pool_index = 0; pool_index < this.max_particles; pool_index = pool_index + 1) {
            this.particles[pool_index].draw();
        }
    }
}

public class Projectile {
    public int32 projectile_kind;
    public float32 pos_x;
    public float32 pos_y;
    public float32 pos_z;
    public float32 velocity_x;
    public float32 velocity_y;
    public float32 velocity_z;
    public float32 damage_value;
    public float32 splash_radius;
    public bool is_active;
    public bool is_from_player;

    public Projectile() {
        this.projectile_kind = ProjectileKind::PLAYER_ROCKET;
        this.pos_x = 0.0;
        this.pos_y = 0.0;
        this.pos_z = 0.0;
        this.velocity_x = 0.0;
        this.velocity_y = 0.0;
        this.velocity_z = 0.0;
        this.damage_value = 0.0;
        this.splash_radius = 0.0;
        this.is_active = false;
        this.is_from_player = true;
    }

    public void spawn(
        int32 kind,
        float32 origin_x,
        float32 origin_y,
        float32 origin_z,
        float32 dir_x,
        float32 dir_y,
        float32 dir_z,
        float32 speed,
        float32 damage,
        float32 splash,
        bool from_player
    ) {
        this.projectile_kind = kind;
        this.pos_x = origin_x;
        this.pos_y = origin_y;
        this.pos_z = origin_z;
        this.velocity_x = dir_x * speed;
        this.velocity_y = dir_y * speed;
        this.velocity_z = dir_z * speed;
        this.damage_value = damage;
        this.splash_radius = splash;
        this.is_active = true;
        this.is_from_player = from_player;
    }

    public void launch(
        int32 kind,
        float32 origin_x,
        float32 origin_y,
        float32 origin_z,
        float32 dir_x,
        float32 dir_y,
        float32 dir_z,
        float32 speed,
        float32 damage,
        float32 splash,
        bool from_player
    ) {
        this.spawn(kind, origin_x, origin_y, origin_z, dir_x, dir_y, dir_z, speed, damage, splash, from_player);
    }

    public bool update(LevelMap map, DoomParticlePool particles, DoomAudioManager audio_manager) {
        if (!this.is_active) {
            return false;
        }

        this.pos_x = this.pos_x + this.velocity_x;
        this.pos_y = this.pos_y + this.velocity_y;
        this.pos_z = this.pos_z + this.velocity_z;

        // Check map boundary / wall collision
        if (map.test_wall_collision(this.pos_x, this.pos_z, 0.2) || this.pos_y <= 0.1 || this.pos_y >= 3.8) {
            this.explode(particles, audio_manager);
            return true;
        }
        return false;
    }

    public void explode(DoomParticlePool particles, DoomAudioManager audio_manager) {
        if (!this.is_active) {
            return;
        }
        this.is_active = false;
        if (this.projectile_kind == ProjectileKind::PLAYER_ROCKET) {
            audio_manager.play_sound(audio_manager.sound_rocket_explosion);
            particles.spawn_burst(this.pos_x, this.pos_y, this.pos_z, Color::ORANGE, 25);
            particles.spawn_burst(this.pos_x, this.pos_y, this.pos_z, Color::RED, 15);
        } else {
            particles.spawn_burst(this.pos_x, this.pos_y, this.pos_z, Color::YELLOW, 12);
        }
    }

    public void draw() {
        this.draw_with_camera(null, null);
    }

    public void draw_with_camera(Camera camera, DoomResources resources) {
        if (!this.is_active) {
            return;
        }
        Vector3 render_pos = new Vector3(this.pos_x, this.pos_y, this.pos_z);

        if (camera != null && resources != null && resources.is_loaded) {
            Texture2D projectile_tex = resources.tex_proj_fireball;
            if (this.projectile_kind == ProjectileKind::PLAYER_ROCKET) {
                projectile_tex = resources.tex_proj_rocket;
            }

            if (projectile_tex.id > 0) {
                float32 billboard_scale = (float32)((this.projectile_kind == ProjectileKind::PLAYER_ROCKET) ? 0.9 : 0.8);
                Raylib::DrawBillboard(camera, projectile_tex, render_pos, billboard_scale, Color::WHITE);
                return;
            }
        }

        if (this.projectile_kind == ProjectileKind::PLAYER_ROCKET) {
            Raylib::DrawSphere(render_pos, 0.18, Color::WHITE);
            Raylib::DrawSphereWires(render_pos, 0.22, 6, 6, Color::ORANGE);
        } else if (this.projectile_kind == ProjectileKind::IMP_FIREBALL) {
            Raylib::DrawSphere(render_pos, 0.16, Color::YELLOW);
            Raylib::DrawSphereWires(render_pos, 0.20, 5, 5, Color::RED);
        } else {
            Raylib::DrawSphere(render_pos, 0.22, Color::BLUE);
            Raylib::DrawSphereWires(render_pos, 0.26, 6, 6, Color::WHITE);
        }
    }
}
