        MapDataE1M1::populate_walls_chunk_12(level_map.walls);
        MapDataE1M1::populate_walls_chunk_13(level_map.walls);
        MapDataE1M1::populate_monsters(level_map.enemies);
        MapDataE1M1::populate_pickups(level_map.pickups);
    }

