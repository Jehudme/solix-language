package doom;

import raylib.*;

public class DoomAudio {
    public bool is_muted;

    public Sound sound_pistol;
    public Sound sound_shotgun;
    public Sound sound_rocket;
    public Sound sound_punch;
    public Sound sound_explosion;
    public Sound sound_door_open;
    public Sound sound_door_close;
    public Sound sound_switch;
    public Sound sound_item_pickup;
    public Sound sound_weapon_pickup;
    public Sound sound_player_oof;
    public Sound sound_player_pain;
    public Sound sound_player_death;
    public Sound sound_zombie_sight;
    public Sound sound_zombie_death;
    public Sound sound_imp_sight;
    public Sound sound_imp_death;
    public Sound sound_pinky_sight;
    public Sound sound_pinky_death;
    public Sound sound_pinky_attack;

    public bool is_loaded;

    public DoomAudio() {
        this.is_muted = false;
        this.is_loaded = false;
    }

    public void load() {
        string audio_prefix = "examples/doom/resources/audio/";
        this.sound_pistol = Raylib::LoadSound(audio_prefix + "dspistol.wav");
        this.sound_shotgun = Raylib::LoadSound(audio_prefix + "dsshotgn.wav");
        this.sound_rocket = Raylib::LoadSound(audio_prefix + "dsrlaunc.wav");
        this.sound_punch = Raylib::LoadSound(audio_prefix + "dspunch.wav");
        this.sound_explosion = Raylib::LoadSound(audio_prefix + "dsbarexp.wav");
        this.sound_door_open = Raylib::LoadSound(audio_prefix + "dsdoropn.wav");
        this.sound_door_close = Raylib::LoadSound(audio_prefix + "dsdorcls.wav");
        this.sound_switch = Raylib::LoadSound(audio_prefix + "dsswtchn.wav");
        this.sound_item_pickup = Raylib::LoadSound(audio_prefix + "dsitemup.wav");
        this.sound_weapon_pickup = Raylib::LoadSound(audio_prefix + "dswpnup.wav");
        this.sound_player_oof = Raylib::LoadSound(audio_prefix + "dsoof.wav");
        this.sound_player_pain = Raylib::LoadSound(audio_prefix + "dsplpain.wav");
        this.sound_player_death = Raylib::LoadSound(audio_prefix + "dspldeth.wav");
        this.sound_zombie_sight = Raylib::LoadSound(audio_prefix + "dsposit1.wav");
        this.sound_zombie_death = Raylib::LoadSound(audio_prefix + "dspodth1.wav");
        this.sound_imp_sight = Raylib::LoadSound(audio_prefix + "dsbgsit1.wav");
        this.sound_imp_death = Raylib::LoadSound(audio_prefix + "dsbgdth1.wav");
        this.sound_pinky_sight = Raylib::LoadSound(audio_prefix + "dssgtsit.wav");
        this.sound_pinky_death = Raylib::LoadSound(audio_prefix + "dssgtdth.wav");
        this.sound_pinky_attack = Raylib::LoadSound(audio_prefix + "dsclaw.wav");

        this.is_loaded = true;
    }

    public void play_sound(Sound sound_clip) {
        if (!this.is_muted && this.is_loaded) {
            Raylib::PlaySound(sound_clip);
        }
    }

    public void toggle_mute() {
        this.is_muted = !this.is_muted;
    }

    public void unload_all() {
        if (!this.is_loaded) {
            return;
        }

        Raylib::UnloadSound(this.sound_pistol);
        Raylib::UnloadSound(this.sound_shotgun);
        Raylib::UnloadSound(this.sound_rocket);
        Raylib::UnloadSound(this.sound_punch);
        Raylib::UnloadSound(this.sound_explosion);
        Raylib::UnloadSound(this.sound_door_open);
        Raylib::UnloadSound(this.sound_door_close);
        Raylib::UnloadSound(this.sound_switch);
        Raylib::UnloadSound(this.sound_item_pickup);
        Raylib::UnloadSound(this.sound_weapon_pickup);
        Raylib::UnloadSound(this.sound_player_oof);
        Raylib::UnloadSound(this.sound_player_pain);
        Raylib::UnloadSound(this.sound_player_death);
        Raylib::UnloadSound(this.sound_zombie_sight);
        Raylib::UnloadSound(this.sound_zombie_death);
        Raylib::UnloadSound(this.sound_imp_sight);
        Raylib::UnloadSound(this.sound_imp_death);
        Raylib::UnloadSound(this.sound_pinky_sight);
        Raylib::UnloadSound(this.sound_pinky_death);
        Raylib::UnloadSound(this.sound_pinky_attack);

        this.is_loaded = false;
    }
}
