    public static const int32 FIST = 0;
    public static const int32 PISTOL = 1;
    public static const int32 SHOTGUN = 2;
    public static const int32 CHAINGUN = 3;
    public static const int32 ROCKET_LAUNCHER = 4;
}

public class EnemyKind {
