package doom;

public class GameState {
    public static const int32 TITLE = 0;
    public static const int32 PLAYING = 1;
    public static const int32 PAUSED = 2;
    public static const int32 INTERMISSION = 3;
    public static const int32 GAME_OVER = 4;
    public static const int32 VICTORY = 5;
}

