    public static const int32 WEAPON_LAUNCHER = 9;
    public static const int32 BLUE_KEY = 10;
    public static const int32 RED_KEY = 11;
    public static const int32 YELLOW_KEY = 12;
}

public class ProjectileKind {
    public static const int32 PLAYER_ROCKET = 0;
    public static const int32 IMP_FIREBALL = 1;
    public static const int32 CACODEMON_BALL = 2;
}

public class DoomConstants {
