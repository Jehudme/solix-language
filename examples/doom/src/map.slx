package doom;

import raylib.*;

public class LevelMap {
    public WallSegment[] walls;
    public int32 wall_count;

    public EnemyMonster[] enemies;
    public int32 enemy_count;

    public PickupItem[] pickups;
    public int32 pickup_count;

    public float32 player_spawn_x;
    public float32 player_spawn_y;
    public float32 player_spawn_z;
    public float32 player_spawn_yaw;

    public LevelMap() {
        this.load_level(1);
    }

    public void load_level(int32 level_number) {
        MapDataE1M1::populate_level(this);
    }

    public void update(DoomAudio audio_manager) {
        for (int32 wall_index = 0; wall_index < this.wall_count; wall_index = wall_index + 1) {
            WallSegment wall = this.walls[wall_index];
            if (wall != null && wall.is_door) {
                wall.update_door(audio_manager);
            }
        }
    }

    public bool check_sphere_collision(float32 center_coord_x, float32 center_coord_z, float32 check_radius) {
        float32[] dummy_push_vector = new float32[2];
        for (int32 wall_index = 0; wall_index < this.wall_count; wall_index = wall_index + 1) {
            WallSegment wall = this.walls[wall_index];
            if (wall != null && (wall.is_solid || (wall.is_door && wall.door_state == 0))) {
                float32 penetration = DoomMath::test_wall_circle_collision(
                    wall.start_x,
                    wall.start_z,
                    wall.end_x,
                    wall.end_z,
                    center_coord_x,
                    center_coord_z,
                    check_radius,
                    dummy_push_vector
                );
                if (penetration > (float32)0.0) {
                    return true;
                }
            }
        }
        return false;
    }

    public void resolve_player_collision(
        DoomPlayer player,
        float32 target_pos_x,
        float32 target_pos_z,
        float32 player_radius
    ) {
        float32 current_x = target_pos_x;
        float32 current_z = target_pos_z;

        float32[] push_vector = new float32[2];

        // 3 collision resolution passes for seamless corner sliding
        for (int32 iteration = 0; iteration < 3; iteration = iteration + 1) {
            for (int32 wall_index = 0; wall_index < this.wall_count; wall_index = wall_index + 1) {
                WallSegment wall = this.walls[wall_index];
                if (wall != null && (wall.is_solid || (wall.is_door && wall.door_state == 0))) {
                    float32 penetration = DoomMath::test_wall_circle_collision(
                        wall.start_x,
                        wall.start_z,
                        wall.end_x,
                        wall.end_z,
                        current_x,
                        current_z,
                        player_radius,
                        push_vector
                    );
                    if (penetration > (float32)0.0) {
                        current_x = current_x + (push_vector[0] * penetration);
                        current_z = current_z + (push_vector[1] * penetration);
                    }
                }
            }
        }

        player.pos_x = current_x;
        player.pos_z = current_z;
    }

    public void check_pickup_collection(
        DoomPlayer player,
        WeaponManager weapons,
        DoomAudio audio_manager
    ) {
        for (int32 item_index = 0; item_index < this.pickup_count; item_index = item_index + 1) {
            PickupItem item = this.pickups[item_index];
            if (item != null && !item.is_collected) {
                float32 dist_to_item = DoomMath::distance_2d(player.pos_x, player.pos_z, item.pos_x, item.pos_z);
                if (dist_to_item < (float32)1.1) {
                    item.is_collected = true;
                    player.pickup_flash_timer = 12;

                    if (item.kind == PickupKind::SHOTGUN) {
                        weapons.has_shotgun = true;
                        weapons.ammo_shells = weapons.ammo_shells + 8;
                        weapons.select_weapon(WeaponKind::SHOTGUN);
                        audio_manager.play_sound(audio_manager.sound_weapon_pickup);
                    } else if (item.kind == PickupKind::CHAINGUN) {
                        weapons.has_chaingun = true;
                        weapons.ammo_bullets = weapons.ammo_bullets + 20;
                        weapons.select_weapon(WeaponKind::CHAINGUN);
                        audio_manager.play_sound(audio_manager.sound_weapon_pickup);
                    } else if (item.kind == PickupKind::AMMO_CLIP) {
                        weapons.ammo_bullets = weapons.ammo_bullets + 10;
                        audio_manager.play_sound(audio_manager.sound_item_pickup);
                    } else if (item.kind == PickupKind::AMMO_SHELLS) {
                        weapons.ammo_shells = weapons.ammo_shells + 4;
                        audio_manager.play_sound(audio_manager.sound_item_pickup);
                    } else if (item.kind == PickupKind::HEALTH_STIMPACK) {
                        player.health_val = player.health_val + (float32)10.0;
                        if (player.health_val > (float32)100.0) {
                            player.health_val = (float32)100.0;
                        }
                        audio_manager.play_sound(audio_manager.sound_item_pickup);
                    } else if (item.kind == PickupKind::HEALTH_MEDIKIT) {
                        player.health_val = player.health_val + (float32)25.0;
                        if (player.health_val > (float32)100.0) {
                            player.health_val = (float32)100.0;
                        }
                        audio_manager.play_sound(audio_manager.sound_item_pickup);
                    } else if (item.kind == PickupKind::GREEN_ARMOR) {
                        player.armor_val = (float32)100.0;
                        audio_manager.play_sound(audio_manager.sound_item_pickup);
                    } else if (item.kind == PickupKind::BLUE_KEY) {
                        player.has_blue_key = true;
                        audio_manager.play_sound(audio_manager.sound_item_pickup);
                    } else if (item.kind == PickupKind::RED_KEY) {
                        player.has_red_key = true;
                        audio_manager.play_sound(audio_manager.sound_item_pickup);
                    } else if (item.kind == PickupKind::YELLOW_KEY) {
                        player.has_yellow_key = true;
                        audio_manager.play_sound(audio_manager.sound_item_pickup);
                    }
                }
            }
        }
    }

    public bool test_door_interaction(
        float32 player_x,
        float32 player_z,
        bool has_blue,
        bool has_red,
        bool has_yellow,
        DoomAudio audio_manager
    ) {
        for (int32 wall_index = 0; wall_index < this.wall_count; wall_index = wall_index + 1) {
            WallSegment wall = this.walls[wall_index];
            if (wall != null && wall.is_door) {
                float32 dist_to_door = DoomMath::distance_2d(player_x, player_z, wall.center_pos_x, wall.center_pos_z);
                if (dist_to_door < (float32)2.5) {
                    return wall.try_open(has_blue, has_red, has_yellow, audio_manager);
                }
            }
        }
        return false;
    }

    public void draw_world(DoomResources resources) {
        if (resources == null || !resources.is_loaded) {
            return;
        }

        // 1. Draw large floor plane
        Vector3 floor_pos = new Vector3((float32)0.0, (float32)0.0, (float32)0.0);
        Vector3 floor_scale = new Vector3((float32)300.0, (float32)1.0, (float32)300.0);
        Vector3 rotation_axis = new Vector3((float32)0.0, (float32)1.0, (float32)0.0);
        Raylib::DrawModelEx(resources.model_floor_flat, floor_pos, rotation_axis, (float32)0.0, floor_scale, Color::WHITE);

        // 2. Draw all authentic wall segments
        for (int32 wall_index = 0; wall_index < this.wall_count; wall_index = wall_index + 1) {
            WallSegment wall = this.walls[wall_index];
            if (wall != null) {
                wall.draw_segment(resources);
            }
        }
    }
}
