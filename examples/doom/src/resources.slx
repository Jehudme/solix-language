package doom;

import raylib.*;

public class DoomResources {
    public bool is_loaded;

    // 3D Textured Models
    public Model model_wall_brown;
    public Model model_wall_tech;
    public Model model_wall_startan;
    public Model model_wall_step;
    public Model model_wall_exitsign;
    public Model model_wall_switch;
    public Model model_door_normal;
    public Model model_door_big;
    public Model model_door_blue;
    public Model model_door_red;
    public Model model_door_yellow;
    public Model model_level_floors;
    public Model model_level_ceilings;
    public Model model_floor_flat;
    public Model model_ceil_flat;
    public Model model_acid_flat;

    // Monster Billboard Textures
    public Texture2D tex_zombie_walk;
    public Texture2D tex_zombie_attack;
    public Texture2D tex_zombie_pain;
    public Texture2D tex_zombie_die;

    public Texture2D tex_imp_walk;
    public Texture2D tex_imp_attack;
    public Texture2D tex_imp_pain;
    public Texture2D tex_imp_die;

    public Texture2D tex_pinky_walk;
    public Texture2D tex_pinky_attack;
    public Texture2D tex_pinky_pain;
    public Texture2D tex_pinky_die;

    // Pickup & Prop Billboard Textures
    public Texture2D tex_pickup_shotgun;
    public Texture2D tex_pickup_chaingun;
    public Texture2D tex_pickup_chainsaw;
    public Texture2D tex_pickup_clip;
    public Texture2D tex_pickup_shells;
    public Texture2D tex_pickup_stimpack;
    public Texture2D tex_pickup_medikit;
    public Texture2D tex_pickup_armor_green;
    public Texture2D tex_pickup_key_blue;
    public Texture2D tex_pickup_key_red;
    public Texture2D tex_pickup_key_yellow;
    public Texture2D tex_barrel;

    // Projectile Textures
    public Texture2D tex_projectile_fireball;
    public Texture2D tex_projectile_rocket;

    // First-Person Weapon Overlays
    public Texture2D tex_fist_idle;
    public Texture2D tex_fist_punch;
    public Texture2D tex_pistol_idle;
    public Texture2D tex_pistol_fire;
    public Texture2D tex_shotgun_idle;
    public Texture2D tex_shotgun_fire;
    public Texture2D tex_shotgun_cock;
    public Texture2D tex_chaingun_idle;
    public Texture2D tex_chaingun_fire;
    public Texture2D tex_rocket_idle;
    public Texture2D tex_rocket_fire;

    // UI & Status Bar
    public Texture2D tex_stbar;
    public Texture2D[] tex_numbers_gold;
    public Texture2D[] tex_numbers_yellow;
    public Texture2D tex_face_normal;
    public Texture2D tex_face_look_left;
    public Texture2D tex_face_look_right;
    public Texture2D tex_face_evil;
    public Texture2D tex_face_ouch;
    public Texture2D tex_face_dead;

    public DoomResources() {
        this.is_loaded = false;
        this.tex_numbers_gold = new Texture2D[10];
        this.tex_numbers_yellow = new Texture2D[10];
    }

    public void load() {
        string models_dir = "examples/doom/resources/models/";
        this.model_wall_brown = Raylib::LoadModel(models_dir + "wall_brown.obj");
        this.model_wall_tech = Raylib::LoadModel(models_dir + "wall_tech.obj");
        this.model_wall_startan = Raylib::LoadModel(models_dir + "wall_startan.obj");
        this.model_wall_step = Raylib::LoadModel(models_dir + "wall_step.obj");
        this.model_wall_exitsign = Raylib::LoadModel(models_dir + "wall_exitsign.obj");
        this.model_wall_switch = Raylib::LoadModel(models_dir + "wall_switch.obj");
        this.model_door_normal = Raylib::LoadModel(models_dir + "door_normal.obj");
        this.model_door_big = Raylib::LoadModel(models_dir + "door_big.obj");
        this.model_door_blue = Raylib::LoadModel(models_dir + "door_blue.obj");
        this.model_door_red = Raylib::LoadModel(models_dir + "door_red.obj");
        this.model_door_yellow = Raylib::LoadModel(models_dir + "door_yellow.obj");
        this.model_level_floors = Raylib::LoadModel(models_dir + "level_floors.obj");
        this.model_level_ceilings = Raylib::LoadModel(models_dir + "level_ceilings.obj");
        this.model_floor_flat = Raylib::LoadModel(models_dir + "floor_flat.obj");
        this.model_ceil_flat = Raylib::LoadModel(models_dir + "ceil_flat.obj");
        this.model_acid_flat = Raylib::LoadModel(models_dir + "acid_flat.obj");

        string sprites_dir = "examples/doom/resources/sprites/";
        this.tex_zombie_walk = Raylib::LoadTexture(sprites_dir + "possa1.png");
        this.tex_zombie_attack = Raylib::LoadTexture(sprites_dir + "posse0.png");
        this.tex_zombie_pain = Raylib::LoadTexture(sprites_dir + "possh0.png");
        this.tex_zombie_die = Raylib::LoadTexture(sprites_dir + "possl0.png");

        this.tex_imp_walk = Raylib::LoadTexture(sprites_dir + "trooa1.png");
        this.tex_imp_attack = Raylib::LoadTexture(sprites_dir + "trooe0.png");
        this.tex_imp_pain = Raylib::LoadTexture(sprites_dir + "trooh0.png");
        this.tex_imp_die = Raylib::LoadTexture(sprites_dir + "troom0.png");

        this.tex_pinky_walk = Raylib::LoadTexture(sprites_dir + "sarga1.png");
        this.tex_pinky_attack = Raylib::LoadTexture(sprites_dir + "sarge0.png");
        this.tex_pinky_pain = Raylib::LoadTexture(sprites_dir + "sargi0.png");
        this.tex_pinky_die = Raylib::LoadTexture(sprites_dir + "sargn0.png");

        this.tex_pickup_shotgun = Raylib::LoadTexture(sprites_dir + "shotgun.png");
        this.tex_pickup_chaingun = Raylib::LoadTexture(sprites_dir + "mguna0.png");
        this.tex_pickup_chainsaw = Raylib::LoadTexture(sprites_dir + "csawa0.png");
        this.tex_pickup_clip = Raylib::LoadTexture(sprites_dir + "clpia0.png");
        this.tex_pickup_shells = Raylib::LoadTexture(sprites_dir + "shela0.png");
        this.tex_pickup_stimpack = Raylib::LoadTexture(sprites_dir + "stima0.png");
        this.tex_pickup_medikit = Raylib::LoadTexture(sprites_dir + "media0.png");
        this.tex_pickup_armor_green = Raylib::LoadTexture(sprites_dir + "arm1a0.png");
        this.tex_pickup_key_blue = Raylib::LoadTexture(sprites_dir + "bkeya0.png");
        this.tex_pickup_key_red = Raylib::LoadTexture(sprites_dir + "rkeya0.png");
        this.tex_pickup_key_yellow = Raylib::LoadTexture(sprites_dir + "ykeya0.png");
        this.tex_barrel = Raylib::LoadTexture(sprites_dir + "bar1a0.png");

        this.tex_projectile_fireball = Raylib::LoadTexture(sprites_dir + "bal1a0.png");
        this.tex_projectile_rocket = Raylib::LoadTexture(sprites_dir + "misla1.png");

        string weapons_dir = "examples/doom/resources/weapons/";
        this.tex_fist_idle = Raylib::LoadTexture(weapons_dir + "punga0.png");
        this.tex_fist_punch = Raylib::LoadTexture(weapons_dir + "pungb0.png");
        this.tex_pistol_idle = Raylib::LoadTexture(weapons_dir + "pisga0.png");
        this.tex_pistol_fire = Raylib::LoadTexture(weapons_dir + "pisgb0.png");
        this.tex_shotgun_idle = Raylib::LoadTexture(weapons_dir + "shtga0.png");
        this.tex_shotgun_fire = Raylib::LoadTexture(weapons_dir + "shtgb0.png");
        this.tex_shotgun_cock = Raylib::LoadTexture(weapons_dir + "shtgd0.png");
        this.tex_chaingun_idle = Raylib::LoadTexture(weapons_dir + "chgga0.png");
        this.tex_chaingun_fire = Raylib::LoadTexture(weapons_dir + "chggb0.png");
        this.tex_rocket_idle = Raylib::LoadTexture(weapons_dir + "misga0.png");
        this.tex_rocket_fire = Raylib::LoadTexture(weapons_dir + "misgb0.png");

        string hud_dir = "examples/doom/resources/hud/";
        this.tex_stbar = Raylib::LoadTexture(hud_dir + "stbar.png");

        for (int32 digit_index = 0; digit_index < 10; digit_index = digit_index + 1) {
            string digit_str = "" + digit_index;
            this.tex_numbers_gold[digit_index] = Raylib::LoadTexture(hud_dir + "sttnum" + digit_str + ".png");
            this.tex_numbers_yellow[digit_index] = Raylib::LoadTexture(hud_dir + "stysnum" + digit_str + ".png");
        }

        this.tex_face_normal = Raylib::LoadTexture(hud_dir + "stfst00.png");
        this.tex_face_look_left = Raylib::LoadTexture(hud_dir + "stfst01.png");
        this.tex_face_look_right = Raylib::LoadTexture(hud_dir + "stfst02.png");
        this.tex_face_evil = Raylib::LoadTexture(hud_dir + "stfevl0.png");
        this.tex_face_ouch = Raylib::LoadTexture(hud_dir + "stfouch0.png");
        this.tex_face_dead = Raylib::LoadTexture(hud_dir + "stfdead0.png");

        this.is_loaded = true;
    }

    public Model get_wall_model(int32 texture_id) {
        if (texture_id == 1) {
            return this.model_wall_tech;
        } else if (texture_id == 2) {
            return this.model_wall_startan;
        } else if (texture_id == 3) {
            return this.model_wall_step;
        } else if (texture_id == 4) {
            return this.model_wall_exitsign;
        } else if (texture_id == 5) {
            return this.model_wall_switch;
        } else if (texture_id == 6) {
            return this.model_door_normal;
        } else if (texture_id == 7) {
            return this.model_door_big;
        } else if (texture_id == 8) {
            return this.model_door_blue;
        } else if (texture_id == 9) {
            return this.model_door_red;
        } else if (texture_id == 10) {
            return this.model_door_yellow;
        }
        return this.model_wall_brown;
    }

    public void unload() {
        if (!this.is_loaded) {
            return;
        }

        Raylib::UnloadModel(this.model_wall_brown);
        Raylib::UnloadModel(this.model_wall_tech);
        Raylib::UnloadModel(this.model_wall_startan);
        Raylib::UnloadModel(this.model_wall_step);
        Raylib::UnloadModel(this.model_wall_exitsign);
        Raylib::UnloadModel(this.model_wall_switch);
        Raylib::UnloadModel(this.model_door_normal);
        Raylib::UnloadModel(this.model_door_big);
        Raylib::UnloadModel(this.model_door_blue);
        Raylib::UnloadModel(this.model_door_red);
        Raylib::UnloadModel(this.model_door_yellow);
        Raylib::UnloadModel(this.model_level_floors);
        Raylib::UnloadModel(this.model_level_ceilings);
        Raylib::UnloadModel(this.model_floor_flat);
        Raylib::UnloadModel(this.model_ceil_flat);
        Raylib::UnloadModel(this.model_acid_flat);

        Raylib::UnloadTexture(this.tex_zombie_walk);
        Raylib::UnloadTexture(this.tex_zombie_attack);
        Raylib::UnloadTexture(this.tex_zombie_pain);
        Raylib::UnloadTexture(this.tex_zombie_die);

        Raylib::UnloadTexture(this.tex_imp_walk);
        Raylib::UnloadTexture(this.tex_imp_attack);
        Raylib::UnloadTexture(this.tex_imp_pain);
        Raylib::UnloadTexture(this.tex_imp_die);

        Raylib::UnloadTexture(this.tex_pinky_walk);
        Raylib::UnloadTexture(this.tex_pinky_attack);
        Raylib::UnloadTexture(this.tex_pinky_pain);
        Raylib::UnloadTexture(this.tex_pinky_die);

        Raylib::UnloadTexture(this.tex_pickup_shotgun);
        Raylib::UnloadTexture(this.tex_pickup_chaingun);
        Raylib::UnloadTexture(this.tex_pickup_chainsaw);
        Raylib::UnloadTexture(this.tex_pickup_clip);
        Raylib::UnloadTexture(this.tex_pickup_shells);
        Raylib::UnloadTexture(this.tex_pickup_stimpack);
        Raylib::UnloadTexture(this.tex_pickup_medikit);
        Raylib::UnloadTexture(this.tex_pickup_armor_green);
        Raylib::UnloadTexture(this.tex_pickup_key_blue);
        Raylib::UnloadTexture(this.tex_pickup_key_red);
        Raylib::UnloadTexture(this.tex_pickup_key_yellow);
        Raylib::UnloadTexture(this.tex_barrel);

        Raylib::UnloadTexture(this.tex_projectile_fireball);
        Raylib::UnloadTexture(this.tex_projectile_rocket);

        Raylib::UnloadTexture(this.tex_fist_idle);
        Raylib::UnloadTexture(this.tex_fist_punch);
        Raylib::UnloadTexture(this.tex_pistol_idle);
        Raylib::UnloadTexture(this.tex_pistol_fire);
        Raylib::UnloadTexture(this.tex_shotgun_idle);
        Raylib::UnloadTexture(this.tex_shotgun_fire);
        Raylib::UnloadTexture(this.tex_shotgun_cock);
        Raylib::UnloadTexture(this.tex_chaingun_idle);
        Raylib::UnloadTexture(this.tex_chaingun_fire);
        Raylib::UnloadTexture(this.tex_rocket_idle);
        Raylib::UnloadTexture(this.tex_rocket_fire);

        Raylib::UnloadTexture(this.tex_stbar);
        for (int32 digit_index = 0; digit_index < 10; digit_index = digit_index + 1) {
            Raylib::UnloadTexture(this.tex_numbers_gold[digit_index]);
            Raylib::UnloadTexture(this.tex_numbers_yellow[digit_index]);
        }

        Raylib::UnloadTexture(this.tex_face_normal);
        Raylib::UnloadTexture(this.tex_face_look_left);
        Raylib::UnloadTexture(this.tex_face_look_right);
        Raylib::UnloadTexture(this.tex_face_evil);
        Raylib::UnloadTexture(this.tex_face_ouch);
        Raylib::UnloadTexture(this.tex_face_dead);

        this.is_loaded = false;
    }
}
