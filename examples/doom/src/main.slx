package doom;

import raylib.*;

public class DoomGame {
    public int32 game_state;
    public bool show_automap;

    public DoomPlayer player;
    public FpsCamera camera;
    public LevelMap level_map;
    public WeaponManager weapon_manager;
    public DoomAudio audio_manager;
    public DoomHUD user_interface;
    public DoomResources resources;

    public Projectile[] projectiles;
    public int32 max_projectiles;

    public DoomGame() {
        this.game_state = GameState::PLAYING;
        this.show_automap = false;

        this.resources = new DoomResources();
        this.audio_manager = new DoomAudio();
        this.user_interface = new DoomHUD();
        this.level_map = new LevelMap();

        this.player = new DoomPlayer(
            this.level_map.player_spawn_x,
            this.level_map.player_spawn_y,
            this.level_map.player_spawn_z
        );
        this.camera = new FpsCamera(
            this.player.pos_x,
            this.player.pos_y,
            this.player.pos_z,
            this.level_map.player_spawn_yaw
        );
        this.weapon_manager = new WeaponManager();

        this.max_projectiles = 30;
        this.projectiles = new Projectile[30];
        for (int32 proj_idx = 0; proj_idx < this.max_projectiles; proj_idx = proj_idx + 1) {
            this.projectiles[proj_idx] = new Projectile();
        }
    }

    public void update() {
        if (this.game_state != GameState::PLAYING) {
            return;
        }

        // 1. Mouse & Keyboard Look Input
        Vector2 mouse_delta = Raylib::GetMouseDelta();
        float32 delta_look_x = mouse_delta.x;
        float32 delta_look_y = mouse_delta.y;

        if (Raylib::IsKeyDown(KeyboardKey::KEY_LEFT)) {
            delta_look_x = delta_look_x - (float32)18.0;
        }
        if (Raylib::IsKeyDown(KeyboardKey::KEY_RIGHT)) {
            delta_look_x = delta_look_x + (float32)18.0;
        }
        if (Raylib::IsKeyDown(KeyboardKey::KEY_UP)) {
            delta_look_y = delta_look_y - (float32)12.0;
        }
        if (Raylib::IsKeyDown(KeyboardKey::KEY_DOWN)) {
            delta_look_y = delta_look_y + (float32)12.0;
        }

        this.camera.update_look(delta_look_x, delta_look_y, DoomConstants::MOUSE_SENSITIVITY);

        // 2. WASD Movement Input
        bool move_fwd = Raylib::IsKeyDown(KeyboardKey::KEY_W);
        bool move_bwd = Raylib::IsKeyDown(KeyboardKey::KEY_S);
        bool strafe_left = Raylib::IsKeyDown(KeyboardKey::KEY_A);
        bool strafe_right = Raylib::IsKeyDown(KeyboardKey::KEY_D);
        bool is_sprinting = Raylib::IsKeyDown(KeyboardKey::KEY_LEFT_SHIFT) || Raylib::IsKeyDown(KeyboardKey::KEY_RIGHT_SHIFT);

        bool is_moving = move_fwd || move_bwd || strafe_left || strafe_right;
        this.player.update_movement(
            this.camera,
            this.level_map,
            move_fwd,
            move_bwd,
            strafe_left,
            strafe_right,
            is_sprinting
        );
        this.camera.update_position(this.player.pos_x, this.player.pos_y, this.player.pos_z, is_moving);

        // 3. Weapon selection
        if (Raylib::IsKeyPressed(KeyboardKey::KEY_ONE)) {
            this.weapon_manager.select_weapon(WeaponKind::FIST);
        } else if (Raylib::IsKeyPressed(KeyboardKey::KEY_TWO)) {
            this.weapon_manager.select_weapon(WeaponKind::PISTOL);
        } else if (Raylib::IsKeyPressed(KeyboardKey::KEY_THREE)) {
            this.weapon_manager.select_weapon(WeaponKind::SHOTGUN);
        } else if (Raylib::IsKeyPressed(KeyboardKey::KEY_FOUR)) {
            this.weapon_manager.select_weapon(WeaponKind::CHAINGUN);
        } else if (Raylib::IsKeyPressed(KeyboardKey::KEY_FIVE)) {
            this.weapon_manager.select_weapon(WeaponKind::ROCKET_LAUNCHER);
        }

        // 4. Weapon firing
        bool fire_input = Raylib::IsMouseButtonDown(MouseButton::MOUSE_BUTTON_LEFT) ||
                          Raylib::IsKeyDown(KeyboardKey::KEY_LEFT_CONTROL) ||
                          Raylib::IsKeyDown(KeyboardKey::KEY_SPACE);
        if (fire_input) {
            this.weapon_manager.fire_weapon(this.player, this.camera, this.level_map, this.audio_manager);
        }
        this.weapon_manager.update();

        // 5. Use Key (Open Doors)
        if (Raylib::IsKeyPressed(KeyboardKey::KEY_E)) {
            this.level_map.test_door_interaction(
                this.player.pos_x,
                this.player.pos_z,
                this.player.has_blue_key,
                this.player.has_red_key,
                this.player.has_yellow_key,
                this.audio_manager
            );
        }

        // 6. Automap toggle (TAB)
        if (Raylib::IsKeyPressed(KeyboardKey::KEY_TAB)) {
            this.show_automap = !this.show_automap;
        }

        // 7. Map & Door update
        this.level_map.update(this.audio_manager);

        // 8. Pickup collection check
        this.level_map.check_pickup_collection(this.player, this.weapon_manager, this.audio_manager);

        // 9. Enemy Monster AI updates
        for (int32 enemy_index = 0; enemy_index < this.level_map.enemy_count; enemy_index = enemy_index + 1) {
            EnemyMonster monster = this.level_map.enemies[enemy_index];
            if (monster != null) {
                monster.update(
                    this.player.pos_x,
                    this.player.pos_y,
                    this.player.pos_z,
                    this.level_map,
                    this.audio_manager
                );

                // Melee bite damage from Pinky
                if (monster.is_alive && monster.ai_state == EnemyAiState::ATTACK && monster.kind == EnemyKind::PINKY_DEMON) {
                    float32 dist_to_player = DoomMath::distance_2d(this.player.pos_x, this.player.pos_z, monster.pos_x, monster.pos_z);
                    if (dist_to_player < (float32)1.2) {
                        this.player.take_damage((float32)14.0, this.audio_manager);
                    }
                }
            }
        }

        // 10. Projectile updates
        for (int32 proj_idx = 0; proj_idx < this.max_projectiles; proj_idx = proj_idx + 1) {
            if (this.projectiles[proj_idx].is_active) {
                this.projectiles[proj_idx].update(this.level_map, this.audio_manager);
            }
        }
    }

    public void draw() {
        Raylib::ClearBackground(new Color(15, 15, 20, 255));

        // 3D Rendering Phase
        Raylib::BeginMode3D(this.camera.camera_instance);

        // 1. Draw authentic E1M1 3D World (floors, textured walls, doors)
        this.level_map.draw_world(this.resources);

        // 2. Draw 2.5D billboard monsters
        for (int32 enemy_index = 0; enemy_index < this.level_map.enemy_count; enemy_index = enemy_index + 1) {
            EnemyMonster monster = this.level_map.enemies[enemy_index];
            if (monster != null) {
                monster.draw_with_camera(this.camera.billboard_camera, this.resources);
            }
        }

        // 3. Draw 2.5D billboard pickups & barrels
        for (int32 item_index = 0; item_index < this.level_map.pickup_count; item_index = item_index + 1) {
            PickupItem item = this.level_map.pickups[item_index];
            if (item != null) {
                item.draw_with_camera(this.camera.billboard_camera, this.resources);
            }
        }

        // 4. Draw projectiles
        for (int32 proj_idx = 0; proj_idx < this.max_projectiles; proj_idx = proj_idx + 1) {
            if (this.projectiles[proj_idx].is_active) {
                this.projectiles[proj_idx].draw_with_camera(this.camera.billboard_camera, this.resources);
            }
        }

        Raylib::EndMode3D();

        // 2D Phase
        if (this.show_automap) {
            this.user_interface.draw_automap(
                this.level_map,
                this.player,
                DoomConstants::SCREEN_WIDTH,
                DoomConstants::SCREEN_HEIGHT
            );
        } else {
            // Authentic First-Person Weapon
            this.weapon_manager.draw_first_person_weapon(
                DoomConstants::SCREEN_WIDTH,
                DoomConstants::SCREEN_HEIGHT,
                this.camera.bob_offset_y,
                this.resources
            );

            // Authentic STBAR Status Bar with Doomguy face & font numbers
            this.user_interface.draw_hud(
                this.player,
                this.weapon_manager,
                DoomConstants::SCREEN_WIDTH,
                DoomConstants::SCREEN_HEIGHT,
                this.audio_manager.is_muted,
                this.resources
            );
        }
    }

    public static int32 main() {
        Raylib::InitWindow(
            DoomConstants::SCREEN_WIDTH,
            DoomConstants::SCREEN_HEIGHT,
            "DOOM : Solix Edition — Authentic E1M1: Hangar"
        );
        Raylib::InitAudioDevice();
        Raylib::SetTargetFPS(DoomConstants::TARGET_FPS);
        Raylib::SetExitKey(0); // Free ESC key for pause menu
        Raylib::DisableCursor(); // Capture mouse for smooth FPS camera

        DoomGame game = new DoomGame();
        game.resources.load();
        game.audio_manager.load();

        while (!Raylib::WindowShouldClose()) {
            if (Raylib::IsKeyPressed(KeyboardKey::KEY_M)) {
                game.audio_manager.toggle_mute();
            }

            if (Raylib::IsKeyPressed(KeyboardKey::KEY_P) || Raylib::IsKeyPressed(KeyboardKey::KEY_ESCAPE)) {
                if (game.game_state == GameState::PLAYING) {
                    game.game_state = GameState::PAUSED;
                    Raylib::EnableCursor();
                } else if (game.game_state == GameState::PAUSED) {
                    game.game_state = GameState::PLAYING;
                    Raylib::DisableCursor();
                }
            }

            game.update();

            Raylib::BeginDrawing();
            game.draw();
            Raylib::EndDrawing();
        }

        Raylib::EnableCursor();
        game.resources.unload();
        game.audio_manager.unload_all();
        Raylib::CloseAudioDevice();
        Raylib::CloseWindow();
        return 0;
    }
}
