package doom;

import raylib.*;
import solix.math.Math;

public class DoomPlayer {
    public float32 pos_x;
    public float32 pos_y;
    public float32 pos_z;

    public float32 health_val;
    public float32 armor_val;

    public bool has_blue_key;
    public bool has_red_key;
    public bool has_yellow_key;

    public int32 damage_flash_timer;
    public int32 pickup_flash_timer;
    public bool is_alive;

    public DoomPlayer(float32 spawn_x, float32 spawn_y, float32 spawn_z) {
        this.reset_player(spawn_x, spawn_y, spawn_z);
    }

    public void reset_player(float32 spawn_x, float32 spawn_y, float32 spawn_z) {
        this.pos_x = spawn_x;
        this.pos_y = spawn_y;
        this.pos_z = spawn_z;

        this.health_val = (float32)100.0;
        this.armor_val = (float32)0.0;

        this.has_blue_key = false;
        this.has_red_key = false;
        this.has_yellow_key = false;

        this.damage_flash_timer = 0;
        this.pickup_flash_timer = 0;
        this.is_alive = true;
    }

    public void update_movement(
        FpsCamera camera,
        LevelMap level_map,
        bool move_forward,
        bool move_backward,
        bool strafe_left,
        bool strafe_right,
        bool is_sprinting
    ) {
        if (!this.is_alive) {
            return;
        }

        float32 current_speed = is_sprinting ? DoomConstants::SPRINT_SPEED : DoomConstants::WALK_SPEED;
        float32 move_step = current_speed * (float32)(1.0 / 60.0);

        float64 yaw_rad = (float64)camera.yaw_angle * (Math::PI / 180.0);
        float32 forward_dir_x = (float32)Math::cos(yaw_rad);
        float32 forward_dir_z = (float32)Math::sin(yaw_rad);

        // Right vector is perpendicular to forward vector on horizontal XZ plane
        float32 right_dir_x = -forward_dir_z;
        float32 right_dir_z = forward_dir_x;

        float32 wish_dir_x = (float32)0.0;
        float32 wish_dir_z = (float32)0.0;

        if (move_forward) {
            wish_dir_x = wish_dir_x + forward_dir_x;
            wish_dir_z = wish_dir_z + forward_dir_z;
        }
        if (move_backward) {
            wish_dir_x = wish_dir_x - forward_dir_x;
            wish_dir_z = wish_dir_z - forward_dir_z;
        }
        if (strafe_left) {
            wish_dir_x = wish_dir_x - right_dir_x;
            wish_dir_z = wish_dir_z - right_dir_z;
        }
        if (strafe_right) {
            wish_dir_x = wish_dir_x + right_dir_x;
            wish_dir_z = wish_dir_z + right_dir_z;
        }

        float32 input_magnitude_sq = (wish_dir_x * wish_dir_x) + (wish_dir_z * wish_dir_z);
        if (input_magnitude_sq > (float32)0.0001) {
            float32 input_len = (float32)Math::sqrt((float64)input_magnitude_sq);
            wish_dir_x = (wish_dir_x / input_len) * move_step;
            wish_dir_z = (wish_dir_z / input_len) * move_step;

            float32 target_x = this.pos_x + wish_dir_x;
            float32 target_z = this.pos_z + wish_dir_z;

            // Resolve smooth wall sliding across all solid wall segments
            level_map.resolve_player_collision(this, target_x, target_z, DoomConstants::PLAYER_RADIUS);
        }
    }

    public void take_damage(float32 damage_amount, DoomAudio audio_manager) {
        if (!this.is_alive) {
            return;
        }

        float32 absorbed_by_armor = (float32)0.0;
        if (this.armor_val > (float32)0.0) {
            absorbed_by_armor = damage_amount * (float32)0.33;
            if (absorbed_by_armor > this.armor_val) {
                absorbed_by_armor = this.armor_val;
            }
            this.armor_val = this.armor_val - absorbed_by_armor;
        }

        float32 direct_health_damage = damage_amount - absorbed_by_armor;
        this.health_val = this.health_val - direct_health_damage;
        this.damage_flash_timer = 15;

        if (this.health_val <= (float32)0.0) {
            this.health_val = (float32)0.0;
            this.is_alive = false;
            audio_manager.play_sound(audio_manager.sound_player_death);
        } else {
            audio_manager.play_sound(audio_manager.sound_player_pain);
        }
    }
}
