package doom;

import raylib.*;

public class DoomUserInterface {
    public DoomUserInterface() {
    }

    public void draw_crosshair(int32 screen_width, int32 screen_height) {
        int32 center_screen_x = screen_width / 2;
        int32 center_screen_y = screen_height / 2;
        Color crosshair_cyan = new Color(0, 230, 255, 180);

        Raylib::DrawRectangle(center_screen_x - 8, center_screen_y - 1, 16, 2, crosshair_cyan);
        Raylib::DrawRectangle(center_screen_x - 1, center_screen_y - 8, 2, 16, crosshair_cyan);
        Raylib::DrawCircle(center_screen_x, center_screen_y, 2.0, Color::WHITE);
    }

    public void draw_screen_flashes(int32 damage_flash, int32 pickup_flash, int32 screen_width, int32 screen_height) {
        if (damage_flash > 0) {
            int32 alpha_byte = (int32)(((float32)damage_flash / 12.0) * 110.0);
            Color red_tint = new Color(220, 20, 20, alpha_byte);
            Raylib::DrawRectangle(0, 0, screen_width, screen_height, red_tint);
        } else if (pickup_flash > 0) {
            int32 alpha_byte = (int32)(((float32)pickup_flash / 8.0) * 75.0);
            Color gold_tint = new Color(255, 215, 0, alpha_byte);
            Raylib::DrawRectangle(0, 0, screen_width, screen_height, gold_tint);
        }
    }

    public void draw_status_bar(
        Player player,
        WeaponManager weapons,
        int32 screen_width,
        int32 screen_height,
        bool is_sound_muted
    ) {
        this.draw_status_bar_with_resources(player, weapons, screen_width, screen_height, is_sound_muted, null);
    }

    public void draw_status_bar_with_resources(
        Player player,
        WeaponManager weapons,
        int32 screen_width,
        int32 screen_height,
        bool is_sound_muted,
        DoomResources resources
    ) {
        int32 bar_height = 100;
        int32 bar_pos_y = screen_height - bar_height;

        Color text_gold = new Color(255, 210, 30, 255);
        Color label_gray = new Color(140, 150, 165, 255);
        Color border_highlight = new Color(90, 95, 105, 255);

        if (resources != null && resources.is_loaded && resources.tex_hud_status_bar.id > 0) {
            Rectangle status_src = new Rectangle(0.0, 0.0, (float32)resources.tex_hud_status_bar.width, (float32)resources.tex_hud_status_bar.height);
            Rectangle status_dst = new Rectangle(0.0, (float32)bar_pos_y, (float32)screen_width, (float32)bar_height);
            Raylib::DrawTexturePro(resources.tex_hud_status_bar, status_src, status_dst, new Vector2(0.0, 0.0), 0.0, Color::WHITE);
        } else {
            Color outer_frame = new Color(45, 45, 50, 255);
            Color inner_plate = new Color(28, 30, 35, 255);
            Raylib::DrawRectangle(0, bar_pos_y, screen_width, bar_height, outer_frame);
            Raylib::DrawRectangle(6, bar_pos_y + 6, screen_width - 12, bar_height - 12, inner_plate);
            Raylib::DrawRectangleLines(6, bar_pos_y + 6, screen_width - 12, bar_height - 12, border_highlight);
        }

        // Section 1: AMMO
        Raylib::DrawText("AMMO", 35, bar_pos_y + 14, 18, label_gray);
        string ammo_text = "" + weapons.get_current_ammo_count();
        if (weapons.active_weapon_kind == WeaponKind::FIST) {
            ammo_text = "INF";
        }
        Raylib::DrawText(ammo_text, 40, bar_pos_y + 42, 34, text_gold);

        // Section 2: HEALTH
        Raylib::DrawText("HEALTH", 180, bar_pos_y + 14, 18, label_gray);
        Color health_color = text_gold;
        if (player.health_val <= 25.0) {
            health_color = Color::RED;
        }
        Raylib::DrawText("" + (int32)player.health_val + "%", 180, bar_pos_y + 42, 34, health_color);

        // Section 3: ARMS MATRIX (2, 3, 4, 5)
        Raylib::DrawText("ARMS", 320, bar_pos_y + 14, 18, label_gray);
        for (int32 slot_index = 1; slot_index < 5; slot_index = slot_index + 1) {
            int32 slot_x = 320 + ((slot_index - 1) * 24);
            bool unlocked = weapons.unlocked_weapons[slot_index];
            bool active = (weapons.active_weapon_kind == slot_index);
            Color slot_color = unlocked ? (active ? Color::GREEN : text_gold) : Color::DARKGRAY;
            Raylib::DrawText("" + (slot_index + 1), slot_x, bar_pos_y + 46, 20, slot_color);
        }

        // Section 4: DOOMGUY ANIMATED MUGSHOT (Center)
        int32 face_box_x = (screen_width / 2) - 36;
        int32 face_box_y = bar_pos_y + 12;

        bool drew_authentic_face = false;
        if (resources != null && resources.is_loaded) {
            Texture2D face_texture = resources.tex_face_normal;
            if (!player.is_alive) {
                face_texture = resources.tex_face_dead;
            } else if (weapons.cooldown_ticks > 0) {
                face_texture = resources.tex_face_evil;
            } else if (player.mugshot_expression == 2 || player.damage_flash_timer > 0) {
                face_texture = resources.tex_face_ouch;
            } else {
                int32 glance_cycle = (player.look_direction_tick / 75) % 4;
                if (glance_cycle == 1) {
                    face_texture = resources.tex_face_left;
                } else if (glance_cycle == 3) {
                    face_texture = resources.tex_face_right;
                }
            }

            if (face_texture.id > 0) {
                float32 face_scale = 2.4;
                float32 face_width = (float32)face_texture.width * face_scale;
                float32 face_height = (float32)face_texture.height * face_scale;
                float32 face_pos_x = (float32)face_box_x + ((72.0 - face_width) * 0.5);
                float32 face_pos_y = (float32)face_box_y + ((76.0 - face_height) * 0.5);

                Rectangle face_src = new Rectangle(0.0, 0.0, (float32)face_texture.width, (float32)face_texture.height);
                Rectangle face_dst = new Rectangle(face_pos_x, face_pos_y, face_width, face_height);
                Raylib::DrawTexturePro(face_texture, face_src, face_dst, new Vector2(0.0, 0.0), 0.0, Color::WHITE);
                drew_authentic_face = true;
            }
        }

        if (!drew_authentic_face) {
            Raylib::DrawRectangle(face_box_x, face_box_y, 72, 76, new Color(18, 20, 24, 255));
            Raylib::DrawRectangleLines(face_box_x, face_box_y, 72, 76, border_highlight);
            this.draw_doomguy_mugshot(face_box_x + 36, face_box_y + 38, player);
        }

        // Section 5: ARMOR
        Raylib::DrawText("ARMOR", 580, bar_pos_y + 14, 18, label_gray);
        Color armor_color = (player.armor_val > 0.0) ? new Color(0, 229, 255, 255) : Color::GRAY;
        Raylib::DrawText("" + (int32)player.armor_val + "%", 580, bar_pos_y + 42, 34, armor_color);

        // Section 6: KEYCARDS (Blue, Red, Yellow)
        Raylib::DrawText("KEYS", 730, bar_pos_y + 14, 18, label_gray);
        Color blue_slot = player.has_blue_key ? new Color(0, 140, 255, 255) : new Color(25, 40, 60, 255);
        Raylib::DrawRectangle(730, bar_pos_y + 42, 14, 24, blue_slot);
        Raylib::DrawRectangleLines(730, bar_pos_y + 42, 14, 24, Color::BLACK);

        Color red_slot = player.has_red_key ? new Color(255, 40, 40, 255) : new Color(60, 25, 25, 255);
        Raylib::DrawRectangle(752, bar_pos_y + 42, 14, 24, red_slot);
        Raylib::DrawRectangleLines(752, bar_pos_y + 42, 14, 24, Color::BLACK);

        Color yellow_slot = player.has_yellow_key ? new Color(255, 214, 0, 255) : new Color(60, 55, 20, 255);
        Raylib::DrawRectangle(774, bar_pos_y + 42, 14, 24, yellow_slot);
        Raylib::DrawRectangleLines(774, bar_pos_y + 42, 14, 24, Color::BLACK);

        // Section 7: Sound & Status
        if (is_sound_muted) {
            Raylib::DrawText("[ MUTED (M) ]", 850, bar_pos_y + 42, 18, Color::RED);
        } else {
            Raylib::DrawText("[ AUDIO ON ]", 850, bar_pos_y + 42, 18, new Color(0, 230, 118, 200));
        }
    }

    public void draw_doomguy_mugshot(int32 center_x, int32 center_y, Player player) {
        if (!player.is_alive) {
            Color dead_skin = new Color(170, 170, 180, 255);
            Raylib::DrawRectangle(center_x - 22, center_y - 26, 44, 52, dead_skin);
            Raylib::DrawText("X", center_x - 14, center_y - 12, 16, Color::RED);
            Raylib::DrawText("X", center_x + 4, center_y - 12, 16, Color::RED);
            Raylib::DrawRectangle(center_x - 16, center_y + 10, 32, 6, Color::MAROON);
            return;
        }

        Color marine_hair = new Color(80, 45, 25, 255);
        Color marine_skin = new Color(225, 170, 135, 255);

        if (player.health_val < 35.0) {
            marine_skin = new Color(210, 130, 110, 255);
        } else if (player.health_val < 65.0) {
            marine_skin = new Color(220, 150, 125, 255);
        }

        Raylib::DrawRectangle(center_x - 24, center_y - 28, 48, 56, marine_skin);
        Raylib::DrawRectangle(center_x - 24, center_y - 30, 48, 14, marine_hair);

        int32 pupil_offset_x = 0;
        int32 glance_cycle = (player.look_direction_tick / 75) % 4;
        if (glance_cycle == 1) {
            pupil_offset_x = -3;
        } else if (glance_cycle == 3) {
            pupil_offset_x = 3;
        }

        Color brow_color = Color::BLACK;
        if (player.mugshot_expression == 2) {
            Raylib::DrawLine(center_x - 16, center_y - 10, center_x - 4, center_y - 6, brow_color);
            Raylib::DrawLine(center_x + 4, center_y - 6, center_x + 16, center_y - 10, brow_color);
        } else {
            Raylib::DrawRectangle(center_x - 16, center_y - 10, 12, 3, brow_color);
            Raylib::DrawRectangle(center_x + 4, center_y - 10, 12, 3, brow_color);
        }

        Raylib::DrawRectangle(center_x - 14, center_y - 6, 9, 6, Color::WHITE);
        Raylib::DrawRectangle(center_x + 5, center_y - 6, 9, 6, Color::WHITE);

        Color eye_blue = new Color(30, 100, 220, 255);
        Raylib::DrawRectangle(center_x - 11 + pupil_offset_x, center_y - 5, 4, 4, eye_blue);
        Raylib::DrawRectangle(center_x + 8 + pupil_offset_x, center_y - 5, 4, 4, eye_blue);

        Raylib::DrawRectangle(center_x - 2, center_y, 4, 8, new Color(190, 130, 100, 255));

        if (player.mugshot_expression == 1) {
            Raylib::DrawRectangle(center_x - 12, center_y + 12, 24, 6, Color::WHITE);
            Raylib::DrawRectangle(center_x - 10, center_y + 11, 20, 2, Color::BLACK);
            Raylib::DrawRectangle(center_x - 10, center_y + 16, 20, 2, Color::BLACK);
        } else if (player.mugshot_expression == 2) {
            Raylib::DrawRectangle(center_x - 10, center_y + 14, 20, 4, Color::MAROON);
        } else {
            Raylib::DrawRectangle(center_x - 12, center_y + 13, 24, 3, new Color(140, 60, 40, 255));
        }
    }

    public void render_title_screen(int32 screen_width, int32 screen_height) {
        this.draw_title_screen(screen_width, screen_height);
    }

    public void render_intermission_screen(int32 level_completed, int32 kills, int32 total_enemies, int32 screen_width, int32 screen_height) {
        this.draw_intermission_screen(screen_width, screen_height, level_completed, kills, total_enemies);
    }

    public void render_game_over_screen(int32 screen_width, int32 screen_height) {
        this.draw_game_over_screen(screen_width, screen_height);
    }

    public void render_victory_screen(int32 screen_width, int32 screen_height) {
        this.draw_victory_screen(screen_width, screen_height);
    }

    public void draw_title_screen(int32 screen_width, int32 screen_height) {
        Color dark_blood = new Color(15, 10, 12, 255);
        Raylib::DrawRectangle(0, 0, screen_width, screen_height, dark_blood);

        int32 center_screen_x = screen_width / 2;

        Raylib::DrawText("DOOM: SOLIX RETRO REBORN", center_screen_x - 300, 160, 46, Color::RED);
        Raylib::DrawText("CLASSIC EPISODE 1: KNEE-DEEP IN THE DEAD", center_screen_x - 250, 220, 20, Color::GOLD);

        Color box_border = new Color(180, 40, 30, 255);
        Raylib::DrawRectangleLines(center_screen_x - 260, 280, 520, 280, box_border);

        Raylib::DrawText("CONTROLS:", center_screen_x - 230, 310, 22, Color::YELLOW);
        Raylib::DrawText("- W / A / S / D : Move & Strafe", center_screen_x - 210, 345, 18, Color::WHITE);
        Raylib::DrawText("- MOUSE : Free-Look Aiming (Natural 3D)", center_screen_x - 210, 375, 18, Color::WHITE);
        Raylib::DrawText("- LEFT CLICK : Fire Active Weapon", center_screen_x - 210, 405, 18, Color::WHITE);
        Raylib::DrawText("- 1, 2, 3, 4, 5 : Weapon Arsenal Selection", center_screen_x - 210, 435, 18, Color::WHITE);
        Raylib::DrawText("- E : Open Doors & Trigger Exit Switch", center_screen_x - 210, 465, 18, Color::WHITE);
        Raylib::DrawText("- M : Toggle Sound Audio Mute", center_screen_x - 210, 495, 18, Color::WHITE);

        int32 blink_rate = (int32)(Raylib::GetTime() * 3.0) % 2;
        if (blink_rate == 0) {
            Raylib::DrawText("PRESS ENTER OR SPACE TO START", center_screen_x - 210, 610, 24, Color::GREEN);
        }
    }

    public void draw_intermission_screen(int32 screen_width, int32 screen_height, int32 level_completed, int32 kills, int32 total_enemies) {
        Raylib::DrawRectangle(0, 0, screen_width, screen_height, new Color(20, 22, 28, 255));
        int32 center_screen_x = screen_width / 2;

        Raylib::DrawText("LEVEL COMPLETED!", center_screen_x - 170, 180, 38, Color::GOLD);
        string level_title = (level_completed == 1) ? "E1M1: HANGAR" : "E1M2: NUCLEAR PLANT";
        Raylib::DrawText(level_title, center_screen_x - 140, 240, 26, Color::WHITE);

        int32 kill_percent = (total_enemies > 0) ? (kills * 100) / total_enemies : 100;
        Raylib::DrawText("KILLS: " + kills + " / " + total_enemies + " (" + kill_percent + "%)", center_screen_x - 150, 320, 28, Color::RED);
        Raylib::DrawText("ITEMS: 100%", center_screen_x - 150, 370, 28, Color::YELLOW);
        Raylib::DrawText("SECRETS: 100%", center_screen_x - 150, 420, 28, Color::GREEN);

        Raylib::DrawText("PRESS ENTER TO ENTER NEXT AREA", center_screen_x - 220, 560, 24, Color::WHITE);
    }

    public void draw_game_over_screen(int32 screen_width, int32 screen_height) {
        Raylib::DrawRectangle(0, 0, screen_width, screen_height, new Color(40, 10, 10, 220));
        int32 center_screen_x = screen_width / 2;
        Raylib::DrawText("YOU HAVE PERISHED", center_screen_x - 210, 280, 44, Color::RED);
        Raylib::DrawText("PRESS R TO RESPAWN IN LEVEL", center_screen_x - 190, 360, 24, Color::WHITE);
    }

    public void draw_victory_screen(int32 screen_width, int32 screen_height) {
        Raylib::DrawRectangle(0, 0, screen_width, screen_height, new Color(15, 30, 15, 255));
        int32 center_screen_x = screen_width / 2;
        Raylib::DrawText("VICTORY! EPISODE CLEARED!", center_screen_x - 270, 260, 42, Color::GOLD);
        Raylib::DrawText("ALL DEMONS RETREATED FROM MARS BASE", center_screen_x - 240, 330, 22, Color::WHITE);
        Raylib::DrawText("PRESS ENTER TO RETURN TO TITLE", center_screen_x - 190, 420, 22, Color::GREEN);
    }
}
