package doom;

import raylib.*;

public class DoomHUD {
    public int32 face_anim_timer;

    public DoomHUD() {
        this.face_anim_timer = 0;
    }

    public void draw_hud(
        DoomPlayer player,
        WeaponManager weapons,
        int32 screen_width,
        int32 screen_height,
        bool is_muted,
        DoomResources resources
    ) {
        if (resources == null || !resources.is_loaded) {
            return;
        }

        this.face_anim_timer = this.face_anim_timer + 1;
        float32 bar_height = (float32)80.0;
        float32 bar_y = (float32)screen_height - bar_height;

        // 1. Draw STBAR Background
        Rectangle bar_source = new Rectangle((float32)0.0, (float32)0.0, (float32)resources.tex_stbar.width, (float32)resources.tex_stbar.height);
        Rectangle bar_dest = new Rectangle((float32)0.0, bar_y, (float32)screen_width, bar_height);
        Vector2 bar_origin = new Vector2((float32)0.0, (float32)0.0);
        Raylib::DrawTexturePro(resources.tex_stbar, bar_source, bar_dest, bar_origin, (float32)0.0, Color::WHITE);

        // 2. Draw Current Ammo Number
        int32 current_ammo = weapons.ammo_bullets;
        if (weapons.selected_weapon == WeaponKind::SHOTGUN) {
            current_ammo = weapons.ammo_shells;
        } else if (weapons.selected_weapon == WeaponKind::ROCKET_LAUNCHER) {
            current_ammo = weapons.ammo_rockets;
        }
        this.draw_large_number(current_ammo, (float32)85.0, bar_y + (float32)16.0, resources);

        // 3. Draw Health Number
        int32 display_health = (int32)player.health_val;
        this.draw_large_number(display_health, (float32)240.0, bar_y + (float32)16.0, resources);

        // 4. Draw Armor Number
        int32 display_armor = (int32)player.armor_val;
        this.draw_large_number(display_armor, (float32)580.0, bar_y + (float32)16.0, resources);

        // 5. Draw Animated Doomguy Face in Status Bar Center
        Texture2D current_face = resources.tex_face_normal;
        if (!player.is_alive) {
            current_face = resources.tex_face_dead;
        } else if (player.damage_flash_timer > 0) {
            current_face = resources.tex_face_ouch;
        } else if (weapons.muzzle_flash_timer > 0) {
            current_face = resources.tex_face_evil;
        } else {
            int32 face_cycle = (this.face_anim_timer / 60) % 4;
            if (face_cycle == 1) {
                current_face = resources.tex_face_look_left;
            } else if (face_cycle == 3) {
                current_face = resources.tex_face_look_right;
            }
        }

        float32 face_width = (float32)54.0;
        float32 face_height = (float32)64.0;
        Rectangle face_source = new Rectangle((float32)0.0, (float32)0.0, (float32)current_face.width, (float32)current_face.height);
        Rectangle face_dest = new Rectangle((float32)screen_width * (float32)0.5 - (float32)27.0, bar_y + (float32)8.0, face_width, face_height);
        Raylib::DrawTexturePro(current_face, face_source, face_dest, bar_origin, (float32)0.0, Color::WHITE);

        // 6. Draw Keycard indicators
        if (player.has_blue_key) {
            Raylib::DrawRectangle((int32)((float32)screen_width * (float32)0.5 + (float32)40.0), (int32)(bar_y + (float32)10.0), 12, 16, Color::BLUE);
        }
        if (player.has_yellow_key) {
            Raylib::DrawRectangle((int32)((float32)screen_width * (float32)0.5 + (float32)40.0), (int32)(bar_y + (float32)30.0), 12, 16, Color::YELLOW);
        }
        if (player.has_red_key) {
            Raylib::DrawRectangle((int32)((float32)screen_width * (float32)0.5 + (float32)40.0), (int32)(bar_y + (float32)50.0), 12, 16, Color::RED);
        }

        // 7. Fullscreen Damage / Pickup Flashes
        if (player.damage_flash_timer > 0) {
            Color red_flash = new Color(200, 20, 20, 75);
            Raylib::DrawRectangle(0, 0, screen_width, screen_height, red_flash);
        }
        if (player.pickup_flash_timer > 0) {
            Color gold_flash = new Color(220, 180, 20, 60);
            Raylib::DrawRectangle(0, 0, screen_width, screen_height, gold_flash);
        }

        // 8. Crosshair
        int32 center_screen_x = screen_width / 2;
        int32 center_screen_y = screen_height / 2;
        Color crosshair_color = new Color(240, 240, 240, 180);
        Raylib::DrawRectangle(center_screen_x - 6, center_screen_y - 1, 12, 2, crosshair_color);
        Raylib::DrawRectangle(center_screen_x - 1, center_screen_y - 6, 2, 12, crosshair_color);
    }

    public void draw_large_number(int32 numeric_val, float32 start_pos_x, float32 start_pos_y, DoomResources resources) {
        if (numeric_val < 0) {
            numeric_val = 0;
        }

        int32 hundreds_digit = (numeric_val / 100) % 10;
        int32 tens_digit = (numeric_val / 10) % 10;
        int32 ones_digit = numeric_val % 10;

        float32 current_x = start_pos_x;
        Vector2 origin_vector = new Vector2((float32)0.0, (float32)0.0);

        if (numeric_val >= 100) {
            Texture2D hundreds_tex = resources.tex_numbers_gold[hundreds_digit];
            Rectangle src_rect = new Rectangle((float32)0.0, (float32)0.0, (float32)hundreds_tex.width, (float32)hundreds_tex.height);
            Rectangle dst_rect = new Rectangle(current_x, start_pos_y, (float32)hundreds_tex.width * (float32)2.2, (float32)hundreds_tex.height * (float32)2.2);
            Raylib::DrawTexturePro(hundreds_tex, src_rect, dst_rect, origin_vector, (float32)0.0, Color::WHITE);
            current_x = current_x + (float32)28.0;
        }

        if (numeric_val >= 10) {
            Texture2D tens_tex = resources.tex_numbers_gold[tens_digit];
            Rectangle src_rect = new Rectangle((float32)0.0, (float32)0.0, (float32)tens_tex.width, (float32)tens_tex.height);
            Rectangle dst_rect = new Rectangle(current_x, start_pos_y, (float32)tens_tex.width * (float32)2.2, (float32)tens_tex.height * (float32)2.2);
            Raylib::DrawTexturePro(tens_tex, src_rect, dst_rect, origin_vector, (float32)0.0, Color::WHITE);
            current_x = current_x + (float32)28.0;
        }

        Texture2D ones_tex = resources.tex_numbers_gold[ones_digit];
        Rectangle src_ones = new Rectangle((float32)0.0, (float32)0.0, (float32)ones_tex.width, (float32)ones_tex.height);
        Rectangle dst_ones = new Rectangle(current_x, start_pos_y, (float32)ones_tex.width * (float32)2.2, (float32)ones_tex.height * (float32)2.2);
        Raylib::DrawTexturePro(ones_tex, src_ones, dst_ones, origin_vector, (float32)0.0, Color::WHITE);
    }

    public void draw_automap(LevelMap level_map, DoomPlayer player, int32 screen_width, int32 screen_height) {
        Raylib::DrawRectangle(0, 0, screen_width, screen_height, new Color(10, 10, 15, 240));

        float32 map_center_x = (float32)screen_width * (float32)0.5;
        float32 map_center_y = (float32)screen_height * (float32)0.5;
        float32 map_zoom = (float32)8.0;

        for (int32 wall_idx = 0; wall_idx < level_map.wall_count; wall_idx = wall_idx + 1) {
            WallSegment wall = level_map.walls[wall_idx];
            if (wall != null) {
                float32 screen_x1 = map_center_x + ((wall.start_x - player.pos_x) * map_zoom);
                float32 screen_y1 = map_center_y + ((wall.start_z - player.pos_z) * map_zoom);
                float32 screen_x2 = map_center_x + ((wall.end_x - player.pos_x) * map_zoom);
                float32 screen_y2 = map_center_y + ((wall.end_z - player.pos_z) * map_zoom);

                Color wall_color = wall.is_door ? Color::YELLOW : Color::RED;
                Raylib::DrawLine((int32)screen_x1, (int32)screen_y1, (int32)screen_x2, (int32)screen_y2, wall_color);
            }
        }

        // Draw Player indicator (white dot in center)
        Raylib::DrawCircle((int32)map_center_x, (int32)map_center_y, (float32)4.0, Color::WHITE);
        Raylib::DrawText("COMPUTER AUTOMAP — E1M1: HANGAR", 30, 30, 20, Color::GREEN);
    }
}
