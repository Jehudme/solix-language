package doom;

import raylib.*;
import solix.math.Math;

public class EnemyMonster {
    public int32 kind;
    public float32 pos_x;
    public float32 pos_y;
    public float32 pos_z;

    public float32 health_val;
    public float32 max_health_val;
    public int32 ai_state;
    public int32 anim_timer;
    public int32 attack_cooldown;
    public bool is_alive;
    public bool has_spotted_player;

    public EnemyMonster(int32 monster_kind, float32 spawn_x, float32 spawn_y, float32 spawn_z) {
        this.kind = monster_kind;
        this.pos_x = spawn_x;
        this.pos_y = spawn_y;
        this.pos_z = spawn_z;
        this.ai_state = EnemyAiState::IDLE;
        this.anim_timer = 0;
        this.attack_cooldown = 0;
        this.is_alive = true;
        this.has_spotted_player = false;

        if (this.kind == EnemyKind::ZOMBIEMAN) {
            this.max_health_val = (float32)30.0;
        } else if (this.kind == EnemyKind::SHOTGUN_GUY) {
            this.max_health_val = (float32)45.0;
        } else if (this.kind == EnemyKind::IMP) {
            this.max_health_val = (float32)60.0;
        } else {
            this.max_health_val = (float32)140.0; // Pinky Demon
        }
        this.health_val = this.max_health_val;
    }

    public void update(
        float32 player_x,
        float32 player_y,
        float32 player_z,
        LevelMap level_map,
        DoomAudio audio_manager
    ) {
        if (!this.is_alive) {
            return;
        }

        if (this.attack_cooldown > 0) {
            this.attack_cooldown = this.attack_cooldown - 1;
        }

        float32 dist_to_player = DoomMath::distance_2d(this.pos_x, this.pos_z, player_x, player_z);

        if (this.ai_state == EnemyAiState::PAIN) {
            this.anim_timer = this.anim_timer - 1;
            if (this.anim_timer <= 0) {
                this.ai_state = EnemyAiState::CHASE;
            }
            return;
        }

        if (!this.has_spotted_player) {
            if (dist_to_player < (float32)22.0) {
                this.has_spotted_player = true;
                this.ai_state = EnemyAiState::CHASE;
                if (this.kind == EnemyKind::ZOMBIEMAN || this.kind == EnemyKind::SHOTGUN_GUY) {
                    audio_manager.play_sound(audio_manager.sound_zombie_sight);
                } else if (this.kind == EnemyKind::IMP) {
                    audio_manager.play_sound(audio_manager.sound_imp_sight);
                } else {
                    audio_manager.play_sound(audio_manager.sound_pinky_sight);
                }
            }
            return;
        }

        // Chasing / moving towards player
        float32 move_speed = (float32)0.04;
        if (this.kind == EnemyKind::PINKY_DEMON) {
            move_speed = (float32)0.075;
        }

        float32 diff_x = player_x - this.pos_x;
        float32 diff_z = player_z - this.pos_z;

        if (dist_to_player > (float32)0.8) {
            float32 step_x = (diff_x / dist_to_player) * move_speed;
            float32 step_z = (diff_z / dist_to_player) * move_speed;

            float32 candidate_x = this.pos_x + step_x;
            float32 candidate_z = this.pos_z + step_z;

            // Simple wall collision check for enemy
            if (!level_map.check_sphere_collision(candidate_x, candidate_z, (float32)0.4)) {
                this.pos_x = candidate_x;
                this.pos_z = candidate_z;
            }
            this.ai_state = EnemyAiState::CHASE;
        } else {
            // Melee attack range
            if (this.attack_cooldown <= 0) {
                this.ai_state = EnemyAiState::ATTACK;
                this.attack_cooldown = 45;
                if (this.kind == EnemyKind::PINKY_DEMON) {
                    audio_manager.play_sound(audio_manager.sound_pinky_attack);
                }
            }
        }
    }

    public void take_damage(float32 damage_amount, DoomAudio audio_manager) {
        if (!this.is_alive) {
            return;
        }

        this.health_val = this.health_val - damage_amount;
        this.has_spotted_player = true;

        if (this.health_val <= (float32)0.0) {
            this.health_val = (float32)0.0;
            this.is_alive = false;
            this.ai_state = EnemyAiState::DEAD;

            if (this.kind == EnemyKind::ZOMBIEMAN || this.kind == EnemyKind::SHOTGUN_GUY) {
                audio_manager.play_sound(audio_manager.sound_zombie_death);
            } else if (this.kind == EnemyKind::IMP) {
                audio_manager.play_sound(audio_manager.sound_imp_death);
            } else {
                audio_manager.play_sound(audio_manager.sound_pinky_death);
            }
        } else {
            this.ai_state = EnemyAiState::PAIN;
            this.anim_timer = 12;
        }
    }

    public void draw_with_camera(Camera billboard_camera, DoomResources resources) {
        if (resources == null || !resources.is_loaded) {
            return;
        }

        Vector3 monster_pos = new Vector3(this.pos_x, this.pos_y + (float32)0.9, this.pos_z);
        Texture2D current_texture = resources.tex_zombie_walk;
        float32 sprite_scale = (float32)1.8;

        if (this.kind == EnemyKind::ZOMBIEMAN || this.kind == EnemyKind::SHOTGUN_GUY) {
            if (this.ai_state == EnemyAiState::DEAD) {
                current_texture = resources.tex_zombie_die;
            } else if (this.ai_state == EnemyAiState::PAIN) {
                current_texture = resources.tex_zombie_pain;
            } else if (this.ai_state == EnemyAiState::ATTACK) {
                current_texture = resources.tex_zombie_attack;
            } else {
                current_texture = resources.tex_zombie_walk;
            }
        } else if (this.kind == EnemyKind::IMP) {
            sprite_scale = (float32)1.9;
            if (this.ai_state == EnemyAiState::DEAD) {
                current_texture = resources.tex_imp_die;
            } else if (this.ai_state == EnemyAiState::PAIN) {
                current_texture = resources.tex_imp_pain;
            } else if (this.ai_state == EnemyAiState::ATTACK) {
                current_texture = resources.tex_imp_attack;
            } else {
                current_texture = resources.tex_imp_walk;
            }
        } else {
            sprite_scale = (float32)2.1;
            if (this.ai_state == EnemyAiState::DEAD) {
                current_texture = resources.tex_pinky_die;
            } else if (this.ai_state == EnemyAiState::PAIN) {
                current_texture = resources.tex_pinky_pain;
            } else if (this.ai_state == EnemyAiState::ATTACK) {
                current_texture = resources.tex_pinky_attack;
            } else {
                current_texture = resources.tex_pinky_walk;
            }
        }

        Raylib::DrawBillboard(billboard_camera, current_texture, monster_pos, sprite_scale, Color::WHITE);
    }
}

public class PickupItem {
    public int32 kind;
    public float32 pos_x;
    public float32 pos_y;
    public float32 pos_z;
    public bool is_collected;

    public PickupItem(int32 pickup_kind, float32 spawn_x, float32 spawn_y, float32 spawn_z) {
        this.kind = pickup_kind;
        this.pos_x = spawn_x;
        this.pos_y = spawn_y;
        this.pos_z = spawn_z;
        this.is_collected = false;
    }

    public void draw_with_camera(Camera billboard_camera, DoomResources resources) {
        if (this.is_collected || resources == null || !resources.is_loaded) {
            return;
        }

        Vector3 pickup_pos = new Vector3(this.pos_x, this.pos_y + (float32)0.45, this.pos_z);
        Texture2D pickup_tex = resources.tex_pickup_shotgun;
        float32 item_scale = (float32)1.2;

        if (this.kind == PickupKind::SHOTGUN) {
            pickup_tex = resources.tex_pickup_shotgun;
            item_scale = (float32)1.2;
        } else if (this.kind == PickupKind::CHAINGUN) {
            pickup_tex = resources.tex_pickup_chaingun;
            item_scale = (float32)1.2;
        } else if (this.kind == PickupKind::CHAINSAW) {
            pickup_tex = resources.tex_pickup_chainsaw;
            item_scale = (float32)1.2;
        } else if (this.kind == PickupKind::AMMO_CLIP) {
            pickup_tex = resources.tex_pickup_clip;
            item_scale = (float32)0.8;
        } else if (this.kind == PickupKind::AMMO_SHELLS) {
            pickup_tex = resources.tex_pickup_shells;
            item_scale = (float32)0.8;
        } else if (this.kind == PickupKind::HEALTH_STIMPACK) {
            pickup_tex = resources.tex_pickup_stimpack;
            item_scale = (float32)0.9;
        } else if (this.kind == PickupKind::HEALTH_MEDIKIT) {
            pickup_tex = resources.tex_pickup_medikit;
            item_scale = (float32)1.1;
        } else if (this.kind == PickupKind::GREEN_ARMOR) {
            pickup_tex = resources.tex_pickup_armor_green;
            item_scale = (float32)1.2;
        } else if (this.kind == PickupKind::BLUE_KEY) {
            pickup_tex = resources.tex_pickup_key_blue;
            item_scale = (float32)0.9;
        } else if (this.kind == PickupKind::RED_KEY) {
            pickup_tex = resources.tex_pickup_key_red;
            item_scale = (float32)0.9;
        } else if (this.kind == PickupKind::YELLOW_KEY) {
            pickup_tex = resources.tex_pickup_key_yellow;
            item_scale = (float32)0.9;
        } else if (this.kind == PickupKind::BARREL) {
            pickup_tex = resources.tex_barrel;
            item_scale = (float32)1.6;
        }

        Raylib::DrawBillboard(billboard_camera, pickup_tex, pickup_pos, item_scale, Color::WHITE);
    }
}

public class Projectile {
    public bool is_active;
    public bool is_from_player;
    public bool is_rocket;
    public float32 pos_x;
    public float32 pos_y;
    public float32 pos_z;
    public float32 vel_x;
    public float32 vel_y;
    public float32 vel_z;
    public float32 damage_value;

    public Projectile() {
        this.is_active = false;
        this.is_from_player = false;
        this.is_rocket = false;
        this.pos_x = (float32)0.0;
        this.pos_y = (float32)0.0;
        this.pos_z = (float32)0.0;
        this.vel_x = (float32)0.0;
        this.vel_y = (float32)0.0;
        this.vel_z = (float32)0.0;
        this.damage_value = (float32)20.0;
    }

    public void launch(
        float32 start_x,
        float32 start_y,
        float32 start_z,
        float32 target_vel_x,
        float32 target_vel_y,
        float32 target_vel_z,
        float32 dmg_val,
        bool from_player_flag,
        bool rocket_flag
    ) {
        this.is_active = true;
        this.pos_x = start_x;
        this.pos_y = start_y;
        this.pos_z = start_z;
        this.vel_x = target_vel_x;
        this.vel_y = target_vel_y;
        this.vel_z = target_vel_z;
        this.damage_value = dmg_val;
        this.is_from_player = from_player_flag;
        this.is_rocket = rocket_flag;
    }

    public void update(LevelMap level_map, DoomAudio audio_manager) {
        if (!this.is_active) {
            return;
        }

        this.pos_x = this.pos_x + this.vel_x;
        this.pos_y = this.pos_y + this.vel_y;
        this.pos_z = this.pos_z + this.vel_z;

        if (level_map.check_sphere_collision(this.pos_x, this.pos_z, (float32)0.2)) {
            this.is_active = false;
            if (this.is_rocket) {
                audio_manager.play_sound(audio_manager.sound_explosion);
            }
        }
    }

    public void draw_with_camera(Camera billboard_camera, DoomResources resources) {
        if (!this.is_active || resources == null || !resources.is_loaded) {
            return;
        }

        Vector3 projectile_pos = new Vector3(this.pos_x, this.pos_y, this.pos_z);
        Texture2D projectile_tex = this.is_rocket ? resources.tex_projectile_rocket : resources.tex_projectile_fireball;
        float32 proj_scale = this.is_rocket ? (float32)1.0 : (float32)0.8;
        Raylib::DrawBillboard(billboard_camera, projectile_tex, projectile_pos, proj_scale, Color::WHITE);
    }
}
