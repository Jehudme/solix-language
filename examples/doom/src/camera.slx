package doom;

import raylib.*;
import solix.math.Math;

public class FpsCamera {
    public Camera3D camera_instance;
    public float32 yaw_angle;
    public float32 pitch_angle;
    public float32 view_bob_phase;
    public float32 bob_offset_y;

    public FpsCamera(float32 start_x, float32 start_y, float32 start_z) {
        this.yaw_angle = 0.0;
        this.pitch_angle = 0.0;
        this.view_bob_phase = 0.0;
        this.bob_offset_y = 0.0;

        Vector3 camera_pos = new Vector3(start_x, start_y + DoomConstants::PLAYER_EYE_HEIGHT, start_z);
        Vector3 camera_target = new Vector3(start_x + 1.0, start_y + DoomConstants::PLAYER_EYE_HEIGHT, start_z);
        Vector3 camera_up = new Vector3(0.0, 1.0, 0.0);

        this.camera_instance = new Camera3D(
            camera_pos,
            camera_target,
            camera_up,
            DoomConstants::FOV_DEFAULT,
            CameraProjection::CAMERA_PERSPECTIVE
        );
    }

    public void update_look(float32 delta_mouse_x, float32 delta_mouse_y, float32 sensitivity) {
        this.yaw_angle = this.yaw_angle - (delta_mouse_x * sensitivity);
        this.pitch_angle = this.pitch_angle - (delta_mouse_y * sensitivity);

        // Clamp pitch to avoid gimbal flip (-85 degrees to +85 degrees)
        this.pitch_angle = DoomMath::clamp_float(this.pitch_angle, -85.0, 85.0);
    }

    public void update_position(float32 player_x, float32 player_y, float32 player_z, bool is_moving) {
        if (is_moving) {
            this.view_bob_phase = this.view_bob_phase + 0.18;
            this.bob_offset_y = (float32)Math::sin((float64)this.view_bob_phase) * 0.06;
        } else {
            this.bob_offset_y = this.bob_offset_y * 0.85;
        }

        float32 eye_y = player_y + DoomConstants::PLAYER_EYE_HEIGHT + this.bob_offset_y;
        this.camera_instance.position.x = player_x;
        this.camera_instance.position.y = eye_y;
        this.camera_instance.position.z = player_z;

        // Calculate target point based on yaw and pitch
        float64 yaw_rad = (float64)this.yaw_angle * 0.017453292519943295;
        float64 pitch_rad = (float64)this.pitch_angle * 0.017453292519943295;

        float32 forward_dir_x = (float32)(Math::cos(yaw_rad) * Math::cos(pitch_rad));
        float32 forward_dir_y = (float32)Math::sin(pitch_rad);
        float32 forward_dir_z = (float32)(Math::sin(yaw_rad) * Math::cos(pitch_rad));

        this.camera_instance.target.x = player_x + forward_dir_x;
        this.camera_instance.target.y = eye_y + forward_dir_y;
        this.camera_instance.target.z = player_z + forward_dir_z;
    }

    public float32 get_forward_x() {
        float64 yaw_rad = (float64)this.yaw_angle * 0.017453292519943295;
        return (float32)Math::cos(yaw_rad);
    }

    public float32 get_forward_z() {
        float64 yaw_rad = (float64)this.yaw_angle * 0.017453292519943295;
        return (float32)Math::sin(yaw_rad);
    }

    public float32 get_right_x() {
        float64 yaw_rad = ((float64)this.yaw_angle + 90.0) * 0.017453292519943295;
        return (float32)Math::cos(yaw_rad);
    }

    public float32 get_right_z() {
        float64 yaw_rad = ((float64)this.yaw_angle + 90.0) * 0.017453292519943295;
        return (float32)Math::sin(yaw_rad);
    }
}
