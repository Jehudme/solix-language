package doom;

import raylib.*;
import solix.math.Math;

public class FpsCamera {
    public Camera3D camera_instance;
    public Camera billboard_camera;

    public float32 yaw_angle;
    public float32 pitch_angle;
    public float32 bob_timer;
    public float32 bob_offset_y;

    public FpsCamera(float32 initial_x, float32 initial_y, float32 initial_z, float32 initial_yaw) {
        this.yaw_angle = initial_yaw;
        this.pitch_angle = (float32)0.0;
        this.bob_timer = (float32)0.0;
        this.bob_offset_y = (float32)0.0;

        Vector3 camera_pos = new Vector3(initial_x, initial_y + DoomConstants::PLAYER_HEIGHT, initial_z);
        Vector3 camera_target = new Vector3(initial_x + (float32)1.0, initial_y + DoomConstants::PLAYER_HEIGHT, initial_z);
        Vector3 camera_up = new Vector3((float32)0.0, (float32)1.0, (float32)0.0);

        this.camera_instance = new Camera3D(camera_pos, camera_target, camera_up, (float32)65.0, 0);

        this.billboard_camera = new Camera();
        this.billboard_camera.position = new Vector3(camera_pos.x, camera_pos.y, camera_pos.z);
        this.billboard_camera.target = new Vector3(camera_target.x, camera_target.y, camera_target.z);
        this.billboard_camera.up = new Vector3((float32)0.0, (float32)1.0, (float32)0.0);
        this.billboard_camera.fovy = (float32)65.0;
        this.billboard_camera.projection = 0;
    }

    public void update_look(float32 delta_mouse_x, float32 delta_mouse_y, float32 sensitivity) {
        this.yaw_angle = this.yaw_angle + (delta_mouse_x * sensitivity);
        this.pitch_angle = this.pitch_angle - (delta_mouse_y * sensitivity);

        this.pitch_angle = DoomMath::clamp(this.pitch_angle, (float32)-85.0, (float32)85.0);

        while (this.yaw_angle < (float32)0.0) {
            this.yaw_angle = this.yaw_angle + (float32)360.0;
        }
        while (this.yaw_angle >= (float32)360.0) {
            this.yaw_angle = this.yaw_angle - (float32)360.0;
        }
    }

    public void update_position(
        float32 player_x,
        float32 player_y,
        float32 player_z,
        bool is_moving
    ) {
        if (is_moving) {
            this.bob_timer = this.bob_timer + (float32)0.22;
            this.bob_offset_y = (float32)Math::sin((float64)this.bob_timer) * (float32)0.06;
        } else {
            this.bob_offset_y = this.bob_offset_y * (float32)0.85;
        }

        float32 eye_elevation = player_y + DoomConstants::PLAYER_HEIGHT + this.bob_offset_y;

        this.camera_instance.position.x = player_x;
        this.camera_instance.position.y = eye_elevation;
        this.camera_instance.position.z = player_z;

        this.billboard_camera.position.x = player_x;
        this.billboard_camera.position.y = eye_elevation;
        this.billboard_camera.position.z = player_z;

        float64 yaw_rad = (float64)this.yaw_angle * (Math::PI / 180.0);
        float64 pitch_rad = (float64)this.pitch_angle * (Math::PI / 180.0);

        float32 forward_dir_x = (float32)(Math::cos(pitch_rad) * Math::cos(yaw_rad));
        float32 forward_dir_y = (float32)Math::sin(pitch_rad);
        float32 forward_dir_z = (float32)(Math::cos(pitch_rad) * Math::sin(yaw_rad));

        this.camera_instance.target.x = player_x + forward_dir_x;
        this.camera_instance.target.y = eye_elevation + forward_dir_y;
        this.camera_instance.target.z = player_z + forward_dir_z;

        this.billboard_camera.target.x = player_x + forward_dir_x;
        this.billboard_camera.target.y = eye_elevation + forward_dir_y;
        this.billboard_camera.target.z = player_z + forward_dir_z;
    }
}
