package doom;

import solix.math.Math;

public class DoomMath {
    public static float32 PI = (float32)3.14159265;

    public static float32 distance_2d(float32 first_x, float32 first_z, float32 second_x, float32 second_z) {
        float32 delta_x = second_x - first_x;
        float32 delta_z = second_z - first_z;
        return (float32)Math::sqrt((float64)((delta_x * delta_x) + (delta_z * delta_z)));
    }

    public static float32 distance_3d(
        float32 first_x,
        float32 first_y,
        float32 first_z,
        float32 second_x,
        float32 second_y,
        float32 second_z
    ) {
        float32 delta_x = second_x - first_x;
        float32 delta_y = second_y - first_y;
        float32 delta_z = second_z - first_z;
        return (float32)Math::sqrt((float64)((delta_x * delta_x) + (delta_y * delta_y) + (delta_z * delta_z)));
    }

    public static float32 clamp(float32 target_val, float32 min_val, float32 max_val) {
        if (target_val < min_val) {
            return min_val;
        }
        if (target_val > max_val) {
            return max_val;
        }
        return target_val;
    }

    // Line segment vs circle distance & push normal
    // Returns push distance (0.0 if no collision) and outputs normal in push_vector
    public static float32 test_wall_circle_collision(
        float32 wall_start_x,
        float32 wall_start_z,
        float32 wall_end_x,
        float32 wall_end_z,
        float32 circle_center_x,
        float32 circle_center_z,
        float32 circle_radius,
        float32[] push_vector_out
    ) {
        float32 segment_delta_x = wall_end_x - wall_start_x;
        float32 segment_delta_z = wall_end_z - wall_start_z;
        float32 segment_length_sq = (segment_delta_x * segment_delta_x) + (segment_delta_z * segment_delta_z);

        if (segment_length_sq < (float32)0.0001) {
            return (float32)0.0;
        }

        float32 circle_to_start_x = circle_center_x - wall_start_x;
        float32 circle_to_start_z = circle_center_z - wall_start_z;

        float32 dot_product = (circle_to_start_x * segment_delta_x) + (circle_to_start_z * segment_delta_z);
        float32 projection_t = dot_product / segment_length_sq;
        projection_t = DoomMath::clamp(projection_t, (float32)0.0, (float32)1.0);

        float32 closest_point_x = wall_start_x + (projection_t * segment_delta_x);
        float32 closest_point_z = wall_start_z + (projection_t * segment_delta_z);

        float32 offset_to_circle_x = circle_center_x - closest_point_x;
        float32 offset_to_circle_z = circle_center_z - closest_point_z;
        float32 distance_to_line = (float32)Math::sqrt((float64)((offset_to_circle_x * offset_to_circle_x) + (offset_to_circle_z * offset_to_circle_z)));

        if (distance_to_line < circle_radius && distance_to_line > (float32)0.0001) {
            float32 penetration_depth = circle_radius - distance_to_line;
            float32 normal_x = offset_to_circle_x / distance_to_line;
            float32 normal_z = offset_to_circle_z / distance_to_line;

            push_vector_out[0] = normal_x;
            push_vector_out[1] = normal_z;
            return penetration_depth;
        }

        return (float32)0.0;
    }

    public static bool test_segment_intersection(
        float32 seg1_start_x,
        float32 seg1_start_z,
        float32 seg1_end_x,
        float32 seg1_end_z,
        float32 seg2_start_x,
        float32 seg2_start_z,
        float32 seg2_end_x,
        float32 seg2_end_z
    ) {
        float32 delta1_x = seg1_end_x - seg1_start_x;
        float32 delta1_z = seg1_end_z - seg1_start_z;
        float32 delta2_x = seg2_end_x - seg2_start_x;
        float32 delta2_z = seg2_end_z - seg2_start_z;

        float32 determinant = (delta1_x * delta2_z) - (delta1_z * delta2_x);
        if (determinant > (float32)-0.0001 && determinant < (float32)0.0001) {
            return false;
        }

        float32 diff_start_x = seg2_start_x - seg1_start_x;
        float32 diff_start_z = seg2_start_z - seg1_start_z;

        float32 param_s = ((diff_start_x * delta2_z) - (diff_start_z * delta2_x)) / determinant;
        float32 param_t = ((diff_start_x * delta1_z) - (diff_start_z * delta1_x)) / determinant;

        return (param_s >= (float32)0.0 && param_s <= (float32)1.0 && param_t >= (float32)0.0 && param_t <= (float32)1.0);
    }
}
