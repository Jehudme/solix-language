package doom;

import raylib.*;
import solix.math.Math;

public class WeaponManager {
    public int32 selected_weapon;
    public bool has_shotgun;
    public bool has_chaingun;
    public bool has_chainsaw;
    public bool has_rocket_launcher;

    public int32 ammo_bullets;
    public int32 max_bullets;
    public int32 ammo_shells;
    public int32 max_shells;
    public int32 ammo_rockets;
    public int32 max_rockets;

    public int32 fire_timer;
    public int32 muzzle_flash_timer;

    public WeaponManager() {
        this.selected_weapon = WeaponKind::PISTOL;
        this.has_shotgun = false;
        this.has_chaingun = false;
        this.has_chainsaw = false;
        this.has_rocket_launcher = false;

        this.ammo_bullets = 50;
        this.max_bullets = 200;
        this.ammo_shells = 0;
        this.max_shells = 50;
        this.ammo_rockets = 0;
        this.max_rockets = 50;

        this.fire_timer = 0;
        this.muzzle_flash_timer = 0;
    }

    public void select_weapon(int32 weapon_id) {
        if (weapon_id == WeaponKind::SHOTGUN && !this.has_shotgun) {
            return;
        }
        if (weapon_id == WeaponKind::CHAINGUN && !this.has_chaingun) {
            return;
        }
        if (weapon_id == WeaponKind::ROCKET_LAUNCHER && !this.has_rocket_launcher) {
            return;
        }
        this.selected_weapon = weapon_id;
    }

    public void update() {
        if (this.fire_timer > 0) {
            this.fire_timer = this.fire_timer - 1;
        }
        if (this.muzzle_flash_timer > 0) {
            this.muzzle_flash_timer = this.muzzle_flash_timer - 1;
        }
    }

    public bool can_fire() {
        if (this.fire_timer > 0) {
            return false;
        }
        if (this.selected_weapon == WeaponKind::PISTOL || this.selected_weapon == WeaponKind::CHAINGUN) {
            return this.ammo_bullets > 0;
        }
        if (this.selected_weapon == WeaponKind::SHOTGUN) {
            return this.ammo_shells > 0;
        }
        if (this.selected_weapon == WeaponKind::ROCKET_LAUNCHER) {
            return this.ammo_rockets > 0;
        }
        return true; // Fist
    }

    public void fire_weapon(
        DoomPlayer player,
        FpsCamera camera,
        LevelMap level_map,
        DoomAudio audio_manager
    ) {
        if (!this.can_fire()) {
            return;
        }

        if (this.selected_weapon == WeaponKind::FIST) {
            this.fire_timer = 18;
            this.muzzle_flash_timer = 8;
            audio_manager.play_sound(audio_manager.sound_punch);
            this.perform_hitscan(player, camera, level_map, audio_manager, (float32)20.0, (float32)2.5);
        } else if (this.selected_weapon == WeaponKind::PISTOL) {
            this.ammo_bullets = this.ammo_bullets - 1;
            this.fire_timer = 14;
            this.muzzle_flash_timer = 6;
            audio_manager.play_sound(audio_manager.sound_pistol);
            this.perform_hitscan(player, camera, level_map, audio_manager, (float32)15.0, (float32)100.0);
        } else if (this.selected_weapon == WeaponKind::SHOTGUN) {
            this.ammo_shells = this.ammo_shells - 1;
            this.fire_timer = 40;
            this.muzzle_flash_timer = 10;
            audio_manager.play_sound(audio_manager.sound_shotgun);
            // Shotgun fires 7 pellets
            for (int32 pellet_index = 0; pellet_index < 7; pellet_index = pellet_index + 1) {
                this.perform_hitscan(player, camera, level_map, audio_manager, (float32)12.0, (float32)100.0);
            }
        } else if (this.selected_weapon == WeaponKind::CHAINGUN) {
            this.ammo_bullets = this.ammo_bullets - 1;
            this.fire_timer = 6;
            this.muzzle_flash_timer = 4;
            audio_manager.play_sound(audio_manager.sound_pistol);
            this.perform_hitscan(player, camera, level_map, audio_manager, (float32)12.0, (float32)100.0);
        }
    }

    public void perform_hitscan(
        DoomPlayer player,
        FpsCamera camera,
        LevelMap level_map,
        DoomAudio audio_manager,
        float32 damage_amount,
        float32 max_range
    ) {
        float32 best_dist = max_range;
        int32 best_target_index = -1;

        float64 yaw_rad = (float64)camera.yaw_angle * (Math::PI / 180.0);
        float32 dir_x = (float32)Math::cos(yaw_rad);
        float32 dir_z = (float32)Math::sin(yaw_rad);

        for (int32 monster_idx = 0; monster_idx < level_map.enemy_count; monster_idx = monster_idx + 1) {
            EnemyMonster monster = level_map.enemies[monster_idx];
            if (monster != null && monster.is_alive) {
                float32 diff_x = monster.pos_x - player.pos_x;
                float32 diff_z = monster.pos_z - player.pos_z;
                float32 dist = DoomMath::distance_2d(player.pos_x, player.pos_z, monster.pos_x, monster.pos_z);

                if (dist < best_dist && dist > (float32)0.1) {
                    float32 norm_diff_x = diff_x / dist;
                    float32 norm_diff_z = diff_z / dist;

                    float32 dot_val = (dir_x * norm_diff_x) + (dir_z * norm_diff_z);
                    if (dot_val > (float32)0.82) { // Within aim cone
                        if (level_map.check_line_of_sight(player.pos_x, player.pos_z, monster.pos_x, monster.pos_z)) {
                            best_dist = dist;
                            best_target_index = monster_idx;
                        }
                    }
                }
            }
        }

        if (best_target_index >= 0) {
            level_map.enemies[best_target_index].take_damage(damage_amount, audio_manager);
        }
    }

    public void draw_first_person_weapon(
        int32 screen_width,
        int32 screen_height,
        float32 bob_offset,
        DoomResources resources
    ) {
        if (resources == null || !resources.is_loaded) {
            return;
        }

        Texture2D current_texture = resources.tex_pistol_idle;
        float32 weapon_scale = (float32)3.2;

        if (this.selected_weapon == WeaponKind::FIST) {
            current_texture = (this.muzzle_flash_timer > 0) ? resources.tex_fist_punch : resources.tex_fist_idle;
        } else if (this.selected_weapon == WeaponKind::PISTOL) {
            current_texture = (this.muzzle_flash_timer > 0) ? resources.tex_pistol_fire : resources.tex_pistol_idle;
        } else if (this.selected_weapon == WeaponKind::SHOTGUN) {
            if (this.muzzle_flash_timer > 0) {
                current_texture = resources.tex_shotgun_fire;
            } else if (this.fire_timer > 10) {
                current_texture = resources.tex_shotgun_cock;
            } else {
                current_texture = resources.tex_shotgun_idle;
            }
        } else if (this.selected_weapon == WeaponKind::CHAINGUN) {
            current_texture = (this.muzzle_flash_timer > 0) ? resources.tex_chaingun_fire : resources.tex_chaingun_idle;
        } else if (this.selected_weapon == WeaponKind::ROCKET_LAUNCHER) {
            current_texture = (this.muzzle_flash_timer > 0) ? resources.tex_rocket_fire : resources.tex_rocket_idle;
        }

        float32 dest_width = (float32)current_texture.width * weapon_scale;
        float32 dest_height = (float32)current_texture.height * weapon_scale;

        float32 screen_center_x = (float32)screen_width * (float32)0.5;
        float32 dest_x = screen_center_x - (dest_width * (float32)0.5);
        float32 dest_y = (float32)screen_height - dest_height - (float32)90.0 + (bob_offset * (float32)120.0);

        Rectangle source_rect = new Rectangle((float32)0.0, (float32)0.0, (float32)current_texture.width, (float32)current_texture.height);
        Rectangle dest_rect = new Rectangle(dest_x, dest_y, dest_width, dest_height);
        Vector2 origin_vector = new Vector2((float32)0.0, (float32)0.0);

        Raylib::DrawTexturePro(current_texture, source_rect, dest_rect, origin_vector, (float32)0.0, Color::WHITE);
    }
}
