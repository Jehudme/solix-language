{
    "name": "solix",
    "displayName": "Solix",
    "description": "Official language support for Solix v2.0 (Language Server, 108-token grammar, formatting, and task runner)",
    "version": "1.2.0",
    "publisher": "solix",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/jehudme/solix-language"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Formatters",
        "Linters"
    ],
    "keywords": [
        "solix",
        "language server",
        "lsp",
        "formatter",
        "register vm"
    ],
    "activationEvents": [
        "onLanguage:solix",
        "onCommand:solix.runMain",
        "onCommand:solix.debugMain",
        "onCommand:solix.runTest",
        "onCommand:solix.debugTest",
        "onCommand:solix.buildProject",
        "onCommand:solix.syncPackages",
        "onCommand:solix.showDisassembly",
        "onCommand:solix.showSynthesizedApi",
        "onCommand:solix.selectProfile",
        "onCommand:solix.restartServer",
        "onDebug"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "solix",
                "aliases": [
                    "Solix",
                    "solix"
                ],
                "extensions": [
                    ".slx"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "solix-disasm",
                "aliases": [
                    "Solix Disassembly",
                    "solix-disasm"
                ],
                "extensions": [
                    ".slxdasm"
                ]
            }
        ],
        "grammars": [
            {
                "language": "solix",
                "scopeName": "source.solix",
                "path": "./syntaxes/solix.tmLanguage.json"
            },
            {
                "language": "solix-disasm",
                "scopeName": "source.solix-disasm",
                "path": "./syntaxes/solix-disasm.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "solix",
                "path": "./snippets/solix.code-snippets"
            }
        ],
        "commands": [
            {
                "command": "solix.runMain",
                "title": "Run Application (solix run)",
                "category": "Solix",
                "icon": "$(play)"
            },
            {
                "command": "solix.debugMain",
                "title": "Debug Application (solix dap)",
                "category": "Solix",
                "icon": "$(debug-alt)"
            },
            {
                "command": "solix.runTest",
                "title": "Run Test Suite (solix run --test)",
                "category": "Solix",
                "icon": "$(beaker)"
            },
            {
                "command": "solix.debugTest",
                "title": "Debug Test Suite (solix dap --test)",
                "category": "Solix",
                "icon": "$(debug-alt)"
            },
            {
                "command": "solix.buildProject",
                "title": "Build Project (solix build)",
                "category": "Solix",
                "icon": "$(gear)"
            },
            {
                "command": "solix.syncPackages",
                "title": "Reinstall Packages (solix reinstall --all)",
                "category": "Solix"
            },
            {
                "command": "solix.showDisassembly",
                "title": "Inspect 64-Bit Register VM Disassembly",
                "category": "Solix",
                "icon": "$(file-code)"
            },
            {
                "command": "solix.showSynthesizedApi",
                "title": "Inspect Exported Public API (.slx)",
                "category": "Solix"
            },
            {
                "command": "solix.selectProfile",
                "title": "Select Active Build Profile",
                "category": "Solix"
            },
            {
                "command": "solix.restartServer",
                "title": "Restart Language Server",
                "category": "Solix"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "solix.buildProject",
                    "when": "resourceExtname == .slx",
                    "group": "navigation@1"
                },
                {
                    "command": "solix.runMain",
                    "when": "resourceExtname == .slx",
                    "group": "navigation@2"
                },
                {
                    "command": "solix.debugMain",
                    "when": "resourceExtname == .slx",
                    "group": "navigation@3"
                },
                {
                    "command": "solix.runTest",
                    "when": "resourceExtname == .slx",
                    "group": "navigation@4"
                },
                {
                    "command": "solix.showDisassembly",
                    "when": "resourceExtname == .slx",
                    "group": "navigation@5"
                }
            ]
        },
        "breakpoints": [
            {
                "language": "solix"
            }
        ],
        "debuggers": [
            {
                "type": "solix",
                "label": "Solix Debugger",
                "languages": [
                    "solix"
                ],
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to .slx, .slxb, or .slxarc file to debug.",
                                "default": "${workspaceFolder}"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Automatically stop after launching at the entry point.",
                                "default": false
                            },
                            "args": {
                                "type": "array",
                                "description": "Command line arguments passed to the program.",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            },
                            "cwd": {
                                "type": "string",
                                "description": "Working directory of the target program.",
                                "default": "${workspaceFolder}"
                            },
                            "testMode": {
                                "type": "boolean",
                                "description": "Debug the test suite runner instead of main.",
                                "default": false
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "solix",
                        "request": "launch",
                        "name": "Debug Solix Program",
                        "program": "${workspaceFolder}",
                        "stopOnEntry": false
                    }
                ]
            }
        ],
        "taskDefinitions": [
            {
                "type": "solix",
                "required": [
                    "command"
                ],
                "properties": {
                    "command": {
                        "type": "string",
                        "description": "The Solix subcommand to execute (e.g. build, run)"
                    },
                    "profile": {
                        "type": "string",
                        "description": "Build profile to target (debug, release, test)"
                    }
                }
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Solix Configuration",
            "properties": {
                "solix.lsp.path": {
                    "type": "string",
                    "default": "",
                    "description": "Custom absolute path or executable name for solix or solix-lsp. If blank, automatically discovered from workspace target directories, ~/.local/bin, ~/.cargo/bin, or PATH."
                },
                "solix.lsp.arguments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "lsp",
                        "--stdio"
                    ],
                    "description": "Arguments passed when launching the Solix language server binary."
                },
                "solix.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces JSON-RPC communication between VS Code and the Solix Language Server."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package-ext",
        "package-ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
        "compile": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
        "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
        "test:grammar": "vscode-tmgrammar-test -g syntaxes/solix.tmLanguage.json 'test/grammar/*.slx'",
        "test:client-rpc": "node test/client_rpc.test.mjs",
        "test:dap-rpc": "node test/dap_rpc.test.mjs",
        "test": "npm run test:grammar && npm run test:client-rpc && npm run test:dap-rpc",
        "package": "vsce package --no-dependencies"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.85.0",
        "@vscode/test-electron": "^2.4.1",
        "@vscode/vsce": "^3.2.1",
        "esbuild": "^0.28.2",
        "typescript": "^5.3.3",
        "vscode-tmgrammar-test": "^0.1.2"
    }
}
