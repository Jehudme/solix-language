{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Solix",
    "scopeName": "source.solix",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#destructors"
        },
        {
            "include": "#scope-resolution"
        },
        {
            "include": "#keywords-declaration"
        },
        {
            "include": "#modifiers"
        },
        {
            "include": "#keywords-control"
        },
        {
            "include": "#keywords-operator"
        },
        {
            "include": "#constants-language"
        },
        {
            "include": "#types-primitive"
        },
        {
            "include": "#types-custom"
        },
        {
            "include": "#function-call"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.triple-slash.documentation.solix",
                    "match": "///.*$"
                },
                {
                    "name": "comment.line.double-slash.solix",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.documentation.solix",
                    "begin": "/\\*\\*",
                    "end": "\\*/"
                },
                {
                    "name": "comment.block.solix",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.solix",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.solix",
                            "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.solix",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.solix",
                            "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.solix",
                    "match": "\\b0[xX][0-9a-fA-F_]+[Ll]?\\b"
                },
                {
                    "name": "constant.numeric.binary.solix",
                    "match": "\\b0[bB][01_]+[Ll]?\\b"
                },
                {
                    "name": "constant.numeric.float.solix",
                    "match": "\\b[0-9][0-9_]*\\.[0-9_]*([eE][+-]?[0-9_]+)?[fFdD]?\\b"
                },
                {
                    "name": "constant.numeric.integer.solix",
                    "match": "\\b[0-9][0-9_]*[Ll]?\\b"
                }
            ]
        },
        "destructors": {
            "match": "~([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "0": {
                    "name": "entity.name.function.destructor.solix"
                }
            }
        },
        "scope-resolution": {
            "patterns": [
                {
                    "match": "([A-Z][A-Za-z0-9_]*)\\s*(::)\\s*([a-zA-Z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.class.solix"
                        },
                        "2": {
                            "name": "punctuation.accessor.colon.solix"
                        },
                        "3": {
                            "name": "variable.other.member.solix"
                        }
                    }
                },
                {
                    "match": "::",
                    "name": "punctuation.accessor.colon.solix"
                }
            ]
        },
        "keywords-declaration": {
            "patterns": [
                {
                    "name": "keyword.declaration.solix",
                    "match": "\\b(package|import|alias|class|interface|enum|operator)\\b"
                }
            ]
        },
        "modifiers": {
            "patterns": [
                {
                    "name": "storage.modifier.solix",
                    "match": "\\b(public|private|protected|internal|static|inline|native|const|virtual|override|weak|abstract|extern)\\b"
                }
            ]
        },
        "keywords-control": {
            "patterns": [
                {
                    "name": "keyword.control.solix",
                    "match": "\\b(if|else|while|do|for|switch|case|default|break|continue|return|try|catch|finally|throw|assert|exit)\\b"
                }
            ]
        },
        "keywords-operator": {
            "patterns": [
                {
                    "name": "keyword.operator.word.solix",
                    "match": "\\b(new|super|this|instanceof|sizeof|cast|extends|implements)\\b"
                }
            ]
        },
        "constants-language": {
            "patterns": [
                {
                    "name": "constant.language.solix",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "types-primitive": {
            "patterns": [
                {
                    "name": "storage.type.primitive.solix",
                    "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|bool|char|string|tuple|void|sbyte|short|int|long|byte|ushort|uint|ulong|float|double|boolean)\\b"
                }
            ]
        },
        "types-custom": {
            "patterns": [
                {
                    "name": "entity.name.type.class.solix",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "function-call": {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": {
                    "name": "entity.name.function.solix"
                }
            }
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.solix",
                    "match": "\\+|\\-|\\*|\\/|\\%"
                },
                {
                    "name": "keyword.operator.assignment.solix",
                    "match": "(\\+\\=|\\-\\=|\\*\\=|\\/\\=|\\%\\=|\\&\\=|\\|\\=|\\^\\=|\\<\\<\\=|\\>\\>\\=|\\=)"
                },
                {
                    "name": "keyword.operator.comparison.solix",
                    "match": "(\\=\\=|\\!\\=|\\<\\=|\\>\\=|\\<|\\>)"
                },
                {
                    "name": "keyword.operator.logical.solix",
                    "match": "(\\&\\&|\\|\\||\\!)"
                },
                {
                    "name": "keyword.operator.bitwise.solix",
                    "match": "(\\&|\\||\\^|\\~|\\<\\<|\\>\\>)"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.accessor.dot.solix",
                    "match": "\\."
                },
                {
                    "name": "punctuation.terminator.semicolon.solix",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.comma.solix",
                    "match": ","
                },
                {
                    "name": "punctuation.bracket.curly.solix",
                    "match": "\\{|\\}"
                },
                {
                    "name": "punctuation.bracket.square.solix",
                    "match": "\\[|\\]"
                },
                {
                    "name": "punctuation.bracket.round.solix",
                    "match": "\\(|\\)"
                }
            ]
        }
    }
}
