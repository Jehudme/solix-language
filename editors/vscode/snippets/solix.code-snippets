{
    "Solix Main Entry Point": {
        "prefix": "main",
        "body": [
            "public static int32 main() {",
            "    $0",
            "    return 0;",
            "}"
        ],
        "description": "Solix v3 application entry point method"
    },
    "Solix Unit Test Function": {
        "prefix": "test",
        "body": [
            "public static void test_${1:feature_name}() {",
            "    $0",
            "}"
        ],
        "description": "Solix test suite case recognized by ▶ Run Test CodeLens"
    },
    "Class Declaration": {
        "prefix": "class",
        "body": [
            "public class ${1:ClassName} {",
            "    public ${1:ClassName}() {",
            "        $2",
            "    }",
            "",
            "    $0",
            "}"
        ],
        "description": "Solix reference class declaration"
    },
    "Destructor Declaration": {
        "prefix": "dtor",
        "body": [
            "public ~${1:ClassName}() {",
            "    $0",
            "}"
        ],
        "description": "Deterministic RAII scope-exit destructor"
    },
    "Interface Declaration": {
        "prefix": "interface",
        "body": [
            "public interface ${1:InterfaceName} {",
            "    $0",
            "}"
        ],
        "description": "Solix interface declaration"
    },
    "Enum Declaration": {
        "prefix": "enum",
        "body": [
            "public enum ${1:EnumName} {",
            "    ${2:VARIANT_FIRST},",
            "    ${3:VARIANT_SECOND}",
            "}"
        ],
        "description": "Solix enumeration declaration"
    },
    "Operator Overload": {
        "prefix": "operator",
        "body": [
            "public ${1:ReturnType} operator${2:+}(${3:const OtherType other_value}) {",
            "    $0",
            "}"
        ],
        "description": "Solix class operator overload"
    },
    "Method Declaration": {
        "prefix": "method",
        "body": [
            "public ${1:void} ${2:method_name}(${3:parameters}) {",
            "    $0",
            "}"
        ],
        "description": "Solix class method declaration"
    },
    "Static Method Declaration": {
        "prefix": "static",
        "body": [
            "public static ${1:void} ${2:function_name}(${3:parameters}) {",
            "    $0",
            "}"
        ],
        "description": "Solix static method accessed via ::"
    },
    "For Loop": {
        "prefix": "for",
        "body": [
            "for (int32 iteration_index = 0; iteration_index < ${1:maximum_count}; iteration_index++) {",
            "    $0",
            "}"
        ],
        "description": "Standard indexed for loop"
    },
    "While Loop": {
        "prefix": "while",
        "body": [
            "while (${1:condition_expression}) {",
            "    $0",
            "}"
        ],
        "description": "While loop block"
    },
    "Switch Statement": {
        "prefix": "switch",
        "body": [
            "switch (${1:target_value}) {",
            "    case ${2:CASE_VALUE}: {",
            "        $3",
            "        break;",
            "    }",
            "    default: {",
            "        $0",
            "        break;",
            "    }",
            "}"
        ],
        "description": "Switch statement with case and default arms"
    },
    "If-Else Statement": {
        "prefix": "if",
        "body": [
            "if (${1:condition_expression}) {",
            "    $2",
            "} else {",
            "    $0",
            "}"
        ],
        "description": "Conditional branching statement"
    },
    "Try-Catch-Finally Statement": {
        "prefix": "try",
        "body": [
            "try {",
            "    $1",
            "} catch (${2:Exception} caught_error) {",
            "    $3",
            "} finally {",
            "    $0",
            "}"
        ],
        "description": "Exception handling try-catch-finally block"
    },
    "Package Declaration": {
        "prefix": "package",
        "body": [
            "package ${1:namespace_path};"
        ],
        "description": "Module package namespace declaration"
    },
    "Import Declaration": {
        "prefix": "import",
        "body": [
            "import ${1:package_path}.${2:SymbolName};"
        ],
        "description": "Module symbol or wildcard import declaration"
    },
    "Type Alias": {
        "prefix": "alias",
        "body": [
            "public alias ${1:AliasName} = ${2:TargetType};"
        ],
        "description": "Type alias declaration"
    },
    "Weak Reference": {
        "prefix": "weak",
        "body": [
            "weak ${1:TargetClass} ${2:weak_ref} = ${3:source_ref};"
        ],
        "description": "Non-owning weak reference binding"
    },
    "Console Println": {
        "prefix": "println",
        "body": [
            "Console::println(${1:output_message});"
        ],
        "description": "Standard Console::println output statement"
    }
}
